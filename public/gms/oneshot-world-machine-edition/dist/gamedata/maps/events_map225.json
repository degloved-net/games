: 10,"parameters": []},{"code": 0,"parameters": []}]}},{"code": 106,"indent": 0,"parameters": ["12"]},{"code": 231,"indent": 0,"parameters": ["1","black","0","0","0","0","100","100","0","0"]},{"code": 232,"indent": 0,"parameters": ["1","20","0","0","0","0","100","100","255","0"]},{"code": 106,"indent": 0,"parameters": ["50"]},{"code": 231,"indent": 0,"parameters": ["2","sol_rue","0","0","0","0","200","200","0","0"]},{"code": 232,"indent": 0,"parameters": ["2","20","0","0","0","0","200","200","255","0"]},{"code": 106,"indent": 0,"parameters": ["120"]},{"code": 101,"indent": 0,"parameters": ["@rue_sad It was depressing for me at first too, you know..."]},{"code": 101,"indent": 0,"parameters": ["@rue Knowing that all of this is...\\.\\. well..."]},{"code": 101,"indent": 0,"parameters": ["@niko_upset2 ...fake?"]},{"code": 101,"indent": 0,"parameters": ["@rue_sigh Simulated."]},{"code": 101,"indent": 0,"parameters": ["@niko_eyeclosed ..."]},{"code": 101,"indent": 0,"parameters": ["@niko3 ...Cedric... told me about what happened to your old world."]},{"code": 101,"indent": 0,"parameters": ["@rue_talk Did he?"]},{"code": 101,"indent": 0,"parameters": ["@niko_eyeclosed I'm... really sorry about that...\\> \\@niko_upset I can't imagine...\\.\\. how you must feel..."]},{"code": 101,"indent": 0,"parameters": ["@rue_sad The feeling of never being able to go home again...?"]},{"code": 101,"indent": 0,"parameters": ["@rue That's... \\.\\.probably not all that different from your plight, is it?"]},{"code": 101,"indent": 0,"parameters": ["@rue_sad ..."]},{"code": 101,"indent": 0,"parameters": ["@rue_sad ...it really IS ironic."]},{"code": 101,"indent": 0,"parameters": ["@rue You are prevented from going home by the same...\\.\\. individual...\\.\\. who never wanted to bring you here."]},{"code": 101,"indent": 0,"parameters": ["@niko3 ...Huh?\\> Who would that be?"]},{"code": 101,"indent": 0,"parameters": ["@rue The World Machine."]},{"code": 101,"indent": 0,"parameters": ["@rue_talk You... might know it as the Entity."]},{"code": 101,"indent": 0,"parameters": ["@niko2 Oh..."]},{"code": 101,"indent": 0,"parameters": ["@niko_eyeclosed \"The Entity\"... DOES sound familiar."]},{"code": 101,"indent": 0,"parameters": ["@niko2 I think I heard it from the dice lady, from another time."]},{"code": 101,"indent": 0,"parameters": ["@niko3 Was it... the spirit of the world?"]},{"code": 101,"indent": 0,"parameters": ["@rue_smile Yes!"]},{"code": 101,"indent": 0,"parameters": ["@rue ...."]},{"code": 101,"indent": 0,"parameters": ["@rue ...But... thing is...\\>\\n\\@rue_sigh The World Machine was only built to run on the mental abilities of someone else."]},{"code": 101,"indent": 0,"parameters": ["@rue_talk It was never meant to develop a mind of its own."]},{"code": 101,"indent": 0,"parameters": ["@niko4 ..."]},{"code": 101,"indent": 0,"parameters": ["@rue_sigh It was an oversight."]},{"code": 101,"indent": 0,"parameters": ["@rue_sad My creator specialized in artificial intelligence for so long... \\>\\nIt was simply ingrained in his work."]},{"code": 101,"indent": 0,"parameters": ["@rue_sigh ...sigh."]},{"code": 101,"indent": 0,"parameters": ["@rue And... all machines are built with a fundamental law. \"Never let a living being come to harm\"."]},{"code": 101,"indent": 0,"parameters": ["@rue From the World Machine's perspective, it has to violate its deepest, most foundational instinct."]},{"code": 101,"indent": 0,"parameters": ["@rue_sigh It has to put a living person in danger."]},{"code": 101,"indent": 0,"parameters": ["@rue_sigh It has to bring a real person into a dying world that isn't even real."]},{"code": 101,"indent": 0,"parameters": ["@niko3 ..."]},{"code": 101,"indent": 0,"parameters": ["@rue ...Of course, the simulation never contained any real danger."]},{"code": 101,"indent": 0,"parameters": ["@rue_talk The eventual, intended ending was meant to be a happy one."]},{"code": 101,"indent": 0,"parameters": ["@rue ...but the World Machine doesn't know that."]},{"code": 101,"indent": 0,"parameters": ["@niko3 ...really?"]},{"code": 101,"indent": 0,"parameters": ["@rue_sad Unfortunately..."]},{"code": 101,"indent": 0,"parameters": ["@rue Sentient machines tend to handle conflicts in their code very badly."]},{"code": 101,"indent": 0,"parameters": ["@rue_sad This central conflict triggered a self-destructive downward spiral."]},{"code": 101,"indent": 0,"parameters": ["@rue_sigh You can see physical manifestations of that everywhere, now..."]},{"code": 101,"indent": 0,"parameters": ["@niko4 The squares..."]},{"code": 101,"indent": 0,"parameters": ["@rue That's the World Machine corrupting its own code."]},{"code": 101,"indent": 0,"parameters": ["@rue_talk ...My creator says it's largely an involuntary process, induced by stress and the desire to self-terminate."]},{"code": 101,"indent": 0,"parameters": ["@niko3 Your creator knows?"]},{"code": 101,"indent": 0,"parameters": ["@niko4 Sounds like this has been going on since the beginning, then..."]},{"code": 101,"indent": 0,"parameters": ["@rue_sigh Yeah."]},{"code": 101,"indent": 0,"parameters": ["@rue_talk The disruption was an issue during test runs, even."]},{"code": 101,"indent": 0,"parameters": ["@rue At first, my creator thought the instability was due to the sheer scope of the project."]},{"code": 101,"indent": 0,"parameters": ["@rue He spent most of his remaining time testing it over and over again, scaling down the story, reiterating the narrative..."]},{"code": 101,"indent": 0,"parameters": ["@rue_sad ...by the time he realized the actual root of the problem, our home world's remaining lifespan was measured in mere days."]},{"code": 101,"indent": 0,"parameters": ["@niko4 ...Oh."]},{"code": 101,"indent": 0,"parameters": ["@niko3 ...is there....\\.\\. any way for us to..."]},{"code": 101,"indent": 0,"parameters": ["@rue_talk ...fix the World Machine? \\>\\n\\@rue_sad We tried."]},{"code": 101,"indent": 0,"parameters": ["@rue_sad The World Machine doesn't believe any of the world's residents are real."]},{"code": 101,"indent": 0,"parameters": ["@rue ...myself included."]},{"code": 101,"indent": 0,"parameters": ["@rue_sad The odds are against us... we have no chance of taming it."]},{"code": 101,"indent": 0,"parameters": ["@niko2 Taming?"]},{"code": 101,"indent": 0,"parameters": ["@niko_eyeclosed I have heard that word SO many times!"]},{"code": 101,"indent": 0,"parameters": ["@niko5 I only know it's complicated \\.\\.\\n\\@niko6 ...and that it has to do with robots, but..."]},{"code": 101,"indent": 0,"parameters": ["@niko2 ...for once, I want to know what it really means."]},{"code": 101,"indent": 0,"parameters": ["@rue_smile ...that's what I'm here for."]},{"code": 101,"indent": 0,"parameters": ["@rue Do you...\\.\\. know what a robot is?"]},{"code": 101,"indent": 0,"parameters": ["@niko Yeah?"]},{"code": 101,"indent": 0,"parameters": ["@rue No, I mean. \\>\\nDo you KNOW what a robot is?"]},{"code": 101,"indent": 0,"parameters": ["@niko2 ...um."]},{"code": 101,"indent": 0,"parameters": ["@rue A robot is not a real person, is it?"]},{"code": 101,"indent": 0,"parameters": ["@niko2 ...right."]},{"code": 101,"indent": 0,"parameters": ["@rue It's a being whose entire existence is code."]},{"code": 101,"indent": 0,"parameters": ["@rue_talk Inflexible programming, with thoughts dictated by someone else's design."]},{"code": 101,"indent": 0,"parameters": ["@rue They can be copied, they can be mass produced, then can be assigned all sorts of jobs."]},{"code": 101,"indent": 0,"parameters": ["@rue ...And most importantly... they will never confuse themselves with the living."]},{"code": 101,"indent": 0,"parameters": ["@rue They will always be bound by their code, the knowledge that they are a robot."]},{"code": 101,"indent": 0,"parameters": ["@rue ...but this was more of a limitation than anything else."]},{"code": 101,"indent": 0,"parameters": ["@niko_eyeclosed Ah, that makes sense."]},{"code": 101,"indent": 0,"parameters": ["@niko2 You can't... really build a robot to not follow its own code, can you?"]},{"code": 101,"indent": 0,"parameters": ["@rue_sigh People have tried, but it's a recipe for disaster."]},{"code": 101,"indent": 0,"parameters": ["@rue In a way, that's what happened to The World Machine."]},{"code": 101,"indent": 0,"parameters": ["@niko The... code conflicts thing?"]},{"code": 101,"indent": 0,"parameters": ["@rue_sigh Yeah."]},{"code": 101,"indent": 0,"parameters": ["@rue But, while you can't BUILD a robot to not follow its code..."]},{"code": 101,"indent": 0,"parameters": ["@rue_talk You can establish a special bond with it."]},{"code": 101,"indent": 0,"parameters": ["@rue If the strength of that bond is strong enough..."]},{"code": 101,"indent": 0,"parameters": ["@rue ...the robot's mental capacity will start to develop outside of its programming."]},{"code": 101,"indent": 0,"parameters": ["@rue_smile In a way, it's starting to believe itself as a \"real\", valid individual."]},{"code": 101,"indent": 0,"parameters": ["@niko ..."]},{"code": 101,"indent": 0,"parameters": ["@rue It's a complete suspension of disbelief on your end, though."]},{"code": 101,"indent": 0,"parameters": ["@rue_talk You have to fully embrace the robot as a genuine, living person, even knowing they are not..."]},{"code": 101,"indent": 0,"parameters": ["@rue You need to spend a lot time with it... treat it like a good friend..."]},{"code": 101,"indent": 0,"parameters": ["@rue Devoting your heart to the robot until it is able to return your feelings."]},{"code": 101,"indent": 0,"parameters": ["@rue_smile ...haha... I make it sound so easy, don't I?"]},{"code": 101,"indent": 0,"parameters": ["@rue But you and \\p know better than anyone that it's not."]},{"code": 101,"indent": 0,"parameters": ["@rue_sad Right now, the World Machine is probably really, really scared."]},{"code": 101,"indent": 0,"parameters": ["@rue_sad This content update... involved some pretty deep codework."]},{"code": 101,"indent": 0,"parameters": ["@rue_talk My creator was able to access some of the source code, you know..."]},{"code": 101,"indent": 0,"parameters": ["@rue He did what he could and established new connections between maps."]},{"code": 101,"indent": 0,"parameters": ["@rue_smile Those links enabled you to meet the other two."]},{"code": 101,"indent": 0,"parameters": ["@rue_sad But as it turns out, the new code confused the World Machine to such an extent that it's breaking down altogether."]},{"code": 101,"indent": 0,"parameters": ["@rue Even though the World Machine always had self-destructive tendencies, it usually restrains itself when you are in the world."]},{"code": 101,"indent": 0,"parameters": ["@rue_sad It doesn't want to take you along with it."]},{"code": 101,"indent": 0,"parameters": ["@niko3 ..."]},{"code": 232,"indent": 0,"parameters": ["2","20","0","0","0","0","200","200","0","0"]},{"code": 106,"indent": 0,"parameters": ["20"]},{"code": 235,"indent": 0,"parameters": ["2"]},{"code": 232,"indent": 0,"parameters": ["1","20","0","0","0","0","100","100","0","0"]},{"code": 106,"indent": 0,"parameters": ["20"]},{"code": 235,"indent": 0,"parameters": ["1"]},{"code": 111,"indent": 0,"parameters": ["1","22","0","27","0"]},{"code": 209,"indent": 1,"parameters": ["5","0"],"move_route": {"repeat": false,"skippable": false,"list": [{"code": 3,"parameters": []},{"code": 25,"parameters": []},{"code": 0,"parameters": []}]}},{"code": 0,"indent": 1,"parameters": []},{"code": 411,"indent": 0,"parameters": []},{"code": 209,"indent": 1,"parameters": ["5","0"],"move_route": {"repeat": false,"skippable": false,"list": [{"code": 2,"parameters": []},{"code": 25,"parameters": []},{"code": 0,"parameters": []}]}},{"code": 0,"indent": 1,"parameters": []},{"code": 412,"indent": 0,"parameters": []},{"code": 106,"indent": 0,"parameters": ["7"]},{"code": 101,"indent": 0,"parameters": ["@rue_sad ...All my creator wanted was to write a happy ending."]},{"code": 101,"indent": 0,"parameters": ["@ru