eters": ["@kip_sigh ...\\|I gave up on her back then... we all did."]},{"code": 101,"indent": 2,"parameters": ["@kip_pout I'm sure she realized that...\\n\\>\\@kip_sigh and now she won't ever come back."]},{"code": 101,"indent": 2,"parameters": ["@kip_sad She won't even answer my letters..."]},{"code": 101,"indent": 2,"parameters": ["@niko_eyeclosed I'm sorry..."]},{"code": 101,"indent": 2,"parameters": ["@kip_pout Ah, sorry for rambling."]},{"code": 101,"indent": 2,"parameters": ["@kip You should hold on to that amber, okay?"]},{"code": 101,"indent": 2,"parameters": ["@niko_speak I will!"]},{"code": 121,"indent": 2,"parameters": ["199","199","0"]},{"code": 242,"indent": 2,"parameters": ["1"]},{"code": 106,"indent": 2,"parameters": ["30"]},{"code": 241,"indent": 2,"parameters": ["0"],"audio_file": {"name": "Factory","volume": 100,"pitch": 100}},{"code": 0,"indent": 2,"parameters": []},{"code": 412,"indent": 1,"parameters": []},{"code": 0,"indent": 1,"parameters": []},{"code": 411,"indent": 0,"parameters": []},{"code": 111,"indent": 1,"parameters": ["1","1","0","51","0"]},{"code": 101,"indent": 2,"parameters": ["@kip Oh! I see you put your own photo on there!\\>\\n\\@kip_wink Does that mean your name is Kip now?"]},{"code": 101,"indent": 2,"parameters": ["@kip ...that was a joke."]},{"code": 0,"indent": 2,"parameters": []},{"code": 411,"indent": 1,"parameters": []},{"code": 111,"indent": 2,"parameters": ["0","62","0"]},{"code": 111,"indent": 3,"parameters": ["0","64","0"]},{"code": 101,"indent": 4,"parameters": ["@kip Is there anything else you need?"]},{"code": 101,"indent": 4,"parameters": ["@niko Nope!"]},{"code": 101,"indent": 4,"parameters": ["@kip_wink Well, feel free to stick around if you want!"]},{"code": 0,"indent": 4,"parameters": []},{"code": 411,"indent": 3,"parameters": []},{"code": 101,"indent": 4,"parameters": ["@kip Oh hey, you're back!"]},{"code": 101,"indent": 4,"parameters": ["@kip Can I help you with anything else?"]},{"code": 101,"indent": 4,"pa