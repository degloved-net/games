msgstr "@niko_speak 可是沒關係，因為太陽隔天一定會再回來。\\>\\n\\@niko 你不覺得這樣很好嗎？"

msgid "[\"Yeah.\", \"My world is like that too.\"]"
msgstr "[\"是啊。\",\"我的世界也是這樣。\"]"

msgid "@niko M-hm!"
msgstr "@niko 嗯哼！"

