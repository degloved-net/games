msgstr "@niko 晚上大家通常都會去睡覺。\\>\\n\\@niko_speak 不過有些人會熬夜用電腦！"

msgid "@niko_speak Ah!\\>\\nDo you sleep during the night?"
msgstr "@niko_speak 啊！\\>\\n你晚上會睡覺嗎？"

