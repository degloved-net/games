msgid "@niko Strange black plants. They look like clovers."
msgstr "@niko 奇怪的黑色植物，看起來像苜蓿草。"

msgid "@niko A robot."
msgstr "@niko 一台機器人。"

msgid "@niko_eyeclosed No power, just like the rest..."
msgstr "@niko_eyeclosed 沒有電，跟其他的一樣……"

msgid "[I AM WATCHING OVER THE PLANTS.]"
msgstr "[我正在照顧植物。]"

msgid "[HELLO, SMALL PERSON.]"
msgstr "[你好啊，小小的人類。]"

msgid "@niko_eyeclosed You're not much bigger than I am..."
msgstr "@niko_eyeclosed 你也沒比我大多少……"

msgid "[WELCOME TO THE LOOKOUT POINT.]"
msgstr "[歡迎來到瞭望點。]"

msgid "[BELOW US IS THE OLD QUARRY.]"
msgstr "[下方是舊採石場。]"

msgid "[THE HEAD ENGINEER LIVES A LITTLE MORE TO THE EAST.]"
msgstr "[工程師主管住在稍微往東邊的地方。]"

msgid "[THE ENTRANCE TO THE OLD MINES IS FURTHER TO THE EAST.]"
msgstr "[舊礦坑入口在更往東邊的遠處。]"

msgid "@niko I see!"
msgstr "@niko 知道了！"

