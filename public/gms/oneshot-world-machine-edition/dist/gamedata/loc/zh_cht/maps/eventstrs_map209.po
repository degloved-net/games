msgid "@niko_speak It's a fish stew!"
msgstr "@niko_speak 是燉魚！"

msgid "@niko A fishing pole."
msgstr "@niko 一根釣竿。"

msgid "@alula_gasp My brother knows how to fish too!"
msgstr "@alula_gasp 我哥也會釣魚！"

msgid "@alula But I don't!"
msgstr "@alula 可是我不會！"

msgid "@niko Same!"
msgstr "@niko 我也一樣！"

msgid "@niko An empty jar."
msgstr "@niko 空罐子。"

msgid "@niko A jar of worms."
msgstr "@niko 一罐蟲。"

msgid "@niko_eyeclosed Gross!"
msgstr "@niko_eyeclosed 噁！"

msgid "Oh, hello, messiah."
msgstr "喔，救世主，你好啊。"

msgid "Would you like some stew?"
msgstr "要不要吃點燉菜呢？"

msgid "I made enough to feed a whole village!"
msgstr "我煮了很多，夠一整個村子的人一起吃喔！"

msgid "...literally!"
msgstr "……真的！"

msgid "@niko_speak It's ok, thanks!"
msgstr "@niko_speak 不用了，謝謝你！"

msgid "Looks like the Glen is deteriorating faster than ever, now..."
msgstr "看起來現在綠沼澤惡化的速度比以往更快了……"

msgid "@niko These are filled with small, dried fish."
msgstr "@niko 這些則裝滿小魚乾。"

msgid "@niko6 At least... I think it's fish!"
msgstr "@niko6 至少……我覺得那是魚！"

msgid "@niko_eyeclosed They look kinda like snakes..."
msgstr "@niko_eyeclosed 牠們看起來有點像蛇……"

