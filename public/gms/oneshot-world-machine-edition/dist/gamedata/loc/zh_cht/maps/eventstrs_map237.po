msgstr "@kip_pout ……"

msgid "@niko3 I..."
msgstr "@niko3 我……"

msgid "@niko3 ...when I first came to this world... \\.\\.\\@niko4 a long time ago...."
msgstr "@niko3 ……剛來這個世界的時候……\\.\\.\\@niko4 那已經是好久以前……"

msgid "@niko_distressed2 ...back then, all I wanted was to go home."
msgstr "@niko_distressed2 ……當時我滿腦子只想要回家。"

msgid "@niko_eyeclosed ...\\p... do you remember?"
msgstr "@niko_eyeclosed ……\\p……你記得嗎？"

msgid "@niko2 The very FIRST time..."
msgstr "@niko2 最初的那一次……"

msgid "@niko5 I'm not sure how far back it was for you..."
msgstr "@niko5 我不確定對你來說是多久以前……"

