msgid "@niko3 ..."
msgstr "@niko3 ……"

msgid "@niko_distressed .....It's...\\> \\@niko_eyeclosed2 .....okay."
msgstr "@niko_distressed ……不……\\>\\@niko_eyeclosed2 ……不要緊啦。"

