msgid "@niko Hey, \\p?"
msgstr "@niko Ehi, \\p?"

msgid "@niko_speak Do you remember where the cafe is?"
msgstr "@niko_speak Ti ricordi dove si trova la caffetteria?"

msgid "[\"Yes\", \"No\"]"
msgstr "[\"Sì\",\"No\"]"

msgid "@niko Oh, good!"
msgstr "@niko Oh, bene!"

msgid "@niko_eyeclosed Oh..."
msgstr "@niko_eyeclosed Oh..."

msgid "@niko_speak Wait! I think I remember!\\>\\n\\@niko It's up the elevator, and then we take a right and go down some stairs!"
msgstr "@niko_speak Aspetta! Credo di ricordarmelo!\\>\\n\\@niko Dobbiamo prendere l'ascensore, poi giriamo verso destra e infine scendiamo le scale!"

msgid "@niko I'm asking because... well..."
msgstr "@niko Chiedo perché... ecco..."

msgid "@niko_eyeclosed I'm... a little hungry...."
msgstr "@niko_eyeclosed Ho... un po' di fame..."

msgid "@niko_speak Actually I'm REALLY hungry!\\>\\n\\@niko I haven't eaten anything since I got here..."
msgstr "@niko_speak In realtà ho MOLTA fame!\\>\\n\\@niko Non ho mangiato nulla da quando sono arrivato qui..."

msgid "@niko So...is it ok if we go get some food before we enter the Tower?"
msgstr "@niko Quindi... va bene se mettiamo qualcosa sotto i denti prima di entrare nella Torre?"

msgid "@niko_pancakes I hope they have pancakes..."
msgstr "@niko_pancakes Spero abbiano i pancake..."

