msgstr "@niko Alcune delle parole sono sottolineate."

msgid "@niko ....*most* of the words are underlined."
msgstr "@niko ...*quasi tutte* le parole sono sottolineate."

msgid "@niko There's some big plastic disks in here."
msgstr "@niko Qui dentro ci sono dei grandi dischi di plastica."

msgid "@niko_speak Looks like they're supposed to go in something?"
