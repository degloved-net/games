msgid "[I HAVE LOST COMMUNICATION WITH THE GUARDIAN OUTSIDE THE CITY GATE.]"
msgstr "[HO PERSO LE COMUNICAZIONI CON LA GUARDIA ESTERNA ALL'INGRESSO DELLA CITTÀ.]"

msgid "@niko2 The... big robot, right?"
msgstr "@niko2 Intendi... il grande robot, giusto?"

msgid "[PLEASE HELP ME CHECK ON THEM.]"
msgstr "[PER FAVORE VAI A VERIFICARE LE SUE CONDIZIONI.]"

msgid "[I CANNOT LEAVE MY STATION.]"
msgstr "[NON POSSO LASCIARE LA MIA POSTAZIONE.]"

msgid "@niko Alright..."
msgstr "@niko D'accordo..."

msgid "[THE DEEPER RUINS ARE AHEAD.]"
msgstr "[PROSEGUENDO RAGGIUNGERAI LE PROFONDITÀ DELLE ROVINE.]"

msgid "[DO NOTE THAT THEY ARE PARTIALLY FLOODED.]"
msgstr "[DEVO INFORMARTI CHE SONO PARZIALMENTE ALLAGATE.]"

msgid "@niko3 There's squares all over the big robot..."
msgstr "@niko3 I quadrati hanno completamente ricoperto il grande robot..."

msgid "[AH.]"
msgstr "[AH.]"

msgid "[THAT IS OUTSIDE MY CAPACITY FOR HELP.]"
msgstr "[CIÒ VA OLTRE LE MIE CAPACITÀ DI AIUTO.]"

msgid "[YOU MAY PROCEED TO THE DEEPER RUINS.]"
msgstr "[PUOI PROCEDERE ALLE ROVINE PIÙ PROFONDE.]"

msgid "@niko4 Alright..."
msgstr "@niko4 Va bene..."

