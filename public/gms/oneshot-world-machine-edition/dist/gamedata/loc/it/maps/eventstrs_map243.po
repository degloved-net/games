msgstr "@calamus_sad I quadrati hanno iniziato a moltiplicarsi intorno all'isola dopo che ve ne siete andati..."

msgid "@alula_oh It was so freaky!"
msgstr "@alula_oh È stato spaventoso!"

msgid "@alula_oh I fell right into a bunch of em!"
msgstr "@alula_oh Ci sono caduta in mezzo!"

msgid "@alula_oh Calamus tried to save me, and then..."
msgstr "@alula_oh Calamus ha cercato di salvarmi, poi..."

msgid "@calamus We... both ended up in this room."
msgstr "@calamus Siamo finiti entrambi... in questa stanza."

msgid "@calamus_heh Biggest scare of my life, for sure..."
msgstr "@calamus_heh Non mi sono mai spaventato così tanto, questo è certo..."

