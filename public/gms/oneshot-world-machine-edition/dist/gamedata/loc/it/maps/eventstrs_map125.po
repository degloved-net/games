msgid "@niko A pile of large books."
msgstr "@niko Una pila di grossi libri."

msgid "@niko One of them is a robot instruction manual..."
msgstr "@niko Uno di questi è un manuale di istruzioni per robot..."

msgid "@niko A painting of 4 robots playing cards."
msgstr "@niko Un dipinto di 4 robot che giocano a carte."

msgid "@niko A picture of many 1's and 0's."
msgstr "@niko Un'immagine di molti 1 e 0."

msgid "[Hello. Would You Like To Play A Game?]"
msgstr "[Salve. Vorresti Fare Un Gioco?]"

msgid "@niko_speak Oh!"
msgstr "@niko_speak Oh!"

msgid "@niko Sure!"
msgstr "@niko Va bene!"

msgid "[What Game Would You Like To Play?]"
