msgid "@en_upset [I don't know.]"
msgstr "@en_upset [Non lo so.]"

msgid "@en_upset2 [I've never done this before, I...]"
msgstr "@en_upset2 [Non l'ho mai fatto prima, io...]"

msgid "@en_upset_meow [I'm scared...]"
msgstr "@en_upset_meow [Ho paura...]"

msgid "@niko3 You can do it, I know you can!"
msgstr "@niko3 Puoi farcela, so che puoi!"

msgid "@niko4 You've...\\.\\. helped me come this far."
msgstr "@niko4 Tu...\\.\\. mi ha aiutato ad arrivare fin qui."

msgid "@en_upset [...I'll...]\\>\\n\\@en_eyeclosed [I'll try.]"
msgstr "@en_upset [...Io...\\>\\n\\@en_eyeclosed Ci proverò.]"

msgid "@en3 [I can't promise anything, but...]"
msgstr "@en3 [Non posso promettere nulla, ma...]"

msgid "@en4 [Here.]"
msgstr "@en4 [Ecco.]"

msgid "@en_eyeclosed [Take the sun.]"
msgstr "@en_eyeclosed [Prendi il sole.]"

msgid "@en5 [I'll...\\.\\. try to remember the lost code...]"
msgstr "@en5 [Io...\\.\\. proverò a ricordare il codice perso...]"

msgid "@en4 [...and... recreate it.]"
msgstr "@en4 [...e... a ricrearlo.]"

msgid "@en_upset2 [But for that to happen...]"
msgstr "@en_upset2 [Ma perché ciò accada...]"

msgid "@en3 [Niko... you need to navigate through this room...]"
msgstr "@en3 [Niko... devi attraversare questa stanza...]"

msgid "@en_eyeclosed [You need to get past the squares somehow...]"
msgstr "@en_eyeclosed [Devi superare i quadrati in qualche modo...]"

msgid "@en_distressed [Oh...\\.\\. I don't like this...]"
msgstr "@en_distressed [Oh...\\.\\. No, no...!]"

msgid "@en_distressed2 [What if you get hurt?]"
msgstr "@en_distressed2 [E se ti fai male?]"

msgid "@niko2 It's fine... It's fine..."
msgstr "@niko2 Calma... Andrà tutto bene..."

msgid "@niko4 I'll...\\.\\. I'll try to be careful, ok?"
msgstr "@niko4 Io...\\.\\. cercherò di fare attenzione, ok?"

msgid "@niko2 I can do this."
msgstr "@niko2 Ce la posso fare."

