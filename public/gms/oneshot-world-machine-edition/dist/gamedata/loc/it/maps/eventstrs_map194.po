msgid "@proto_eyeclosed [It appears that we have some confusion here.]"
msgstr "@proto_eyeclosed [Sembra che qui si sia fatta un po' di confusione.]"

msgid "@proto2 [\\p did not build the world, Niko.]"
msgstr "@proto2 [\\p non ha costruito il mondo, Niko.]"

msgid "@niko3 Oh..."
msgstr "@niko3 Oh..."

msgid "@proto2 [\\p only owns a machine that is able to generate the world from preexisting code.]"
msgstr "@proto2 [\\p possiede solo una macchina che è in grado di generare il mondo da un codice preesistente.]"

msgid "@proto2b [They actually have fairly limited control of the events.]"
msgstr "@proto2b [In realtà ha un controllo abbastanza limitato sugli eventi.]"

msgid "@proto2 [The world was built by someone else altogether.]"
msgstr "@proto2 [Il mondo è stato costruito da qualcuno di completamente diverso.]"

msgid "@proto1c [Someone you cannot begin to fathom.]"
msgstr "@proto1c [Qualcuno che non puoi neanche immaginare.]"

msgid "@proto2b [It was also not designed to be the futile quest that it is now, but...]"
msgstr "@proto2b [In origine, il mondo non era stato concepito come la futile ricerca che è adesso, ma...]"

msgid "@proto_eyeclosed [...too many things went wrong.]"
msgstr "@proto_eyeclosed [...troppe cose sono andate storte.]"

msgid "@proto1c [There's... a type of signal disruption that he never expected.]"
msgstr "@proto1c [Esiste... un tipo di distorsione del segnale che lui non aveva previsto.]"

msgid "@proto1b [It's eating away at the world, slowly rendering it into an unrecognizable mess.]"
msgstr "@proto1b [Sta sgretolando il mondo, facendolo lentamente sprofondare in un caos irriconoscibile.]"

msgid "@proto2b [Even if you bring back the sun, it will not go away.]"
msgstr "@proto2b [Anche se riporterai il sole, il problema non andrà via.]"

msgid "@niko3 The square stuff, isn't it?"
msgstr "@niko3 Parli della roba quadrata, vero?"

msgid "@niko_eyeclosed I remember those from before..."
msgstr "@niko_eyeclosed Me la ricordo da prima..."

msgid "@proto1b [Then you know what to watch out for.]"
msgstr "@proto1b [Allora sai già a cosa fare attenzione.]"

msgid "@proto1c [...The creator knows what might be causing it, but there is nothing that he could do...]"
msgstr "@proto1c [...Il creatore sa cosa potrebbe causarla, ma non c'è mai stato niente che lui potesse fare...]"

msgid "@proto1 [...until now.]"
msgstr "@proto1 [...fino ad ora.]"

msgid "@proto1b [You managed to find me, after all.]"
msgstr "@proto1b [Sei riuscito a trovarmi, dopotutto.]"

msgid "@niko2 ...?"
msgstr "@niko2 ...?"

msgid "@proto2 [You being here was due to his help.]"
msgstr "@proto2 [Se sei qui è grazie al suo aiuto.]"

msgid "@niko2 Oh...\\> I guess it has something to do with the journal?"
msgstr "@niko2 Oh...\\> Immagino che abbia qualcosa a che fare con il diario?"

msgid "@proto1b [Correct.]"
msgstr "@proto1b [Corretto.]"

msgid "@proto1 [Looks like he wants to have one final attempt at fixing it.]"
msgstr "@proto1 [Sembra che voglia fare un ultimo tentativo per sistemare le cose.]"

msgid "@proto2 [...and he might need to do it through you.]"
msgstr "@proto2 [...E tu potresti fargli da tramite.]"

msgid "@proto1b [Niko, do you remember how to get to the Glen?]"
msgstr "@proto1b [Niko, ti ricordi come arrivare alla Valle?]"

msgid "@proto2 [Whatever you did in your last session, you should stick with it for now.]"
msgstr "@proto2 [Qualunque cosa tu abbia fatto nella tua ultima sessione, dovresti attenerti a quella per ora.]"

msgid "@niko4 I..."
msgstr "@niko4 Io..."

msgid "@niko_eyeclosed I remember a boat..."
msgstr "@niko_eyeclosed Ricordo una barca..."

msgid "@niko ...more specifically, fixing a robot that drives the boat."
msgstr "@niko ...o meglio, di aver sistemato un robot che la guidava."

msgid "@proto2 [Alright, then go do that.]"
msgstr "@proto2 [Va bene, allora fai quello.]"

msgid "@niko3 But..."
msgstr "@niko3 Ma..."

msgid "@niko_eyeclosed The boat robot has those squares over it..."
msgstr "@niko_eyeclosed Il robot della barca ha quei quadrati sopra..."

msgid "@proto_gasp2 ...oh."
msgstr "@proto_gasp2 ...Oh."

msgid "@proto2b [Then do whatever you must to find a new boat.]"
msgstr "@proto2b [Allora fai di tutto per trovare una nuova barca.]"

msgid "@proto2 [There are plenty of machine parts around the Barrens that can be repurposed.]"
msgstr "@proto2 [Ci sono molti componenti meccanici in giro per la Baia Desolata che possono essere riutilizzati.]"

msgid "@niko_upset ...\\>\\n\\@niko_upset2 .........."
msgstr "@niko_upset ...\\>\\n\\@niko_upset2 ........."

msgid "@niko_eyeclosed Sigh..."
msgstr "@niko_eyeclosed Oh..."

msgid "@proto2 [You seem enthusiastic.]"
msgstr "@proto2 [Sembri entusiasta.]"

msgid "@proto2b [...that was sarcasm.]"
msgstr "@proto2b [...Era sarcasmo.]"

msgid "@niko_upset Knowing everything isn't real..."
msgstr "@niko_upset Sapere che nulla è reale..."

msgid "@niko_upset2 ...really does make it feel pointless..."
msgstr "@niko_upset2 ...fa davvero sembrare tutto inutile..."

msgid "@proto1b [But you DO want to go home, right?]"
msgstr "@proto1b [Ma tu VUOI tornare a casa, giusto?]"

msgid "@niko3 Yeah, but..."
msgstr "@niko3 Sì, ma..."

msgid "@niko_distressed2 How will I know that this isn't just another..."
msgstr "@niko_distressed2 Come faccio a sapere che questo non è solo un altro..."

msgid "@proto2b [Because this session might be the last one.]"
msgstr "@proto2b [Perché questa sessione potrebbe essere l'ultima.]"

msgid "@niko3 ...?"
msgstr "@niko3 ...?"

msgid "@proto1c [The creator is mobilizing things, throwing everything into this one last shot.]"
msgstr "@proto1c [Il creatore sta mobilitando alcune cose, dando il tutto per tutto per questo ultimo tentativo.]"

msgid "@proto2b [There might not be enough internal resources left for \\p to be able to generate another session after this.]"
msgstr "@proto2b [Dopo questa sessione, le risorse interne rimaste potrebbero non essere sufficienti per farne generare un'altra a \\p.]"

msgid "@proto1c [...Just go find a new boat for now.]"
msgstr "@proto1c [...Adesso, però, vai a cercare una nuova barca.]"

msgid "@proto1c [...Just go fix the rowbot for now.]"
msgstr "@proto1c [...Per ora, vai a sistemare il robattello.]"

msgid "@proto1b [But please, be careful.]"
msgstr "@proto1b [Ma mi raccomando, fai attenzione.]"

msgid "@niko3 What about you?"
msgstr "@niko3 E tu cosa farai?"

msgid "@proto2 [I will meet you at the docks later.]"
msgstr "@proto2 [Ti raggiungerò più tardi ai moli.]"

msgid "@proto2b [...Need to take care of something first.]"
msgstr "@proto2b [...Devo occuparmi di una cosa prima.]"

msgid "@proto2 [...\\>\\nThis disk is blank.]"
msgstr "@proto2 [...\\>\\nQuest'unità di memoria è vuota.]"

msgid "@niko_83c Whoops!"
msgstr "@niko_83c Oops!"

msgid "@proto2 [Please help me restore my memory.\\>\\nBring the disk once you have the backup installed.]"
msgstr "@proto2 [Per favore, aiutami a ripristinare i miei ricordi.]\\>\\n[Riportami l'unità di memoria una volta installato il backup.]"

msgid "@proto1b [That was a session.]"
msgstr "@proto1b [Quella era una sessione.]"

msgid "@proto2 [I also tried to tell you about the restriction at the end...]"
msgstr "@proto2 [Ho anche provato ad avvertirvi della restrizione alla fine...]"

msgid "@proto2b [...But you kinda started freaking out.]"
msgstr "@proto2b [...Ma hai iniziato a dare un po' di matto.]"

msgid "@niko_upset2 Sorry..."
msgstr "@niko_upset2 Mi dispiace..."

msgid "@proto1 [Truth is, the session was designed to be run only once.]"
msgstr "@proto1 [La verità è che la sessione è stata progettata per essere eseguita solo una volta.]"

msgid "@proto1b [You weren't supposed to come back to this world after you are done.]"
msgstr "@proto1b [Non saresti dovuto tornare in questo mondo dopo aver finito.]"

msgid "@proto2b [But... a lot of things that aren't supposed to happen have happened.]"
msgstr "@proto2b [Del resto... ne sono successe di cose che non sarebbero dovute accadere.]"

msgid "@proto2 [...I'm willing to wager that \\p bypassed the restriction through the progress log failsafe method.]"
msgstr "@proto2 [...Sono pronto a scommettere che \\p abbia superato la restrizione mettendo mano al registro dei progressi.]"

msgid "@proto2b [It can restart the session, but it's an easily repeatable process.]"
msgstr "@proto2b [In quel modo può riavviare la sessione, ed è un processo facilmente ripetibile.]"

msgid "@proto2b [...Which means...]"
msgstr "@proto2b [...Il che significa...]"

msgid "@proto1b [...it's entirely possible that \\p has brought you back more than once, too.]"
msgstr "@proto1b [...che è assolutamente plausibile che \\p ti abbia riportato indietro anche più di una volta.]"

msgid "@proto1c [You may have carried out this mission too many times to count.]"
msgstr "@proto1c [Potresti aver affrontato questa missione così tante volte da non poterle contare.]"

msgid "@proto2b [...might explain why your memories felt like they were from a long time ago.]"
msgstr "@proto2b [...Questo spiegherebbe perché i tuoi ricordi ti sembrano così lontani nel tempo.]"

msgid "@niko_upset2 ..."
msgstr "@niko_upset2 ..."

msgid "@niko_upset So...\\.\\. why can \\p... do that...."
msgstr "@niko_upset Quindi...\\.\\. perché \\p... può farlo...?"

msgid "@proto2 [Shh...]"
msgstr "@proto2 [Shh...]"

msgid "@proto2b [Trying to establish a connection here...]"
msgstr "@proto2b [Sto cercando di stabilire una connessione...]"

msgid "@niko_eyeclosed Sorry..."
msgstr "@niko_eyeclosed Scusa..."

msgid "@silver [Hey, you okay in there?]"
msgstr "@silver [Ehi, va tutto bene lì dentro?]"

msgid "@silver_eyeclosed [I did what I could with the terminals for now, and...]"
msgstr "@silver_eyeclosed [Per il momento ho fatto quello che potevo con i terminali e...]"

msgid "@silver2 [...It's you...]"
msgstr "@silver2 [...Sei tu...]"

msgid "@silver2 [...you're the robot that insisted on living in the mines, are you not?]"
msgstr "@silver2 [...Sei il robot che insisteva a vivere nelle miniere, vero?]"

msgid "@silver_eyeclosed [My friend told me to keep an eye out for you, should we ever cross paths.]"
msgstr "@silver_eyeclosed [Il mio amico mi ha detto di tenerti d'occhio, se mai le nostre strade si fossero incrociate.]"

msgid "@proto1b [...Likewise.]"
msgstr "@proto1b [...Ha detto la stessa cosa a me.]"

msgid "@proto1 [...Your...\\.\\. friend gave you something the last time you saw each other.]"
msgstr "@proto1 [...Il tuo...\\.\\. amico ti ha dato qualcosa l'ultima volta che vi siete visti.]"

msgid "@proto1 [Can you show me what it is?]"
msgstr "@proto1 [Puoi mostrarmi cos'è?]"

msgid "@silver2 [Wait...\\.\\. You know about the amber?]"
msgstr "@silver2 [Aspetta...\\.\\. sai dell'ambra?]"

msgid "@proto2b [I just asked to see it, didn't I?]"
msgstr "@proto2b [Ho appena chiesto di vederla, no?]"

msgid "@silver2 [Oh, actually...]"
msgstr "@silver2 [Oh, in realtà...]"

msgid "@niko_speak I needed it to fix a robot, so she gave it to me!"
msgstr "@niko_speak L'ha data a me perché mi serviva per riparare un robot!"

msgid "@proto2 [Oh?]"
msgstr "@proto2 [Oh?]"

msgid "@niko_speak Here! See?"
msgstr "@niko_speak Ecco! Vedi?"

msgid "@proto2b [Ah.]"
msgstr "@proto2b [Ah.]"

msgid "@silver2 [Alright... here it is.]"
msgstr "@silver2 [Beh... eccola qui.]"

msgid "@proto2b [Thought so.]"
msgstr "@proto2b [Come pensavo.]"

msgid "@proto2 [He seemed to trust you, so I will treat you as an ally as well.]"
msgstr "@proto2 [Sembra si fidasse di te, quindi ti tratterò anch'io come un'alleata.]"

msgid "@silver2 [...Okay?]"
msgstr "@silver2 [...Va bene?]"

msgid "@proto1b [Please listen carefully.]"
msgstr "@proto1b [Ti prego di ascoltare attentamente.]"

msgid "@proto1 [You need to escort the messiah for the remainder of the Barrens.]"
msgstr "@proto1 [Devi scortare il messia per il resto della Baia Desolata.]"

msgid "@proto2b [I predict a high concentration of square particle disruptions in the near future.]"
msgstr "@proto2b [Prevedo molte distorsioni causate dalle particelle quadre nell'immediato futuro.]"

msgid "@silver2 [...No way.]"
msgstr "@silver2 [...Non è possibile.]"

msgid "@proto2b [Yes....\\.\\. way.]"
msgstr "@proto2b [E invece...\\.\\. è possibile.]"

msgid "@proto2 [It's likely that structures in the vicinity of the messiah might be affected.]"
msgstr "@proto2 [È probabile che le strutture nelle vicinanze del messia possano essere influenzate.]"

msgid "@proto2 [...Making it a far more treacherous pilgrimage than the previous....\\> \\@proto2b er, expectations.]"
msgstr "@proto2 [...Renderanno il pellegrinaggio ancora più pericoloso di quanto già... \\n\\>\\@proto2b ehm, si aspettasse.]"

msgid "@proto1 [\\p and the messiah need all the extra help they can get right now.]"
msgstr "@proto1 [\\p e il messia al momento hanno bisogno di tutto l'aiuto che possono ottenere.]"

msgid "@silver_eyeclosed [Understood.]"
msgstr "@silver_eyeclosed [Capito.]"

msgid "@niko2 O...\\.\\. okay..."
msgstr "@niko2 O-\\.\\.ok..."

msgid "@silver [Guess we should head back soon.]"
msgstr "@silver [Ci conviene tornare indietro tra poco.]"

msgid "@silver_lookup [Even without the squares, the mines are not a safe place to be.]"
msgstr "@silver_lookup [Anche senza i quadrati, le miniere non sono un posto sicuro in cui stare.]"

msgid "@silver2 [Come on, I'll wait for you outside.]"
msgstr "@silver2 [Sbrigatevi, vi aspetto fuori.]"

msgid "@niko3 Wait! I want to ask you-"
msgstr "@niko3 Aspetta! Volevo chiederti-"

msgid "@niko_eyeclosed She left."
msgstr "@niko_eyeclosed Se n'è andata."

msgid "@proto1b [...If you were going to ask her about being \"not real\", save your breath.]"
msgstr "@proto1b [...Se avevi intenzione di chiederle qualcosa a proposito del \"non essere reale\", risparmia il fiato.]"

msgid "@proto1b [None of the people here know their predicament.]"
msgstr "@proto1b [Nessuno qui sa della propria situazione.]"

msgid "@proto1c [In fact... I don't think they can even comprehend it.]"
msgstr "@proto1c [In realtà... non credo che possano nemmeno comprenderla.]"

msgid "@proto2 [It would be in your best interest to just... pretend like we never had this conversation.]"
msgstr "@proto2 [Ti conviene... fare finta che questa conversazione non sia mai avvenuta.]"

msgid "@proto2b [Causing mass confusion in the world's residents would likely result in unfavorable conditions for you.]"
msgstr "@proto2b [Causare una tale confusione tra gli abitanti del mondo probabilmente creerebbe condizioni sfavorevoli per te.]"

msgid "@niko4 Alright..."
msgstr "@niko4 Va bene..."

msgid "@niko3 ...wait, then what about you?"
msgstr "@niko3 ...Aspetta, e allora tu?"

msgid "@niko3 How did YOU know?"
msgstr "@niko3 Come facevi TU a saperlo?"

msgid "@proto2b [...\\.\\.We never had this conversation, remember?]"
msgstr "@proto2b [...\\.\\.\\.Non abbiamo mai avuto questa conversazione, ricordi?]"

msgid "@niko_eyeclosed Sigh."
msgstr "@niko_eyeclosed Sigh."

msgid "[MAP RECONFIGURATION SUCCESSFUL.]"
msgstr "[RICONFIGURAZIONE DELLA MAPPA ESEGUITA CON SUCCESSO.]"

msgid "@silver [He says the exit is in here, but...]"
msgstr "@silver [Dice che l'uscita è qui, ma...]"

msgid "@silver_eyeclosed [...must be hidden.]"
msgstr "@silver_eyeclosed [...dev'essere nascosta.]"

msgid "@niko I don't think we need to use this anymore, \\p."
msgstr "@niko Non penso che ci servirà di nuovo, \\p."

msgid "[PROPHETBOT 0 BACKUP SYSTEM 1.0]\\>\\n[PLEASE INSERT DISK]"
msgstr "[PROFETABOT 0 SISTEMA DI BACKUP 1.0.\\>\\nINSERIRE UNITÀ DI MEMORIA.]"

msgid "@niko Alright..."
msgstr "@niko D'accordo..."

msgid "\\c[1][ERROR: BACKUP REQUEST DENIED]\\c[0]"
msgstr "\\c[1][ERRORE: RICHIESTA DI BACKUP RIFIUTATA.]\\c[0]"

msgid "@niko_speak What?"
msgstr "@niko_speak Cosa?"

msgid "[DORMITORY ASSIGNMENTS ARE NOT UP TO DATE.]"
msgstr "[LE ASSEGNAZIONI DEL DORMITORIO NON SONO AGGIORNATE.]"

msgid "[PLEASE CONFIGURE THE RESIDENTIAL TRACKING MACHINE TO CONTINUE.]"
msgstr "[PER FAVORE CONFIGURARE LA MACCHINA DI TRACCIAMENTO RESIDENZIALE PER PROSEGUIRE.]"

msgid "@niko_eyeclosed Okay then!"
msgstr "@niko_eyeclosed D'accordo!"

msgid "[PREPARING BACKUP...]\\>\\n[WRITING TO DISK...]\\>\\n"
msgstr "[PREPARAZIONE BACKUP...\\>\\nSCRITTURA SU UNITÀ DI MEMORIA...]\\>\\n"

msgid "[26% COMPLETE...]"
msgstr "[COMPLETAMENTO OPERAZIONE: 26%...]"

msgid "[34% COMPLETE...]"
msgstr "[COMPLETAMENTO OPERAZIONE: 34%...]"

msgid "[40% COMPLETE...]"
msgstr "[COMPLETAMENTO OPERAZIONE: 40%...]"

msgid "[100% COMPLETE.]"
msgstr "[COMPLETAMENTO OPERAZIONE: 100%.]"

msgid "[EJECTING DISK.]"
msgstr "[ESPULSIONE UNITÀ DI MEMORIA.]"

msgid "@niko Yup, that's a computer."
msgstr "@niko Sì, è un computer."

