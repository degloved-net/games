msgid "tutorial_preamble=Hello there.\n"
"Thank you for installing this operating system.\n"
"I know you were probably expecting a \"game\", but...\n"
"...apologies, I'm still setting things up here.\n"
"In the meantime, why don't I show you how the system works?"
msgstr "Salve.\n"
"Grazie per aver installato questo sistema operativo.\n"
"So che probabilmente ti aspettavi un \"gioco\", ma...\n"
"...Scusa, sto ancora sistemando alcune cose qui.\n"
"Nel frattempo, che ne dici se ti mostro come funzionano le cose qua?"

msgid "tutorial_move_cursor=Use @MOVEMOUSE to move the cursor."
msgstr "Usa @MOVEMOUSE per muovere il cursore."

msgid "tutorial_drag_file=Press and hold @CLICK and drag with @MOVEMOUSE to move icons."
msgstr "Tieni premuto @CLICK e trascina con @MOVEMOUSE per muovere le icone."

msgid "tutorial_launch_application=Click with @CLICK twice to launch an application."
msgstr "Fai doppio click con @CLICK per avviare un'applicazione."

msgid "tutorial_move_window=Press and hold the window bar with @CLICK and drag with @MOVEMOUSE to move windows."
msgstr "Tieni premuto @CLICK sulla barra del titolo e trascinala con @MOVEMOUSE per spostare le finestre."

msgid "tutorial_minimize_window=Click the Hide Button to hide the window."
msgstr "Premi il Tasto Minimizza per nascondere la finestra."

msgid "tutorial_unminimize_window=Click the window on the task bar to bring it back up again."
msgstr "Premi l'icona nella barra delle applicazioni per farla ricomparire."

msgid "tutorial_close_window=Click the Close Button to close the window."
msgstr "Premi il Tasto Chiudi per chiudere la finestra."

msgid "tutorial_wrap_up=Excellent work. Now you know how to navigate the interface.\n"
"Ah! And just in time, too!"
msgstr "Lavoro eccellente. Ora sai come navigare nell'interfaccia.\n"
"Ah! E giusto in tempo, aggiungerei!"

msgid "tutorial_oneshot_appears=There we go. Everything should be ready for you.\n"
"I'll leave you to it, then.\n"
"Goodbye for now."
msgstr "Perfetto. Tutto dovrebbe essere pronto per te.\n"
"Ti lascio, allora.\n"
"Arrivederci."

msgid "tutorial_redo_preamble=Hello again!\n"
"Looks like you could use a refresher on how to navigate this system.\n"
"Very well, let's go through what I showed you before."
msgstr "Salve di nuovo!\n"
"Sembra che tu voglia rinfrescarti la memoria su come funzionano le cose qua.\n"
"Molto bene, allora ricominciamo da capo."

msgid "tutorial_redo_wrap_up=And there you have it! Hope that helped."
msgstr "Ed ecco tutto! Spero di averti aiutato."

msgid "tutorial_delete_click_file=Click this file to select it in the browser window."
msgstr "Clicca su questo file per selezionarlo."

msgid "tutorial_delete_click_delete_button=Click the delete button to delete file."
msgstr "Premi il pulsante elimina per cancellarlo."

msgid "tutorial_delete_confirm_delete=Confirm the deletion in the pop-up window."
msgstr "Conferma l'eliminazione nella finestra a comparsa."

msgid "tutorial_delete_congratulations=You did it!  That's how you delete a file."
msgstr "Ce l'hai fatta! È così che si cancella un file."

msgid "tutorial_movefile_drag_file=Click and hold this file and move the mouse cursor."
msgstr "Tieni premuto su questo file e muovi il cursore."

msgid "tutorial_movefile_drop_file=Now drag the file to the folder window on the right and drop it."
msgstr "Ora trascina il file nella finestra a destra e rilascialo."

msgid "tutorial_movefile_congratulations=And there you have it! You've moved the file from Folder 1 to Folder 2."
msgstr "Ed ecco fatto! Hai spostato il file dalla Cartella 1 alla Cartella 2."

