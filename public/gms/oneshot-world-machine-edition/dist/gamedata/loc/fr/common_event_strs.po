msgstr "@niko ...\\>\\n\\@niko_speak ... Dites-moi, vous aviez déjà vu un champ de blé, \\p ?"

msgid "[\"Yes.\", \"No.\"]"
msgstr "[\"Oui.\",\"Non.\"]"

msgid "@niko_speak Oh!\\>\\n\\@niko They're really pretty, aren't they?"
msgstr "@niko_speak Oh !\\>\\n\\@niko Ils sont vraiment beaux, n'est-ce pas ?"

