msgstr "@niko La nuit, les gens vont généralement dormir.\\>\\n\\@niko_speak Mais certaines personnes restent éveillées et utilisent des ordinateurs !"

msgid "@niko_speak Ah!\\>\\nDo you sleep during the night?"
msgstr "@niko_speak Ah !\\>\\nVous dormez la nuit ?"

