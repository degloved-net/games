msgid "@tut FAST TRAVEL\\n\\n\\nYOU CAN QUICKLY TRAVEL TO THE LOCATIONS YOU HAVE ALREADY VISITED BY SELECTING THE \"FAST TRAVEL\" OPTION IN THE MENU.\\n\\nYOU CAN OPEN THE MENU WITH @MAINMENU\\n\\nFAST TRAVEL CANNOT BE USED INDOORS."
msgstr "@tut VOYAGE RAPIDE\\n\\n\\nVOUS POUVEZ VOYAGER RAPIDEMENT AUX LIEUX DÉJÀ VISITÉS EN SELECTIONNANT L'OPTION \"VOYAGE RAPIDE\" DANS LE MENU.\\n\\nVOUS POUVEZ OUVRIR LE MENU AVEC @MAINMENU\\n\\nLE VOYAGE RAPIDE NE PEUT PAS ÊTRE UTILISÉ À L'INTÉRIEUR."

msgid "@tut2 CONTROLS\\n\\nEXAMINE/SELECT - @OK\\n\\nCANCEL - @CANCEL\\n\\nWALK - @MOVE\\n\\nWALK FASTER - @RUN\\n\\nMENU - @MAINMENU\\n\\nINVENTORY - @INVENTORY"
msgstr "@tut2 CONTRÔLES\\n\\nEXAMINER/CHOISIR - @OK\\n\\nANNULER - @CANCEL\\n\\nMARCHER - @MOVE\\n\\nMARCHER PLUS VITE - @RUN\\n\\nMENU - @MAINMENU\\n\\nINVENTAIRE - @INVENTORY"

msgid "@tut GAMEPLAY\\n\\nEXPLORE AND INTERACT WITH THE ENVIRONMENT AND CHARACTERS. SOMETIMES YOU MAY FIND AN ITEM.\\n\\nONCE YOU HAVE PICKED UP AN ITEM, YOU MAY SELECT IT FROM YOUR INVENTORY.\\n\\nWHEN THE ITEM IS ACTIVE, YOU CAN EITHER COMBINE IT WITH OTHER ITEMS IN THE INVENTORY OR USE IT AT CERTAIN LOCATIONS IN ORDER TO PROGRESS."
msgstr "@tut JEU\\n\\nEXPLOREZ ET INTERAGISSEZ AVEC L'ENVIRONNEMENT ET LES PERSONNAGES. DE TEMPS EN TEMPS VOUS POURREZ TROUVER UN OBJET.\\n\\nUNE FOIS L'OBJET RAMASSÉ, VOUS POUVEZ LE SELECTIONNER À PARTIR DE VOTRE INVENTAIRE.\\n\\nQUAND L'OBJET EST ACTIF, VOUS POUVEZ SOIT LE COMBINER AVEC D'AUTRES OBJETS DANS L'INVENTAIRE, SOIT L'UTILISER À CERTAINS ENDROITS POUR PROGRESSER."

msgid "@tut OTHER\\n\\n\\n\\n\\nCLOSING THE GAME WINDOW WILL SAVE YOUR PROGRESS.\\n\\nTHIS GAME ALSO SAVES AFTER SOME KEY EVENTS."
msgstr "@tut AUTRE\\n\\n\\n\\n\\nFERMER LA FENÊTRE DU JEU SAUVEGARDERA VOTRE PROGRÈS.\\n\\nCE JEU SAUVEGARDE AUSSI APRÈS CERTAINS ÉVÉNEMENTS CLÉS."

