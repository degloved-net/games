msgstr "@niko_eyeclosed ... Elle a détourné le regard."

msgid "@niko_distressed2 She's gone..."
msgstr "@niko_distressed2 Elle est partie..."

msgid "@niko Oh... \\>\\nThere's something on the ground here."
msgstr "@niko Oh... \\>\\nlà, il y a quelque chose par terre."

msgid "@niko_speak It looks like... a kernel of corn?"
msgstr "@niko_speak On dirait... un grain de maïs."

msgid "@niko She must've left it behind."
msgstr "@niko Elle a dû le faire tomber."

msgid "@maize ...S...\\.\\. savior...?"
msgstr "@maize ... M...\\.\\. Messie... ?"

msgid "@maize I can't believe it...\\.\\.\\nYou're real..."
msgstr "@maize Je n'arrive pas à croire...\\.\\.\\nTu n'es pas une légende..."

msgid "@niko_shock ....miss?"
msgstr "@niko_shock ... Mademoiselle ?"

msgid "@niko_speak Are you... alright?"
msgstr "@niko_speak Vous... allez bien ?"

msgid "@maize No...."
msgstr "@maize Non...."

msgid "@niko_speak W-we should get you to the village! \\.\\.\\nMaybe they could-"
msgstr "@niko_speak N-Nous ferions mieux de vous emmener au village ! \\.\\.\\nIls pourront peut-être..."

msgid "@maize It's.... okay...\\.\\nIt's okay.....\\.\\n...too late for me."
msgstr "@maize Ce n'est... rien...\\.\\nCe n'est rien...\\.\\n... Il est trop tard pour moi."

msgid "@niko_speak But..."
msgstr "@niko_speak Mais..."

msgid "@maize ...the sun...."
msgstr "@maize ... Le soleil...."

msgid "@maize I haven't seen it... I haven't felt it in so long..."
msgstr "@maize Je ne l'ai pas vu... Ça fait si longtemps que je ne l'ai pas senti..."

msgid "@maize ...\\.\\.Savior, if it's not too much trouble...\\.\\.\\nCan you lend me the sun for a while?"
msgstr "@maize ...\\.\\. Messie, si ça ne te pose pas de problème...\\.\\.\\nTu peux me prêter le soleil un instant ?"

msgid "@niko I...\\.\\. \\@niko_speak Will it make you better?"
msgstr "@niko Je...\\.\\.\\@niko_speak  Est-ce que ça vous aidera ?"

msgid "@maize .\\..\\..\\.No.\\. It will not save me."
msgstr "@maize .\\..\\..\\. Non.\\. Ça ne me sauvera pas."

msgid "@maize I just want to experience the sun one more time before I... \\.\\.Well..."
msgstr "@maize Je voudrais juste ressentir le soleil une dernière, fois avant de... \\.\\.Eh bien.."

msgid "@niko_eyeclosed Oh..."
msgstr "@niko_eyeclosed Oh..."

msgid "@maize Would it...\\.\\.\\nWould it be too selfish of me to ask?"
msgstr "@maize Est-ce que...\\.\\.\\nEst-ce égoïste de ma part de te demander cela ?"

