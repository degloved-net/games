msgid "@green_gatekeeper [Good luck.]"
msgstr "@green_gatekeeper [Bonne chance.]"

msgid "@niko_eyeclosed \\p, I'm too tired to go on right now...\\>\\nPlease let me nap for a bit somewhere."
msgstr "@niko_eyeclosed \\p, j'ai trop sommeil pour continuer...\\>\\nLaissez-moi me reposer quelque part."

msgid "@niko_eyeclosed I remember seeing a room to the west...\\>\\nIt looked like it might be a good place to take a rest."
msgstr "@niko_eyeclosed Je me souviens avoir vu une pièce à l'ouest...\\>\\nCela semblait être l'endroit idéal pour se reposer."

msgid "@niko_speak I found a pen! \\.\\.\\@niko Sort of."
msgstr "@niko_speak J'ai trouvé un stylo !\\.\\.\\@niko Enfin, en quelque sorte."

msgid "@green_gatekeeper [Good.\\nPlease write your name here.]"
msgstr "@green_gatekeeper [Très bien.\\nÉcrivez votre nom ici.]"

msgid "@green_gatekeeper [Indeed You Do.]\\>\\n[But Are You Not Forgetting Something?]"
msgstr "@green_gatekeeper [Effectivement.]\\>\\n[Mais N'oubliez-Vous Pas Quelque Chose ?]"

msgid "@niko_eyeclosed .\\..\\..\\.\\>\\n\\@niko_speak Oh, the sun!"
msgstr "@niko_eyeclosed .\\..\\..\\.\\>\\n\\@niko_speak Oh, le soleil !"

msgid "@green_gatekeeper [Have You Found Something To Write With?]"
msgstr "@green_gatekeeper [Avez-Vous Trouvé Quelque Chose Pour Écrire ?]"

msgid "@green_gatekeeper [The Sun...\\.\\. You're The Messiah!]"
msgstr "@green_gatekeeper [Le Soleil... \\.\\.Vous Êtes Le Messie !]"

msgid "@green_gatekeeper [Are you on your way to the Tower?]"
msgstr "@green_gatekeeper [Vous dirigez-vous vers la Tour ?]"

msgid "@green_gatekeeper [I saw you carrying the sun earlier.\\nYou're the messiah, then?\\nOn your way to the Tower?]"
msgstr "@green_gatekeeper [Vous transportiez le soleil tout à l'heure.\\nVous êtes donc le messie ?\\nVous vous dirigez vers la Tour ?]"

msgid "@niko Mhm."
msgstr "@niko Hum."

msgid "@green_gatekeeper [You can enter the Refuge through this wall.\\nYou'll need to sign your name in this scroll first.]"
msgstr "@green_gatekeeper [Vous pouvez accéder au Refuge par le biais de ce mur.\\nVous devez juste signer ce parchemin avant.]"

msgid "@niko Alright.\\.\\.\\n.\\..\\..Do you have a pen?"
msgstr "@niko D'accord. \\.\\.\\n.\\..\\.. Avez-vous un stylo ?"

msgid "@green_gatekeeper [Umm.\\..\\..]"
msgstr "@green_gatekeeper [Hum.\\..\\..]"

msgid "@green_gatekeeper [...No.\\.\\. I've lost mine.]"
msgstr "@green_gatekeeper [... Non.\\.\\. J'ai perdu le mien.]"

msgid "@green_gatekeeper [Perhaps you should look around the Glen for another.]"
msgstr "@green_gatekeeper [Vous devriez en chercher un dans le Vallon.]"

msgid "@niko_eyeclosed The doorway is full of vines, \\p..."
msgstr "@niko_eyeclosed L'entrée est pleine de vignes, \\p..."

