msgid "@alula_speak Hey!"
msgstr "@alula_speak Hé !"

msgid "@alula I saw you going to the courtyard!\\>\\n\\@alula_speak So I thought I'd tag along!"
msgstr "@alula J'ai vu que tu te rendais dans la cour !\\>\\n\\@alula_speak Alors je me suis dit que j'allais t'accompagner !"

msgid "@calamus_smile Same!"
msgstr "@calamus_smile Pareil !"

msgid "@alula This is the courtyard.\\>\\n\\@alula It's got water... and... stuff..."
msgstr "@alula C'est la cour.\\>\\n\\@alula Il ya de l'eau... et... des trucs..."

msgid "@alula_oh Oh, are you leaving now?"
msgstr "@alula_oh Oh, tu pars déjà ?"

msgid "@alula_speak Good luck, Niko! \\>\\n\\@alula We believe in you!"
msgstr "@alula_speak Bonne chance Niko ! \\>\\n\\@alula On croit en toi !"

msgid "@niko It's a ball."
msgstr "@niko C'est une balle."

msgid "@alula That's mine!\\>\\n\\@alula_pout It doesn't bounce around as much as it used to, though..."
msgstr "@alula C'est la mienne !\\>\\n\\@alula_pout Mais elle ne rebondit pas aussi bien qu'avant..."

msgid "@calamus There's an entrance to an underground passage here.\\>\\nIt's flooded, though."
msgstr "@calamus Il y a une entrée vers un passage souterrain ici.\\>\\nMais elle est inondée."

msgid "@calamus_speak Oh, are you leaving now?\\>\\n\\@calamus_smile It was... nice, to meet you.\\>\\n\\@calamus Really. Thanks for everything."
msgstr "@calamus_speak Oh, tu pars déjà ?\\>\\n\\@calamus_smile Je suis... content d'avoir pu te rencontrer.\\>\\n\\@calamus Vraiment. Merci pour tout."

