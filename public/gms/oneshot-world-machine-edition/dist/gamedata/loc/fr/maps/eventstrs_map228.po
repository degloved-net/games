msgid "@niko_distressed2 .\\..\\..\\.."
msgstr "@niko_distressed2 .\\..\\..\\.."

msgid "@niko3 ...you okay in there?"
msgstr "@niko3 ... Tout va bien par ici ?"

msgid "@niko4 ..."
msgstr "@niko4 ..."

msgid "@niko3 ...hello?"
msgstr "@niko3 ... Bonjour ?"

msgid "@plight_worry ...mostly."
msgstr "@plight_worry ... Presque."

msgid "@plight_worry2 ...look, don't worry about me for now, okay?"
msgstr "@plight_worry2 ... Écoute, ne t'en fais pas pour moi pour l'instant, d'accord ?"

msgid "@plight_sigh You got more important stuff to deal with..."
msgstr "@plight_sigh Tu as des choses plus importantes à régler..."

msgid "@niko2 ...let's see if this elevator works."
msgstr "@niko2 ... Voyons si cet ascenseur marche."

