msgid "This plane doesn't have a runway because night said so that's why. -GIR"
msgstr "Cet avion n'a pas de piste parce que la nuit l'a dit, voilà pourquoi. -GIR"

msgid "@cedric_sigh ...phew."
msgstr "@cedric_sigh ... Pfiou."

msgid "@cedric_smile Made it!"
msgstr "@cedric_smile On a réussi !"

msgid "@niko_pancakes ..."
msgstr "@niko_pancakes ..."

msgid "@cedric3 You...\\.\\. okay, there?"
msgstr "@cedric3 Ça... \\.\\.va ?"

msgid "@niko_pancakes ...\\>That was the coolest thing I have ever done in my entire life."
msgstr "@niko_pancakes ... \\>C'est le truc le plus cool que j'ai fait de toute ma vie."

msgid "@cedric_smile Heheh...\\.\\. reactions from first-timers are always delightful to watch."
msgstr "@cedric_smile Hé hé... \\.\\.Je ne me lasserai jamais de voir la première réaction des gens."

msgid "@niko5 ..."
msgstr "@niko5 ..."

msgid "@niko6 Hey, \\p?"
msgstr "@niko6 Hé, \\p ?"

msgid "@niko2 That... was really fun."
msgstr "@niko2 C'était... vraiment amusant."

msgid "@niko_speak Did you... have fun too?"
msgstr "@niko_speak Toi aussi, ça... t'a plu ?"

msgid "@niko_eyeclosed I mean... you weren't on the plane with me, but..."
msgstr "@niko_eyeclosed Enfin... je sais que tu n'étais pas dans l'avion, mais..."

msgid "@niko_speak You got to watch it at least, right?"
msgstr "@niko_speak Tu as pu regarder au moins, hein ?"

msgid "@niko And... \\.\\.Cedric...?"
msgstr "@niko Et... \\.\\.Cedric... ?"

msgid "@cedric3 Yeah?"
msgstr "@cedric3 Oui ?"

msgid "@niko_eyeclosed Thanks..."
msgstr "@niko_eyeclosed Merci..."

msgid "@cedric3 ....\\.\\.What for?"
msgstr "@cedric3 .... \\.\\.Pour quoi ?"

msgid "@niko_speak Flying!"
msgstr "@niko_speak Pour le vol !"

msgid "@cedric Oh, um..."
msgstr "@cedric Oh, euh..."

msgid "@cedric_smile You're... \\.\\.welcome?"
msgstr "@cedric_smile De... \\.\\.De rien."

msgid "@niko_eyeclosed And... for answering my questions back there, too..."
msgstr "@niko_eyeclosed Et... pour avoir répondu à mes questions tout à l'heure, aussi..."

msgid "@niko5 And... \\.\\.for telling me more about the World Machine."
msgstr "@niko5 Et... \\.\\.pour m'en avoir dit plus sur la Machine-monde."

msgid "@niko_upset I'm just.... \\.\\.really sorry about what happened to your old world, though..."
msgstr "@niko_upset Je suis juste... \\.\\.triste pour ce qui est arrivé à ton ancien monde..."

msgid "@niko2 So...\\.\\. I'll help you the best that I can."
msgstr "@niko2 Donc... \\.\\.je t'aiderai du mieux que je peux."

msgid "@cedric ..."
msgstr "@cedric ..."

msgid "@niko4 And...\\.\\. even if it's all just a machine, this world is still...\\.\\. \\@niko2 nice..."
msgstr "@niko4 Et...\\.\\. même si ce n'est qu'une simple machine, ce monde est quand même... \\.\\.\\@niko2 joli..."

msgid "@niko_eyeclosed I mean, I got to fly... \\.\\.I got to see the ocean..."
msgstr "@niko_eyeclosed Après tout, j'ai pu voler... \\.\\.J'ai vu l'océan..."

msgid "@niko And...\\.\\. I got to meet a lot of nice people!\\n\\>\\@niko_speak People like you!"
msgstr "@niko Et... \\.\\.j'ai rencontré plein de gens sympa !\\n\\>\\@niko_speak Des gens comme toi !"

msgid "@niko_eyeclosed ...and Prototype, even if he's broken right now."
msgstr "@niko_eyeclosed ... Et Prototype, même s'il ne fonctionne plus maintenant."

msgid "@cedric ...\\>\\@cedric_smile I'm glad you are taking it so well, Niko."
msgstr "@cedric ... \\>\\@cedric_smile Je suis content que tu le prennes aussi bien, Niko."

msgid "@cedric2 And... I'm glad that we have met as well."
msgstr "@cedric2 Et... qu'on se soit rencontrés."

msgid "@cedric_sigh ...Despite the...\\.\\. circumstances."
msgstr "@cedric_sigh ... En dépit des...\\.\\. circonstances."

msgid "@cedric_talk Ah, speaking of Proto... \\@cedric_hmm I should probably head off now."
msgstr "@cedric_talk Ah, en parlant de Proto... \\@cedric_hmm Je ferais mieux d'y aller."

msgid "@cedric I need to go pick up the siblings too..."
msgstr "@cedric Je dois aller chercher nos deux amis."

msgid "@niko2 That's true...\\.\\. those two have been waiting for a while now..."
msgstr "@niko2 C'est vrai...\\.\\. Ça fait maintenant un moment qu'ils attendent..."

msgid "@cedric_hmm In the meantime..."
msgstr "@cedric_hmm En attendant..."

msgid "@cedric_smile Do you remember what to do to get to the surface?"
msgstr "@cedric_smile Tu te rappelles ce que tu dois faire pour aller à la surface ?"

msgid "@niko_speak I remember having to fix an elevator button!"
msgstr "@niko_speak Je me souviens qu'il faut réparer un bouton d'ascenseur !"

msgid "@cedric_hmm Alright, you should attend to that, then."
msgstr "@cedric_hmm Bien, alors tu devrais t'en occuper."

msgid "@cedric_talk Let's meet up here in an hour, okay?"
msgstr "@cedric_talk Rejoignons-nous ici dans une heure, d'accord ?"

msgid "@niko Got it!"
msgstr "@niko C'est noté !"

msgid "@cedric Alright, now lemme just-"
msgstr "@cedric Bon, maintenant laisse-moi juste..."

msgid "@cedric_eek ..."
msgstr "@cedric_eek ..."

msgid "@niko_shock No!"
msgstr "@niko_shock Non !"

msgid "@niko_shock ...\\.\\.they're...\\.\\. trapped on the island..."
msgstr "@niko_shock ...\\.\\. Ils sont... \\.\\.prisonniers sur l'île..."

msgid "@niko_distressed ..."
msgstr "@niko_distressed ..."

msgid "@niko_distressed2 ......Calamus....\\> Alula...."
msgstr "@niko_distressed2 ... Calamus... \\>Alula..."

msgid "@niko_distressed2 ...they're..."
msgstr "@niko_distressed2 ... Ils sont..."

msgid "@cedric_eek ....we\\.\\. ...don't have much time left."
msgstr "@cedric_eek ... Le\\.\\.... temps nous est compté."

msgid "@cedric_sigh2 Niko... change of plans."
msgstr "@cedric_sigh2 Niko... changement de plan."

msgid "@cedric_sigh Please give me the memory disk."
msgstr "@cedric_sigh Donne-moi la disquette, s'il te plaît."

msgid "@niko2 ...alright..."
msgstr "@niko2 ... D'accord..."

msgid "@cedric2 Listen carefully."
msgstr "@cedric2 Écoute attentivement."

msgid "@cedric_sigh2 It's likely I'll be targeted again, so we should split up to keep you safe."
msgstr "@cedric_sigh2 Il y a de fortes chances que je sois ciblé à nouveau, alors pour ta sécurité, nous devrions nous séparer."

msgid "@cedric I want you to find a door under a large clock."
msgstr "@cedric Trouve une porte sous une grosse horloge."

msgid "@cedric_sigh The room behind it houses a pair of ground access elevators."
msgstr "@cedric_sigh Derrière cette porte, tu trouveras une pièce avec deux ascenseurs."

msgid "@cedric Once you get to the ground, immediately find Rue and bring her back to the room."
msgstr "@cedric Une fois au rez-de-chaussée, va immédiatement voir Rue et ramène-la dans la pièce."

msgid "@cedric She will know what to do in the meantime."
msgstr "@cedric Elle saura quoi faire, en attendant."

msgid "@niko2 Alright...\\.\\. \\@niko3 What about you, though?"
msgstr "@niko2 D'accord... \\.\\.\\@niko3 Et toi, alors ?"

msgid "@cedric3 I'm going to bring Prototype back."
msgstr "@cedric3 Je vais ramener Prototype."

msgid "@niko_surprised WH-"
msgstr "@niko_surprised QU..."

msgid "@niko_surprised Are you okay???"
msgstr "@niko_surprised Tout va bien ???"

msgid "@cedric_talk WHAAAAAT????"
msgstr "@cedric_talk QUOIIIIII ????"

msgid "@niko_speak ARE YOU OKAAAAAY???"
msgstr "@niko_speak TOUT VA BIEN ???"

msgid "@cedric_talk DON'T WORRYYY I'M FINEEEE"
msgstr "@cedric_talk NE T'EN FAIS PAAAS, TOUUUT VA BIEN."

msgid "@niko_eyeclosed ...don't scare me like that..."
msgstr "@niko_eyeclosed ... Ne me fais pas peur comme ça..."

msgid "@niko ..."
msgstr "@niko ..."

msgid "@niko_upset2 ...."
msgstr "@niko_upset2 ..."

msgid "@niko2 Hey, \\p...?"
msgstr "@niko2 Hé, \\p... ?"

msgid "@niko_eyeclosed Let's... do our best."
msgstr "@niko_eyeclosed Faisons... de notre mieux."

