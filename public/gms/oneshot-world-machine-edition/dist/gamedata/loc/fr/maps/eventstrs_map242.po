msgstr "@niko3 Alors s'il vous plaît... donnez-moi une chance."

msgid "@en_upset [I don't know.]"
msgstr "@en_upset [Je ne sais pas.]"

msgid "@en_upset2 [I've never done this before, I...]"
msgstr "@en_upset2 [Je ne l'ai jamais fait avant, je...]"

msgid "@en_upset_meow [I'm scared...]"
msgstr "@en_upset_meow [J'ai peur...]"

msgid "@niko3 You can do it, I know you can!"
msgstr "@niko3 Vous pouvez le faire, je le sais !"

msgid "@niko4 You've...\\.\\. helped me come this far."
msgstr "@niko4 Grâce à vous...\\.\\. j'ai réussi à venir jusqu'ici."

msgid "@en_upset [...I'll...]\\>\\n\\@en_eyeclosed [I'll try.]"
msgstr "@en_upset [Je...]\\>\\n\\@en_eyeclosed [Je vais essayer.]"

msgid "@en3 [I can't promise anything, but...]"
msgstr "@en3 [Je ne promets rien, mais...]"

msgid "@en4 [Here.]"
msgstr "@en4 [Tenez.]"

msgid "@en_eyeclosed [Take the sun.]"
msgstr "@en_eyeclosed [Prenez le soleil.]"

msgid "@en5 [I'll...\\.\\. try to remember the lost code...]"
msgstr "@en5 [Je...\\.\\. vais tenter de me souvenir du code perdu...]"

msgid "@en4 [...and... recreate it.]"
msgstr "@en4 [... et... le recréer.]"

msgid "@en_upset2 [But for that to happen...]"
msgstr "@en_upset2 [Mais pour que cela arrive...]"

msgid "@en3 [Niko... you need to navigate through this room...]"
msgstr "@en3 [Niko... vous devez traverser cette pièce...]"

msgid "@en_eyeclosed [You need to get past the squares somehow...]"
msgstr "@en_eyeclosed [Vous devez trouver un moyen de passer ces carrés...]"

msgid "@en_distressed [Oh...\\.\\. I don't like this...]"
msgstr "@en_distressed [Oh...\\.\\. Je n'aime pas ça...]"

msgid "@en_distressed2 [What if you get hurt?]"
msgstr "@en_distressed2 [Et s'il vous arrivait malheur ?]"

msgid "@niko2 It's fine... It's fine..."
msgstr "@niko2 Ça va aller..."

msgid "@niko4 I'll...\\.\\. I'll try to be careful, ok?"
msgstr "@niko4 Je...\\.\\. Je ferai attention, d'accord ?"

msgid "@niko2 I can do this."
msgstr "@niko2 Je peux y arriver."

