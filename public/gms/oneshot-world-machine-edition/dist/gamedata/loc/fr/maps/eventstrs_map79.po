msgid "@niko It's a box of medical tools."
msgstr "@niko C'est une trousse d'équipement médical."

msgid "@niko Most of them are broken or rusted beyond use, but..."
msgstr "@niko La plupart des outils sont cassés ou hors d'usage à cause de la rouille, mais..."

msgid "@niko_speak This plastic syringe seems to be okay."
msgstr "@niko_speak Cette seringue en plastique a l'air en bon état."

