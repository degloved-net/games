msgid "@niko_upset ...why would...\\>\\nwhy would you create a world like...\\>\\n\\@niko_distressed_meow this?"
msgstr "@niko_upset ... Pourquoi...\\>\\n Pourquoi créer un monde... \\>\\n\\@niko_distressed_meow pareil ?"

msgid "@proto_gasp2 [Wait, what?]"
msgstr "@proto_gasp2 [Euh, quoi ?]"

msgid "@niko_upset_meow Why would you make a world that's doomed from the beginning?"
msgstr "@niko_upset_meow Pourquoi créer un monde voué à l'échec dès le départ ?"

msgid "@niko_distressed_meow ...why do you keep bringing me back to it?"
msgstr "@niko_distressed_meow ... Pourquoi me faire revenir sans cesse ?"

msgid "@niko_upset2 \\p..... \\>\\naren't you supposed to be a kind god??"
msgstr "@niko_upset2 \\p..... \\>\\nje croyais que tu étais un dieu bienveillant ??"

msgid "@proto1b [...oh.]"
msgstr "@proto1b [... Oh.]"

msgid "@proto_eyeclosed [It appears that we have some confusion here.]"
msgstr "@proto_eyeclosed [Je crois qu'il y a confusion.]"

msgid "@proto2 [\\p did not build the world, Niko.]"
msgstr "@proto2 [\\p n'a pas créé le monde, Niko.]"

msgid "@niko3 Oh..."
msgstr "@niko3 Oh..."

msgid "@proto2 [\\p only owns a machine that is able to generate the world from preexisting code.]"
msgstr "@proto2 [\\p possède seulement une machine capable de générer le monde à partir d'un code préexistant.]"

msgid "@proto2b [They actually have fairly limited control of the events.]"
msgstr "@proto2b [et a en réalité un contrôle relativement limité sur les événements.]"

msgid "@proto2 [The world was built by someone else altogether.]"
msgstr "@proto2 [Le monde a été créé par une toute autre personne.]"

msgid "@proto1c [Someone you cannot begin to fathom.]"
msgstr "@proto1c [Une personne dont tu ne peux même pas concevoir l'existence.]"

msgid "@proto2b [It was also not designed to be the futile quest that it is now, but...]"
msgstr "@proto2b [À l’origine, le monde n'a pas été conçu pour devenir cette quête futile, mais…]"

msgid "@proto_eyeclosed [...too many things went wrong.]"
msgstr "@proto_eyeclosed [... Il y a eu trop de problèmes.]"

msgid "@proto1c [There's... a type of signal disruption that he never expected.]"
msgstr "@proto1c [Le signal a... quelque peu été perturbé, et il ne l'avait pas prévu.]"

msgid "@proto1b [It's eating away at the world, slowly rendering it into an unrecognizable mess.]"
msgstr "@proto1b [Ça dévore le monde, le transformant lentement en quelque chose de méconnaissable.]"

msgid "@proto2b [Even if you bring back the sun, it will not go away.]"
msgstr "@proto2b [Même si vous rameniez le soleil, cela ne changerait rien.]"

msgid "@niko3 The square stuff, isn't it?"
msgstr "@niko3 Vous parlez des trucs carrés, c'est ça ?"

msgid "@niko_eyeclosed I remember those from before..."
msgstr "@niko_eyeclosed Je me souviens de ces choses..."

msgid "@proto1b [Then you know what to watch out for.]"
msgstr "@proto1b [Alors, vous savez que vous devez y faire attention.]"

msgid "@proto1c [...The creator knows what might be causing it, but there is nothing that he could do...]"
msgstr "@proto1c [... Le créateur connaît probablement leur origine, mais il n'a jamais pu lutter contre...]"

msgid "@proto1 [...until now.]"
msgstr "@proto1 [... Jusqu'à maintenant.]"

msgid "@proto1b [You managed to find me, after all.]"
msgstr "@proto1b [Vous avez réussi à me trouver, après tout.]"

msgid "@niko2 ...?"
msgstr "@niko2 ... ?"

msgid "@proto2 [You being here was due to his help.]"
msgstr "@proto2 [Si vous êtes là, c'est grâce à son aide.]"

msgid "@niko2 Oh...\\> I guess it has something to do with the journal?"
msgstr "@niko2 Oh...\\>ça a un rapport avec le carnet, n'est-ce pas ?"

msgid "@proto1b [Correct.]"
msgstr "@proto1b [C'est exact.]"

msgid "@proto1 [Looks like he wants to have one final attempt at fixing it.]"
msgstr "@proto1 [Il semblerait qu'il veuille tenter de le réparer, une dernière fois.]"

msgid "@proto2 [...and he might need to do it through you.]"
msgstr "@proto2 [... Et il se peut qu'il doive le faire à travers vous.]"

msgid "@proto1b [Niko, do you remember how to get to the Glen?]"
msgstr "@proto1b [Niko, savez-vous comment aller au Vallon ?]"

msgid "@proto2 [Whatever you did in your last session, you should stick with it for now.]"
msgstr "@proto2 [Quoi que vous ayez fait lors de votre dernière session, vous devriez vous y tenir, pour l'instant.]"

msgid "@niko4 I..."
msgstr "@niko4 Je..."

msgid "@niko_eyeclosed I remember a boat..."
msgstr "@niko_eyeclosed Je me souviens d'un bateau..."

msgid "@niko ...more specifically, fixing a robot that drives the boat."
msgstr "@niko ... Ou plutôt, de réparer un robot aux commandes d'un bateau."

msgid "@proto2 [Alright, then go do that.]"
msgstr "@proto2 [Très bien, alors faites ça.]"

msgid "@niko3 But..."
msgstr "@niko3 Mais..."

msgid "@niko_eyeclosed The boat robot has those squares over it..."
msgstr "@niko_eyeclosed Le robot du bateau était recouvert de ces carrés..."

msgid "@proto_gasp2 ...oh."
msgstr "@proto_gasp2 ... Oh."

msgid "@proto2b [Then do whatever you must to find a new boat.]"
msgstr "@proto2b [Faites tout ce que vous pouvez pour trouver un nouveau bateau.]"

msgid "@proto2 [There are plenty of machine parts around the Barrens that can be repurposed.]"
msgstr "@proto2 [Il y a plein de pièces détachées dans la Lande qui pourraient encore servir.]"

msgid "@niko_upset ...\\>\\n\\@niko_upset2 .........."
msgstr "@niko_upset ...\\>\\n\\@niko_upset2 .........."

msgid "@niko_eyeclosed Sigh..."
msgstr "@niko_eyeclosed *Soupir* ..."

msgid "@proto2 [You seem enthusiastic.]"
msgstr "@proto2 [Vous avez l'air enthousiaste.]"

msgid "@proto2b [...that was sarcasm.]"
msgstr "@proto2b [... C'était ironique.]"

msgid "@niko_upset Knowing everything isn't real..."
msgstr "@niko_upset Savoir que rien n'est réel..."

msgid "@niko_upset2 ...really does make it feel pointless..."
msgstr "@niko_upset2 ... Donne l'impression que tout cela est inutile..."

msgid "@proto1b [But you DO want to go home, right?]"
msgstr "@proto1b [Mais vous voulez VRAIMENT rentrer chez vous, n'est-ce pas ?]"

msgid "@niko3 Yeah, but..."
msgstr "@niko3 Oui, mais..."

msgid "@niko_distressed2 How will I know that this isn't just another..."
msgstr "@niko_distressed2 Comment savoir si ce n'est pas juste un autre..."

msgid "@proto2b [Because this session might be the last one.]"
msgstr "@proto2b [Cette session pourrait être la dernière.]"

msgid "@niko3 ...?"
msgstr "@niko3 ... ?"

msgid "@proto1c [The creator is mobilizing things, throwing everything into this one last shot.]"
msgstr "@proto1c [Le créateur fait tout ce qu'il peut pour que cet ultime essai réussisse.]"

msgid "@proto2b [There might not be enough internal resources left for \\p to be able to generate another session after this.]"
msgstr "@proto2b [Il ne doit pas rester suffisamment de ressources internes, alors \\p ne pourra pas générer une autre session après cela.]"

msgid "@proto1c [...Just go find a new boat for now.]"
msgstr "@proto1c [... Pour l'instant, cherchez un nouveau bateau.]"

msgid "@proto1c [...Just go fix the rowbot for now.]"
msgstr "@proto1c [... En attendant, réparez le ramebot.]"

msgid "@proto1b [But please, be careful.]"
msgstr "@proto1b [Mais faites attention à vous, s'il vous plaît.]"

msgid "@niko3 What about you?"
msgstr "@niko3 Et vous ?"

msgid "@proto2 [I will meet you at the docks later.]"
msgstr "@proto2 [Je vous retrouverai sur les quais, plus tard.]"

msgid "@proto2b [...Need to take care of something first.]"
msgstr "@proto2b [... Il y a une chose dont je dois m'occuper avant.]"

msgid "@proto2 [...\\>\\nThis disk is blank.]"
msgstr "@proto2 [...\\>\\nCette disquette est vide.]"

msgid "@niko_83c Whoops!"
msgstr "@niko_83c Oups !"

msgid "@proto2 [Please help me restore my memory.\\>\\nBring the disk once you have the backup installed.]"
msgstr "@proto2 [Veuillez m'aider à restaurer ma mémoire.\\>\\nRamenez la disquette une fois la sauvegarde installée.]"

msgid "@proto1b [That was a session.]"
msgstr "@proto1b [C'était une session.]"

msgid "@proto2 [I also tried to tell you about the restriction at the end...]"
msgstr "@proto2 [J'ai aussi essayé de vous avertir de la restriction, à la fin...]"

msgid "@proto2b [...But you kinda started freaking out.]"
msgstr "@proto2b [... Mais vous avez commencé à paniquer.]"

msgid "@niko_upset2 Sorry..."
msgstr "@niko_upset2 Pardon..."

msgid "@proto1 [Truth is, the session was designed to be run only once.]"
msgstr "@proto1 [En vérité, la session a été créée pour n'être utilisée qu'une seule fois.]"

msgid "@proto1b [You weren't supposed to come back to this world after you are done.]"
msgstr "@proto1b [Vous ne deviez pas revenir dans ce monde après avoir terminé.]"

msgid "@proto2b [But... a lot of things that aren't supposed to happen have happened.]"
msgstr "@proto2b [Mais... il y a beaucoup de choses qui ne devaient pas se passer qui sont arrivées.]"

msgid "@proto2 [...I'm willing to wager that \\p bypassed the restriction through the progress log failsafe method.]"
msgstr "@proto2 [... \\p a contourné la restriction grâce à la méthode très fiable de la sauvegarde de la progression, n'est-ce pas ?]"

msgid "@proto2b [It can restart the session, but it's an easily repeatable process.]"
msgstr "@proto2b [Le redémarrage de la session est possible, cette procédure très facile à reproduire.]"

msgid "@proto2b [...Which means...]"
msgstr "@proto2b [... Ce qui signifie que...]"

msgid "@proto1b [...it's entirely possible that \\p has brought you back more than once, too.]"
msgstr "@proto1b [... Qu'il est aussi tout à fait possible que \\p vous ait fait revenir plus d'une fois.]"

msgid "@proto1c [You may have carried out this mission too many times to count.]"
msgstr "@proto1c [Vous avez dû accomplir cette mission un nombre incalculable de fois.]"

msgid "@proto2b [...might explain why your memories felt like they were from a long time ago.]"
msgstr "@proto2b [... Cela expliquerait pourquoi vous aviez le sentiment que c'était de vieux souvenirs.]"

msgid "@niko_upset2 ..."
msgstr "@niko_upset2 ..."

msgid "@niko_upset So...\\.\\. why can \\p... do that...."
msgstr "@niko_upset Donc...\\.\\.pourquoi \\p... fait ça.... ?"

msgid "@proto2 [Shh...]"
msgstr "@proto2 [Chut...]"

msgid "@proto2b [Trying to establish a connection here...]"
msgstr "@proto2b [J'essaie d'établir une connexion...]"

msgid "@niko_eyeclosed Sorry..."
msgstr "@niko_eyeclosed Pardon..."

msgid "@silver [Hey, you okay in there?]"
msgstr "@silver [Hé, tout va bien par ici ?]"

msgid "@silver_eyeclosed [I did what I could with the terminals for now, and...]"
msgstr "@silver_eyeclosed [J'ai fait ce que j'ai pu avec les terminaux, et...]"

msgid "@silver2 [...It's you...]"
msgstr "@silver2 [... C'est vous...]"

msgid "@silver2 [...you're the robot that insisted on living in the mines, are you not?]"
msgstr "@silver2 [... Vous êtes le robot qui a insisté pour vivre dans les mines, n'est-ce pas ?]"

msgid "@silver_eyeclosed [My friend told me to keep an eye out for you, should we ever cross paths.]"
msgstr "@silver_eyeclosed [On m'a dit de garder un œil sur vous, au cas où nous étions amenés à nous rencontrer.]"

msgid "@proto1b [...Likewise.]"
msgstr "@proto1b [... C'est aussi ce qu'on m'a dit.]"

msgid "@proto1 [...Your...\\.\\. friend gave you something the last time you saw each other.]"
msgstr "@proto1 [... Votre...\\.\\. camarade vous a donné quelque chose la dernière fois que vous vous êtes vus.]"

msgid "@proto1 [Can you show me what it is?]"
msgstr "@proto1 [Pouvez-vous me montrer ce que c'est ?]"

msgid "@silver2 [Wait...\\.\\. You know about the amber?]"
msgstr "@silver2 [Attendez...\\.\\.Vous êtes au courant pour l'ambre ?]"

msgid "@proto2b [I just asked to see it, didn't I?]"
msgstr "@proto2b [J'ai juste demandé à la voir.]"

msgid "@silver2 [Oh, actually...]"
msgstr "@silver2 [Oh, à vrai dire...]"

msgid "@niko_speak I needed it to fix a robot, so she gave it to me!"
msgstr "@niko_speak J'en avais besoin pour réparer un robot, c'est pour cela qu'elle me l'a donnée !"

msgid "@proto2 [Oh?]"
msgstr "@proto2 [Oh ?]"

msgid "@niko_speak Here! See?"
msgstr "@niko_speak Tenez ! Vous voyez ?"

msgid "@proto2b [Ah.]"
msgstr "@proto2b [Ah.]"

msgid "@silver2 [Alright... here it is.]"
msgstr "@silver2 [D'accord... la voilà.]"

msgid "@proto2b [Thought so.]"
msgstr "@proto2b [C'est bien ce que je pensais.]"

msgid "@proto2 [He seemed to trust you, so I will treat you as an ally as well.]"
msgstr "@proto2 [Il avait l'air de vous faire confiance, je vous considérerai donc aussi comme mes alliés.]"

msgid "@silver2 [...Okay?]"
msgstr "@silver2 [... D'accord ?]"

msgid "@proto1b [Please listen carefully.]"
msgstr "@proto1b [Écoutez attentivement.]"

msgid "@proto1 [You need to escort the messiah for the remainder of the Barrens.]"
msgstr "@proto1 [Vous devez escorter le messie à travers la Lande.]"

msgid "@proto2b [I predict a high concentration of square particle disruptions in the near future.]"
msgstr "@proto2b [Je vois dans un futur proche des perturbations dues à une forte concentration de particules carrées.]"

msgid "@silver2 [...No way.]"
msgstr "@silver2 [... Nooon.]"

msgid "@proto2b [Yes....\\.\\. way.]"
msgstr "@proto2b [Et....\\.\\. si.]"

msgid "@proto2 [It's likely that structures in the vicinity of the messiah might be affected.]"
msgstr "@proto2 [Il est possible que les structures à proximité du messie soient affectées.]"

msgid "@proto2 [...Making it a far more treacherous pilgrimage than the previous....\\> \\@proto2b er, expectations.]"
msgstr "@proto2 [... Ce qui en fait un pèlerinage bien plus périlleux que... \\>\\@proto2b euh, la précédente présomption.]"

msgid "@proto1 [\\p and the messiah need all the extra help they can get right now.]"
msgstr "@proto1 [\\p et le messie ont désormais besoin de toute l'aide possible.]"

msgid "@silver_eyeclosed [Understood.]"
msgstr "@silver_eyeclosed [Compris.]"

msgid "@niko2 O...\\.\\. okay..."
msgstr "@niko2 D'a...\\.\\.D'accord..."

msgid "@silver [Guess we should head back soon.]"
msgstr "@silver [Je pense qu'on devrait bientôt y retourner.]"

msgid "@silver_lookup [Even without the squares, the mines are not a safe place to be.]"
msgstr "@silver_lookup [Même sans les carrés, les mines ne sont pas un endroit sûr.]"

msgid "@silver2 [Come on, I'll wait for you outside.]"
msgstr "@silver2 [Venez, je vous attends dehors.]"

msgid "@niko3 Wait! I want to ask you-"
msgstr "@niko3 Attendez ! Je voulais vous demander..."

msgid "@niko_eyeclosed She left."
msgstr "@niko_eyeclosed Elle est partie."

msgid "@proto1b [...If you were going to ask her about being \"not real\", save your breath.]"
msgstr "@proto1b [... Si vous vouliez lui demander si elle n'est « pas réelle », eh bien, économisez votre salive.]"

msgid "@proto1b [None of the people here know their predicament.]"
msgstr "@proto1b [Personne ici ne connaît leur malheur.]"

msgid "@proto1c [In fact... I don't think they can even comprehend it.]"
msgstr "@proto1c [En fait... je crois qu'ils ne peuvent même pas comprendre.]"

msgid "@proto2 [It would be in your best interest to just... pretend like we never had this conversation.]"
msgstr "@proto2 [Il serait dans votre intérêt de... faire comme si nous n'avions jamais eu cette conversation.]"

msgid "@proto2b [Causing mass confusion in the world's residents would likely result in unfavorable conditions for you.]"
msgstr "@proto2b [Semer la confusion parmi les habitants aurait sûrement des conséquences néfastes pour vous.]"

msgid "@niko4 Alright..."
msgstr "@niko4 D'accord..."

msgid "@niko3 ...wait, then what about you?"
msgstr "@niko3 ... Mais, et vous alors ?"

msgid "@niko3 How did YOU know?"
msgstr "@niko3 COMMENT l'avez-vous su ?"

msgid "@proto2b [...\\.\\.We never had this conversation, remember?]"
msgstr "@proto2b [...\\.\\.Nous n'avons jamais discuté de cela, vous vous souvenez ?]"

msgid "@niko_eyeclosed Sigh."
msgstr "@niko_eyeclosed *Soupir*."

msgid "[MAP RECONFIGURATION SUCCESSFUL.]"
msgstr "[RECONFIGURATION DE LA CARTE RÉUSSIE.]"

msgid "@silver [He says the exit is in here, but...]"
msgstr "@silver [Il dit que la sortie est là, mais...]"

msgid "@silver_eyeclosed [...must be hidden.]"
msgstr "@silver_eyeclosed [... Elle doit être cachée.]"

msgid "@niko I don't think we need to use this anymore, \\p."
msgstr "@niko Je ne crois pas que nous ayons encore besoin de ça, \\p."

msgid "[PROPHETBOT 0 BACKUP SYSTEM 1.0]\\>\\n[PLEASE INSERT DISK]"
msgstr "[PROPHÈTEBOT 0 SYSTÈME DE SAUVEGARDE 1.0]\\>\\n[INSÉREZ LA DISQUETTE.]"

msgid "@niko Alright..."
msgstr "@niko Très bien..."

msgid "\\c[1][ERROR: BACKUP REQUEST DENIED]\\c[0]"
msgstr "\\c[1][ERREUR : DEMANDE DE SAUVEGARDE REFUSÉE]\\c[0]"

msgid "@niko_speak What?"
msgstr "@niko_speak Quoi ?"

msgid "[DORMITORY ASSIGNMENTS ARE NOT UP TO DATE.]"
msgstr "[LES TÂCHES DES DORTOIRS NE SONT PAS À JOUR.]"

msgid "[PLEASE CONFIGURE THE RESIDENTIAL TRACKING MACHINE TO CONTINUE.]"
msgstr "[VEUILLEZ CONFIGURER LA MACHINE DE PISTAGE DES HABITANTS POUR CONTINUER.]"

msgid "@niko_eyeclosed Okay then!"
msgstr "@niko_eyeclosed Bon, d'accord !"

msgid "[PREPARING BACKUP...]\\>\\n[WRITING TO DISK...]\\>\\n"
msgstr "[SAUVEGARDE EN PRÉPARATION...]\\>\\n[ÉCRITURE SUR LA DISQUETTE...]\\>\\n"

msgid "[26% COMPLETE...]"
msgstr "[PROGRESSION : 26 %...]"

msgid "[34% COMPLETE...]"
msgstr "[PROGRESSION : 34 %...]"

msgid "[40% COMPLETE...]"
msgstr "[PROGRESSION : 40 %...]"

msgid "[100% COMPLETE.]"
msgstr "[PROGRESSION : 100 %...]"

msgid "[EJECTING DISK.]"
msgstr "[ÉJECTION DE LA DISQUETTE.]"

msgid "@niko Yup, that's a computer."
msgstr "@niko Yep, c'est un ordinateur."

