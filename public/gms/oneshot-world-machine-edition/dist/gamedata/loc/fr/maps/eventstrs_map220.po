msgstr "@ling_hm Au moins, ici les gens ne mourront pas de faim..."

msgid "@ling_smile The perks of using a cafe as an emergency shelter, huh?"
msgstr "@ling_smile C'est l'avantage d'utiliser un café comme abri d'urgence, hein ?"

msgid "@ling2 Oh!"
msgstr "@ling2 Oh !"

msgid "@ling Hello, Messiah!\\n\\>\\@ling_hm And... um... \\@ling_smile Tall guy!"
msgstr "@ling Bonjour, messie !\\n\\>\\@ling_hm Et... euh... \\@ling_smile Le grand type !"

