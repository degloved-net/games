msgstr "@ling_hm Les appartements dans le secteur ouest ont été détruits par les carrés il y a un jour..."

msgid "@plight_worry2 Oh yeah, I saw..."
msgstr "@plight_worry2 Oh oui, j'ai vu..."

msgid "@ling_sigh Terrible, isn't it?"
msgstr "@ling_sigh C'est tragique, non ?"

msgid "@niko_eyeclosed Yeah..."
msgstr "@niko_eyeclosed Ouais..."

msgid "@ling_hm2 Ah, but at least the evacuees seem to be doing ok."
msgstr "@ling_hm2 Ah, mais au moins, les évacués sont sains et saufs."

msgid "@ling_hm2 We're letting them stay here for now."
msgstr "@ling_hm2 Nous leur avons permis de rester ici, pour le moment."

msgid "@plight That's nice of you."
msgstr "@plight C'est gentil de ta part."

msgid "@ling_smile Well, someone has to help!"
msgstr "@ling_smile Ben, on doit faire quelque chose !"

msgid "@ling Hello, Messiah!"
msgstr "@ling Bonjour, messie !"

msgid "@ling_hm You, um..."
msgstr "@ling_hm C'est, euh..."

msgid "@Niko A coffee machine."
