msgstr "@niko_eyeclosed Ce n'est pas vraiment le moment de parler à des pingouins, \\p..."

msgid "@niko2 Oh, it's that penguin..."
msgstr "@niko2 Oh, un pingouin..."

msgid "@niko_eyeclosed ...yep."
msgstr "@niko_eyeclosed ... Ouaip."

