msgstr "@george1_hm Eh oui... C'est à MOI que l'Auteur envoie directement ses manuscrits !"

msgid "@george1_smug I am in charge of publishing all of his books that everyone loves!"
msgstr "@george1_smug  Je suis chargée de publier tous les livres que les gens adorent !"

msgid "@niko_speak Wow!"
msgstr "@niko_speak Ouah !"

