msgstr "@george1_hm ... Mon travail si important !"

msgid "@george1_smug You see, The Author has entrusted ME with his all his ideas!"
msgstr "@george1_smug Tu vois, c'est à MOI que l'Auteur a confié toutes ses idées !"

