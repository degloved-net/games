msgid "@niko_huh Are you okay?"
msgstr "@niko_huh Tout va bien ?"

msgid "@george2_no NO!!!!!!"
msgstr "@george2_no NON !!!!!!"

msgid "@george3_sad Siiiigh..."
msgstr "@george3_sad *Soupir*..."

msgid "@george3_sigh You just had to remind me..."
msgstr "@george3_sigh Il suffisait que tu en parles..."

msgid "@niko_speak What's wrong?"
msgstr "@niko_speak Quel est le problème ?"

msgid "@george3_sad The author hasn't shown up lately, nor has he sent me any new manuscripts..."
msgstr "@george3_sad L'Auteur ne s'est pas montré récemment, et il ne m'a pas non plus envoyé de manuscrits..."

msgid "@george3_sad I'm his editor and publisher, you know..."
msgstr "@george3_sad J'édite et je publie ses livres pour lui, tu sais..."

msgid "@george3_cry What if he doesn't want me to help him anymore?"
msgstr "@george3_cry Il ne veut peut-être plus que je l'aide ?"

msgid "@george3_worry He's brilliant, he works so fast...."
msgstr "@george3_worry Il est intelligent, il travaille tellement vite..."

msgid "@george3_worry I'm so behind with publishing his books... what if he thinks I'm too slow..."
msgstr "@george3_worry Je suis en retard dans la publication de ses livres... Et s'il pense que je suis trop lente... ?"

msgid "@george3_sigh Even after he's stopped sending me things, I still can't keep up..."
msgstr "@george3_sigh Même s'il ne m'envoie plus rien, je n'arrive pas à suivre..."

msgid "@george3_sad The pile seems to just keep growing..."
msgstr "@george3_sad La pile semble s'agrandir chaque jour..."

msgid "@george4_omg Oh! These are the manuscripts The Author sent me!"
msgstr "@george4_omg Oh ! Ce sont les manuscrits que l'Auteur m'a envoyés !"

msgid "@george4 As the head librarian, it's my job to help him with the publication process."
msgstr "@george4 En tant que bibliothécaire en chef, c'est mon devoir de l'aider à les publier."

msgid "@george4_golly But ah... lately he hasn't been sending me anything."
msgstr "@george4_golly Mais ah... Récemment, il ne m'envoie plus rien."

msgid "@george4_golly This isn't like him..."
msgstr "@george4_golly Ça ne lui ressemble pas..."

msgid "@george4 I mean, I guess it does give me some extra time to work through this backlog!"
msgstr "@george4 Enfin, j'imagine que ça me laisse du temps libre pour rattraper tout mon retard !"

msgid "@george4_oops To be honest, I'm a little behind, haha!"
msgstr "@george4_oops Pour être honnête, je ne suis pas vraiment en avance, haha !"

msgid "@george4_omg That guy works really fast!"
msgstr "@george4_omg Ce type travaille tellement vite !"

msgid "@niko I see..."
msgstr "@niko Je vois..."

msgid "@george4 ...the weird part is,\\>\\nI've been publishing book after book AFTER he stopped sending me things, right?"
msgstr "@george4 ... Ce qui est étrange,\\>\\n c'est que j'ai continué à publier livre sur livre alors qu'il ne m'envoyait plus rien..."

msgid "@george4_golly But the pile of manuscripts never seems to get any smaller!"
msgstr "@george4_golly Mais la pile de manuscrits ne semble jamais diminuer !"

msgid "@george4_golly ...at all!"
msgstr "@george4_golly ... pas du tout !"

msgid "@george4_oops Golly, you think I'm going bonkers?"
msgstr "@george4_oops Mince alors, tu me prends pour une folle ?"

msgid "@george5_smile I see you've taken an interest to the manuscripts!"
msgstr "@george5_smile Je vois que tu t'intéresses aux manuscrits !"

msgid "@niko What are they for?"
msgstr "@niko Ils servent à quoi ?"

msgid "@george5_aww Well, aren't you curious, little one!"
msgstr "@george5_aww Eh bien, tu aimes fouiner, mon chou !"

msgid "@george5 The Author passed these drafts to me, you see!"
msgstr "@george5 L'Auteur m'a envoyé ces ébauches, vois-tu !"

msgid "@george5_smile Since I'm the head librarian, I am supposed to help him publish these!"
msgstr "@george5_smile Comme je suis la bibliothécaire en chef, je dois l'aider à les publier !"

msgid "@george5_hmm But... oh, I haven't seen that gentleman lately...."
msgstr "@george5_hmm Mais... Oh, je n'ai pas vu ce cher monsieur récemment..."

msgid "@george5 Which is quite strange! Usually he delivers these manuscripts to me faster than I can work on them!"
msgstr "@george5 Ce qui est très étrange ! En général, il envoie ces manuscrits plus rapidement que je ne peux les publier !"

msgid "@george5_heh I guess now it just means I get a little more breathing room, hohoho!"
msgstr "@george5_heh J'imagine qu'à présent, cela me laisse le temps de respirer, hohoho !"

msgid "@niko_speak That's good!\\> \\@niko ...right?"
msgstr "@niko_speak C'est bien !\\>\\@niko ... pas vrai ?"

msgid "@george5_hmm I don't know! I AM quite worried about him."
msgstr "@george5_hmm Je ne sais pas ! Je m'inquiète RÉELLEMENT à son sujet."

msgid "@george5_hmm I hope he hasn't fallen ill from all that stress!"
msgstr "@george5_hmm J'espère que tout ce stress ne l'a pas rendu malade !"

msgid "@george5_smile At least I got my hands full for the time being."
msgstr "@george5_smile Au moins j'ai du pain sur la planche pour l'instant."

msgid "@george5 Even though he's stopped sending me things, it doesn't feel like he did at all!"
msgstr "@george5 Même s'il a arrêté de m'envoyer des manuscrits, on ne dirait pas !"

msgid "@george5_heh The pile of manuscripts I still need to proofread doesn't seem to get smaller, haha!"
msgstr "@george5_heh La pile de manuscrits que je dois relire ne semble pas diminuer, haha !"

msgid "@niko This box is full of loose papers and notebooks."
msgstr "@niko La boîte est peine de feuilles et de cahiers en vrac."

msgid "@george6_point Yo, these are the manuscripts The Author gave me."
msgstr "@george6_point Yo, c'est les manuscrits que l'Auteur m'a refilés."

msgid "@george6_smile I'm supposed to like, help him publish and stuff."
msgstr "@george6_smile Je dois, genre, l'aider à publier et tout."

msgid "@george6 But he hasn't shown his face 'round these parts lately."
msgstr "@george6 Mais il ne s'est pas pointé dans le coin récemment."

msgid "@george6 That's like, throwin off my groove, man."
msgstr "@george6 Ça m'a pourri mon groove, mec."

msgid "@george6_shrug Like, I'm used to him sending me new stuff all the time."
msgstr "@george6_shrug J'ai genre, l'habitude qu'il m'envoie tout le temps des trucs."

msgid "@george6 I mean, of course I can't keep up with the pace that he's writin', but he don't mind."
msgstr "@george6 J'veux dire, évidemment que j'arrive pas à suivre son rythme, mais ça le dérange pas."

msgid "@george6_fingerguns Guy's just tooootally passionate 'bout his job!"
msgstr "@george6_fingerguns Le mec est cooomplètement passionné par son boulot !"

msgid "@george6_smile Makes me wanna work hard too, so I do!"
msgstr "@george6_smile Ça me motive aussi à bosser dur, et c'est c'que je fais !"

msgid "@george6 I've been playin catchup with the stuff I haven't gotten to finish yet."
msgstr "@george6 J'passe mon temps à essayer de rattraper mon retard."

msgid "@george6_point But you know what's weird?"
msgstr "@george6_point Mais tu sais c'qui est bizarre ?"

msgid "@niko What?"
msgstr "@niko Quoi ?"

msgid "@george6_shrug The stuff I'm supposed to finish don't get finished."
msgstr "@george6_shrug Impossible de terminer c'que j'dois terminer."

msgid "@george6 Like I've put out book after book but the work pile don't get any smaller."
msgstr "@george6 J'enchaîne les bouquins mais la pile ne diminue pas."

msgid "@george6_shrug ...Have I really been slackin' that much?"
msgstr "@george6_shrug ... Est-ce que j'ai vraiment autant glandé ?"

msgid "@niko It's a bookshelf."
msgstr "@niko C'est une étagère."

msgid "@niko_speak The computer screen says something about \"updated databases\"."
msgstr "@niko_speak L'écran d'ordinateur mentionne des « bases de données mises à jour »."

msgid "@george1 So!\\>\\n\\@george1_smug Someone here to see the brilliant George, eh?"
msgstr "@george1 Alors !\\>\\n\\@george1_smug Quelqu'un veut voir George la virtuose, hein ?"

msgid "@george1_smug Caught wind of my genius and couldn't help but come see for yourself, eh?"
msgstr "@george1_smug Tu as eu vent de mon génie et tu veux le constater par toi-même, hein ?"

msgid "@niko Um-"
msgstr "@niko Hum..."

msgid "@george1 ...don't answer!\\>\\n\\@george1_smug Of course you are."
msgstr "@george1 ... Ne réponds pas !\\>\\n\\@george1_smug Bien sûr que c'est ça."

msgid "@george1_smile What else could you ~possibly~ want?"
msgstr "@george1_smile Que pourrais-tu bien vouloir d'autre ?"

msgid "@niko Actually... \\@niko_speak I need your help!\\>\\n\\@niko_speak Can you tell me what I need to do?"
msgstr "@niko En fait... \\@niko_speak J'ai besoin d'aide !\\>\\n\\@niko_speak Pouvez-vous me dire ce que je dois faire ?"

msgid "@niko I think... I'm supposed to go in the Tower..."
msgstr "@niko Je crois... que je dois aller dans la Tour..."

msgid "@george1_smug Ah, but of course I can help!"
msgstr "@george1_smug Ah, mais bien sûr que je peux t'aider !"

msgid "@george1 For I... the brilliant and intelligent head librarian George, beholder of all knowledge........"
msgstr "@george1 Car moi... George, la géniale bibliothécaire en chef, détentrice du savoir absolu..."

msgid "@george1_hm ...Believe you're supposed to go in the Tower!"
msgstr "@george1_hm Je crois que tu dois aller dans la Tour !"

msgid "@niko_eyeclosed That's what I said...\\>\\n\\@niko_speak But how, exactly?"
msgstr "@niko_eyeclosed C'est ce que j'ai dit...\\>\\n\\@niko_speak Mais comment ?"

msgid "@george1 Through the Tower entrance room!"
msgstr "@george1 En passant par l'entrée de la Tour !"

msgid "@george1_hm Alas, going beyond that small entrance room requires ancient, forbidden knowledge that eludes even George."
msgstr "@george1_hm Hélas, il faut posséder un savoir ancien et interdit que même George ignore pour entrer."

msgid "@george1 ...but fear not!"
msgstr "@george1 ... Mais pas de panique !"

msgid "@george1 If that knowledge happens to be recorded in some cryptic tome in a long-dead language..."
msgstr "@george1 Si ce savoir a été consigné dans un tome mystérieux rédigé dans une langue morte depuis des siècles..."

msgid "@george1_smug Then know that I, George, am fluent in several dead languages!"
msgstr "@george1_smug Sache que moi, George, je connais plusieurs langues mortes !"

msgid "@niko I... see!"
msgstr "@niko Je... vois !"

msgid "@niko Excuse me..."
msgstr "@niko Pardon..."

msgid "@george2_stress Hey!!!"
msgstr "@george2_stress Hé !!!"

msgid "@george2_grr Who the heck do you think you are, barging in here like that?"
msgstr "@george2_grr Tu te prends pour qui, à débarquer comme ça ?"

msgid "@george2_NO I don't care if you're the Messiah, manners are still a thing!"
msgstr "@george2_NO Je me moque que tu sois le messie, n'oublie pas les bonnes manières !"

msgid "@niko I'm... \\>\\@niko_speak sorry?"
msgstr "@niko Je vous demande... \\>\\@niko_speak pardon ?"

msgid "@george2 Well? Are you just here to apologize?"
msgstr "@george2 Eh bien ? Tu es seulement là pour t'excuser ?"

msgid "@niko ...Yes? \\.\\.\\n\\@niko_speak I mean, no!"
msgstr "@niko ... Oui ? \\.\\.\\n\\@niko_speak Enfin, non !"

msgid "@niko_eyeclosed I mean, I need your help...\\>\\n\\@niko I'm not sure what I need to do next."
msgstr "@niko_eyeclosed J'ai besoin d'aide...\\>\\n\\@niko Je ne sais plus quoi faire."

msgid "@niko I think I need to go in the Tower?"
msgstr "@niko Je crois que je dois entrer dans la Tour ?"

msgid "@george2 Seriously? You haven't figured that one out yet?"
msgstr "@george2 Sérieusement ? Tu n'as pas encore réussi à résoudre ça ?"

msgid "@niko_speak I don't know how to get in!"
msgstr "@niko_speak Je ne sais pas comment y entrer !"

msgid "@george2_grr Well, I don't know either.\\n\\>\\@george2 Shouldn't \\p help you with that?"
msgstr "@george2_grr Eh bien, je ne sais pas non plus.\\n\\>\\@george2 Ce n'est pas à \\p de t'aider ?"

msgid "@george2_sigh All I know is that nobody from this world can get in there."
msgstr "@george2_sigh Tout ce que je sais, c'est qu'aucune personne de ce monde ne peut s'y rendre."

msgid "@george2_grr Not beyond that tiny entrance room, anyway."
msgstr "@george2_grr Enfin, pas plus loin que cette minuscule entrée, en tout cas."

msgid "@george2 If anything, there might be a book on how the Messiah of all people can get in."
msgstr "@george2 Il y a peut-être un livre qui décrit comment le messie peut entrer."

msgid "@george2_sigh But I don't got anything like that in MY collection."
msgstr "@george2_sigh Mais je n'ai rien de la sorte dans MA collection."

msgid "@george2_grr Would like to, though."
msgstr "@george2_grr Même si j'aimerais bien."

msgid "@george3_sad Si\\.i\\.i\\.\\.i\\.\\.igh."
msgstr "@george3_sad S\\.o\\.u\\.\\.p\\.\\.ir."

msgid "@niko Um... hi?"
msgstr "@niko Hum... bonjour ?"

msgid "@george3_sigh ...\\.Hi."
msgstr "@george3_sigh ... \\.Bonjour."

msgid "@niko_speak Are you alright?"
msgstr "@niko_speak Vous allez bien ?"

msgid "@george3_sad .\\..\\..\\.."
msgstr "@george3_sad .\\..\\..\\.."

msgid "@niko .\\..\\..\\.."
msgstr "@niko .\\..\\..\\.."

msgid "@george3_worry Can I... help you..."
msgstr "@george3_worry Puis-je... t'aider..."

msgid "@niko_speak Yeah!"
msgstr "@niko_speak Ouais !"

msgid "@niko I was wondering if you can tell me what I should do next?"
msgstr "@niko Je me demandais si vous pouviez me dire ce que je dois faire ensuite ?"

msgid "@niko I... think I'm supposed to go in the Tower."
msgstr "@niko Je crois... que je dois aller dans la Tour."

msgid "@george3_sad ...the Tower....\\>\\n\\@george3_sigh A grim obelisk... \\>\\@george3_sigh a solemn reminder of our fate."
msgstr "@george3_sad La Tour....\\>\\n\\@george3_sigh Un obélisque sinistre... \\>\\@george3_sigh Un rappel solennel de notre sort."

msgid "@george3_cry We're all gonna dieeeeeee...."
msgstr "@george3_cry Nous allons tous mouriiiiiiir..."

msgid "@niko_what Um..."
msgstr "@niko_what Hum..."

msgid "@niko_what ...so...\\> \\@niko_eyeclosed how do I... \\>\\@niko_speak get in?"
msgstr "@niko_what Donc...\\>\\@niko_eyeclosed comment puis-je... \\>\\@niko_speak entrer ?"

msgid "@george3_cry I don't know...!!!\\>\\n\\@george3_sad I've been reading and studying all my life, and yet..."
msgstr "@george3_cry Je ne sais pas... !!!\\>\\n\\@george3_sad J'ai lu et étudié toute ma vie, et pourtant..."

msgid "@george3_cry I haven't even found any books about entering the Tower!"
msgstr "@george3_cry Je n'ai jamais trouvé le moindre livre indiquant comment entrer dans la Tour !"

msgid "@george3 Oh, I know there's a small room you can go in, but...\\>\\n\\@george3_cry Everybody knows that!"
msgstr "@george3 Oh, je sais qu'on peut entrer par une petite pièce, mais...\\>\\n\\@george3_cry Tout le monde sait ça !"

msgid "@george4_smile Helloooo~!\\>\\nYou must be the savior!"
msgstr "@george4_smile Bonjoooooour !\\>\\nTu dois être le messie !"

msgid "@george4_omg I'm soooo happy I actually get to meet you! <3"
msgstr "@george4_omg J'suis troooop contente de te rencontrer ! <3"

msgid "@niko_speak It's nice to meet you too, miss!"
msgstr "@niko_speak Tout le plaisir est pour moi, mademoiselle !"

msgid "@george4 So! Are you here to check out the archives?\\>\\n\\@george4_omg I can give you a tour!"
msgstr "@george4 Bon ! Tu es là pour consulter les archives ?\\>\\n\\@george4_omg Je peux te faire une visite guidée !"

msgid "@niko Actually... \\>\\n\\@niko_speak I need your help!"
msgstr "@niko En fait... \\>\\n\\@niko_speak J'ai besoin d'aide !"

msgid "@niko_speak Can you tell me what I need to do next?\\>\\n\\@niko I think... I'm supposed to go in the Tower..."
msgstr "@niko_speak Pouvez-vous me dire ce que je dois faire ?\\>\\n\\@niko Je crois... que je dois aller dans la Tour..."

msgid "@george4 Yup!"
msgstr "@george4 Ouaip !"

msgid "@niko Do you know how I can get in?"
msgstr "@niko Vous savez comment je peux entrer ?"

msgid "@george4 Nope!"
msgstr "@george4 Non !"

msgid "@george4_golly Gosh, I don't think ANYONE's supposed to get inside the Tower!"
msgstr "@george4_golly Je crois que PERSONNE n'est censé entrer dans la Tour !"

msgid "@george4 I mean, there's a little room that you can go into...\\>\\n\\@george4_golly But there's no stairs or elevators or anything else..."
msgstr "@george4 Enfin, on peut entrer par une petite pièce...\\>\\n\\@george4_golly Mais il n'y a aucun escalier ni ascenseur..."

msgid "@george4 If you want my guess, you'll probably need \\p's help?"
msgstr "@george4 Si tu veux mon avis, \\p pourrait peut-être t'aider ?"

msgid "@george4_oops I don't know how exactly..."
msgstr "@george4_oops Je ne sais pas exactement..."

msgid "@george4 In my experience, that kind of knowledge is usually recorded in some sort of cryptic book."
msgstr "@george4 D'après mon expérience, ce genre de savoir est généralement consigné dans des livres mystérieux."

msgid "@george4_golly But I haven't read anything like that before...\\>\\n\\@george4_oops Sorry!"
msgstr "@george4_golly Mais je n'ai jamais rien lu de tel...\\>\\n\\@george4_oops Désolée !"

msgid "@niko Ah..."
msgstr "@niko Ah..."

msgid "@george5 Oh, hello there!"
msgstr "@george5 Oh, bonjour !"

msgid "@george5_smile You must be the savior!"
msgstr "@george5_smile Tu dois être le messie !"

msgid "@george5_aww And also, the cutest darn thing I have ever seen!"
msgstr "@george5_aww Et je n'ai jamais rien vu de plus mignon que toi !"

msgid "@niko U-um... \\>\\n\\@niko_speak Thank you!"
msgstr "@niko Euuh... \\>\\n\\@niko_speak Merci !"

msgid "@george5_smile Can I help you with anything, sweetie?"
msgstr "@george5_smile En quoi puis-je t'aider, mon chou ?"

msgid "@niko Mhm!\\>\\n\\@niko I want to know what I should do next!"
msgstr "@niko Mmh !\\>\\n\\@niko J'aimerais savoir ce que je dois faire !"

msgid "@niko I think I'm supposed to go in the Tower?"
msgstr "@niko Je crois que je dois aller dans la Tour ?"

msgid "@george5 Oooh that's right, the Tower!"
msgstr "@george5 Oooh c'est ça, la Tour !"

msgid "@george5_smile I know there's a small room that you can go into, but..."
msgstr "@george5_smile Je sais qu'on peut entrer par une petite pièce, mais..."

msgid "@george5_hmm ...I'm afraid nobody knows how to get in beyond that!"
msgstr "@george5_hmm personne ne sait comment aller plus loin !"

msgid "@george5_heh Not even silly ol' me, who spent her entire life reading books about the world..."
msgstr "@george5_heh Pas même moi qui passe toute ma vie à lire des livres sur le monde..."

msgid "@george5 I think you need some help from \\p, but I don't know any details!"
msgstr "@george5 À mon avis, \\p pourrait t'aider, mais je ne peux pas t'en dire plus !"

msgid "@george5_hmm I've never found any books about this before...\\>\\n\\@george5_smile You'd think there would be at least ONE book on this, but I guess that's just how it is!"
msgstr "@george5_hmm Je n'ai jamais trouvé aucun livre sur le sujet...\\>\\n\\@george5_smile On pourrait croire qu'il existe au moins UN livre là-dessus, mais je suppose que non !"

msgid "@george5_hmm Goodness, this is quite the dilemma!"
msgstr "@george5_hmm Bon sang, quel dilemme !"

msgid "@george6 Hey, lil' fella!"
msgstr "@george6 Hé, p'tit pote !"

msgid "@niko_speak Hello!"
msgstr "@niko_speak Bonjour !"

msgid "@george6_point So you're gonna like, save the world and stuff!\\>\\n\\@george6_smile Didn't think I'd run into ya. But now I did!"
msgstr "@george6_point Alors tu vas genre, sauver le monde et tout !\\>\\n\\@george6_smile Je pensais pas tomber sur toi, et pourtant !"

msgid "@george6_fingerguns Eyyyyyy."
msgstr "@george6_fingerguns Hééééé."

msgid "@niko_speak Um, thanks?"
msgstr "@niko_speak Hum, merci ?"

msgid "@george6 So like, what up?\\>\\n\\@george6_smile Can I getcha anything?"
msgstr "@george6 Alors, ça gaze ?\\>\\n\\@george6_smile J'peux t'aider ?"

msgid "@niko_speak Yeah! I heard you can help me!"
msgstr "@niko_speak Ouais ! On m'a dit que vous pourriez m'aider !"

msgid "@niko I'm not sure what I'm supposed to do now..."
msgstr "@niko Je ne sais pas trop quoi faire maintenant..."

msgid "@niko_speak I think I'm supposed to go in the Tower...\\>\\n\\@niko But how do I do that?"
msgstr "@niko_speak Je crois que je dois aller dans la Tour... \\>\\n\\@niko Mais comment ?"

msgid "@george6 Ya don't.\\>\\n\\@george6_shrug At least, WE don't."
msgstr "@george6 Tu peux pas.\\>\\n\\@george6_shrug Enfin, ON peut pas, en tout cas."

msgid "@george6 The Tower's only got one teeny room in it, it ain't even got stairs!"
msgstr "@george6 La Tour n'a qu'une seule mini pièce de rien du tout, y'a même pas d'escaliers !"

msgid "@george6_point I bet you need \\p's help on this one, pal...\\>\\n\\@george6_shrug Exactly how? I dunno."
msgstr "@george6_point À mon avis, \\p doit t'aider sur ce coup-là, poto...\\>\\n\\@george6_shrug Comment exactement ? J'sais pas."

msgid "@george6 But I bet'cha anything that sorta knowledge is in some mystery book somewhere."
msgstr "@george6 Mais j'te parierais n'importe quoi qu'tu peux trouver la réponse dans un livre mystérieux."

msgid "@george6_shrug Nothin' in my collection fits the description, tho."
msgstr "@george6_shrug Mais y'a rien dans ma collection qui correspond."

msgid "@niko A box full of notebooks."
msgstr "@niko Une boîte remplie de cahiers."

msgid "@niko A book is poking out from the shelf."
msgstr "@niko Un livre dépasse de l'étagère."

msgid "@niko_speak Ah, this looks like a sketchbook of some sort!"
msgstr "@niko_speak On dirait un genre de carnet de dessin !"

msgid "@george1 Oh, do you need George to tell you what to do again?"
msgstr "@george1 Oh, tu as encore besoin que George te dise quoi faire ?"

msgid "@niko_speak Yes please!"
msgstr "@niko_speak Oui, s'il vous plaît !"

msgid "@george1 According to the journal, you must go to the small room at the base of the Tower while having three pieces of the previous sun in your possession."
msgstr "@george1 D'après le carnet, tu dois te rendre dans la petite pièce au pied de la Tour avec les trois fragments du soleil précédent."

msgid "@george1 With those three items at hand, you must stand in the room, and \\p will do something about floor patterns and windows."
msgstr "@george1 Avec ces trois objets, tu dois te tenir debout dans la pièce et \\p s'occupera des motifs au sol et des fenêtres."

msgid "@niko Alright... thank you!"
msgstr "@niko D'accord... merci !"

msgid "@george1_smile Good luck on your journey, small child!"
msgstr "@george1_smile Bonne chance lors de cette aventure !"

msgid "@george1 George shall bid you farewell now."
msgstr "@george1 George va te dire au revoir, à présent."

msgid "@george1 I've done it!"
msgstr "@george1 Et voilà !\\>\\n"

msgid "@george1_smile I have finished the daunting task of translating this journal!"
msgstr "@george1_smile J'ai enfin fini de traduire ce carnet !"

msgid "@niko_speak Oh! That was fast!"
msgstr "@niko_speak Oh ! C'était rapide !"

msgid "@george1_smug But of course! I AM the speediest translator in recent history."
msgstr "@george1_smug Bien sûr ! Je SUIS la traductrice la plus rapide de notre ère."

msgid "@george1 Anyway, I made you a line-by-line transcript. \\>\\nIt looks like this journal might be meant for \\p."
msgstr "@george1 Bref, je t'ai compilé une traduction ligne par ligne. \\>\\nOn dirait que ce carnet était destiné à \\p."

msgid "@niko_speak Oh?"
msgstr "@niko_speak Oh ?"

msgid "@george1 Here, take a look yourself."
msgstr "@george1 Tiens, regarde."

msgid "@george1 There, that's the last of it."
msgstr "@george1 Voilà, c'est tout."

msgid "@george1 The rest of the pages are torn out.\\>\\n\\@george1_hm You didn't do this, did you?"
msgstr "@george1 Les autres pages ont été arrachées.\\>\\n\\@george1_hm Ce n'est pas toi qui a fait ça, quand même ?"

msgid "@niko_speak No!"
msgstr "@niko_speak Non !"

msgid "@george1 A shame! I was wondering what \"window\" was supposed to mean.\\>\\n\\@george1 Ah well, I guess \\p will have to figure out that one."
msgstr "@george1 Dommage ! Je me demandais ce que cette « fenêtre » voulait dire.\\>\\n\\@george1 Bref, \\p devra percer ce mystère."

msgid "@niko Right..."
msgstr "@niko D'accord..."

msgid "@niko_speak By the way, what does it mean by \"three pieces of the previous sun\"?\\>\\n\\@niko I only have this sun..."
msgstr "@niko_speak Au fait, qu'est-ce que le carnet veut dire par « trois fragments du soleil précédent » ?\\>\\n\\@niko Je n'ai que ce soleil..."

msgid "@george1_hm Aha!\\>\\nThat... \\@george1_smug is a question George can answer!"
msgstr "@george1_hm Aha !\\>\\nAlors ça... \\@george1_smug C'est une question à laquelle George peut répondre !"

msgid "@george1 It means you need items containing yellow phosphor, the rarest of the phosphors.\\>\\n\\@george1 ...said to absorb sunlight for the longest time and never fade out."
msgstr "@george1 Cela veut dire qu'il te faut des objets contenant du phosphore jaune, le plus rare de tous.\\>\\n\\@george1 ... On raconte qu'il absorbe la lumière du soleil pendant très longtemps et que celle-ci ne faiblit jamais."

msgid "@niko_speak Oh!\\>\\n\\@niko I do have a piece of amber and a feather, they're both glowing yellow..."
msgstr "@niko_speak Oh !\\>\\n\\@niko J'ai un morceau d'ambre et une plume qui brillent en jaune..."

msgid "@george1_hm But alas, you are missing the third, no?"
msgstr "@george1_hm Malheureusement, tu n'as que deux objets, pas vrai ?"

msgid "@george1 Fear not! For George, collector of rare artifacts... \\@george1_hm will assist you!\\>\\n\\@george1 Here."
msgstr "@george1 Pas de panique ! George, grande collectionneuse d'artefacts rares... \\@george1_hm va t'aider !\\>\\n\\@george1 Tiens."

msgid "@niko Oh...\\>\\n\\@niko_speak It looks... \\@niko_huh ...like you?"
msgstr "@niko Oh...\\>\\n\\@niko_speak On dirait... \\@niko_huh ... On dirait vous ?"

msgid "@george1_smile Yes!"
msgstr "@george1_smile Oui !"

msgid "@george1_smile Now you'll never forget my face! \\>\\n\\@george1 The face... \\>\\@george1_hm of knowledge."
msgstr "@george1_smile Tu n'oublieras jamais mon visage, comme ça ! \\>\\n\\@george1 Le visage... \\>\\@george1_hm de la connaissance."

msgid "@niko_speak Ah, thank you!"
msgstr "@niko_speak Ah, merci !"

msgid "@george1 Yes, even someone as great as I must put the proper thought and care into a task like this."
msgstr "@george1 Oui, même une personne aussi géniale que moi doit s'appliquer pour une tâche comme celle-ci.\\>\\n"

msgid "@niko_yawn *yawn*..."
msgstr "@niko_yawn *bâille*..."

msgid "@niko_eyeclosed Excuse me.... \\>\\n\\@niko ...again."
msgstr "@niko_eyeclosed Pardon... \\>\\n\\@niko ... encore une fois."

msgid "@george1 Go take a nap, small child! \\>\\n\\@george1_smug Take a nap and appreciate my hospitality!"
msgstr "@george1 Va faire une sieste, mon enfant ! \\>\\n\\@george1_smug Fais une sieste et profite de mon hospitalité !"

msgid "@george1 Guest room's in the attic down the hall, in case you forgot."
msgstr "@george1 Si tu as oublié, la chambre d'amis est dans le grenier, au bout du couloir."

msgid "@niko_speak Oh!"
msgstr "@niko_speak Oh !"

msgid "@niko I do have this book, though!\\>\\n\\@niko_speak I... think it's written in some sort of... words I don't recognize?"
msgstr "@niko Mais j'ai ce livre, en revanche !\\>\\n\\@niko_speak Je... pense qu'il est dans une langue... que je ne connais pas ?"

msgid "@george1 Aha!\\>\\nAn ancient book!\\>\\nWritten by no less than the most ancient... wait a minute."
msgstr "@george1 Aha !\\>\\nUn livre ancien !\\>\\nDont l'auteur n'est nul autre que le plus ancien... Attends un peu."

msgid "@george1_hm This isn't ancient at all!\\>\\n\\@george1 But it's written in a dead language nevertheless."
msgstr "@george1_hm Ce livre n'est pas du tout ancien !\\>\\n\\@george1 Mais il est quand même écrit dans une langue morte."

msgid "@george1_hm It's time... for me to unleash my brilliance!"
msgstr "@george1_hm Il est temps... temps pour moi de libérer mon intelligence !"

msgid "@george1 For George (me),\\npossessor of at least one PhD...\\>\\n\\@george1_smug shall translate this!"
msgstr "@george1 Car George (moi),\\n détentrice d'au moins un doctorat...\\>\\n\\@george1_smug vais te traduire tout ça !"

msgid "@george1 ...this will take some time, however."
msgstr "@george1 ... Enfin, ça va me prendre un moment."

