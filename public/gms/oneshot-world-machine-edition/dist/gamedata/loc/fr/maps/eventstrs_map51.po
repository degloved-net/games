msgstr "@george2_grr Quoi ? T'as jamais vu un manuscrit ?"

msgid "@george2_sigh That's what books look like before they get published, kid."
msgstr "@george2_sigh C'est à ça que ressemblent les livres avant d'être publiés."

msgid "@niko I see!"
msgstr "@niko Je vois !"

msgid "@niko Do you help him publish books?"
msgstr "@niko Vous l'aidez à publier des livres ?"

