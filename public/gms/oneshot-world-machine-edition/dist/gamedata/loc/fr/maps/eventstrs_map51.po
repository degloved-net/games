msgstr "@george6_shrug Dès que j'ai l'dos tourné, il écrit encore une énorme anthologie sur l'univers."

msgid "@george6 Gotta respect that."
msgstr "@george6 J'le respecte grave."

msgid "@niko These boxes are full of loose papers and notebooks."
msgstr "@niko Ces boîtes sont pleines de feuilles et de cahiers en vrac."

msgid "@george1 Oh! I see you are curious about my job."
msgstr "@george1 Oh ! Je vois que tu t'intéresses à mon travail."

