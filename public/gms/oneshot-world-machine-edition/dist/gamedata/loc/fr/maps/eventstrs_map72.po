msgstr "@bookbot [... PENDANT PLUSIEURS JOURS.]"

msgid "@niko_what Yikes!"
msgstr "@niko_what Mince alors !"

msgid "@niko Can you go get her in person, then?"
msgstr "@niko Mais vous pourriez aller la chercher en personne, non ?"

