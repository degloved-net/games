msgstr "@niko_eyeclosed Le grand robot a seulement dit qu'il y aurait des indices ici..."

msgid "@bookbot [THAT IS A QUESTION FOR THE HEAD LIBRARIAN, GEORGE.]"
msgstr "@bookbot [C'EST UNE QUESTION POUR GEORGE, LA BIBLIOTHÉCAIRE EN CHEF.]"

