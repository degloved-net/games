msgid "@calamus_sad At least the courtyard is unaffected for now..."
msgstr "@calamus_sad Au moins, la cour n'a pas encore été touchée..."

msgid "@niko It's a ball."
msgstr "@niko C'est une balle."

msgid "@alula That's mine!\\>\\n\\@alula_pout It doesn't bounce around as much as it used to, though..."
msgstr "@alula C'est la mienne !\\>\\n\\@alula_pout Mais elle ne rebondit pas aussi bien qu'avant..."

msgid "@alula_pout We usually get to the burial grounds through our friend, but..."
msgstr "@alula_pout Nous allons habituellement au cimetière avec notre ami, mais..."

msgid "@alula_oh ...he hasn't been here in forever!"
msgstr "@alula_oh ... on ne l'a pas vu depuis très longtemps !"

msgid "@calamus Normally this courtyard would be where we meet up..."
msgstr "@calamus On se rejoint toujours sur la cour..."

msgid "@alula I hope he comes back soon..."
msgstr "@alula J'espère qu'il reviendra bientôt..."

