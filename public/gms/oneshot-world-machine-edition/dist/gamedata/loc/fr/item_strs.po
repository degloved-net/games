msgstr "Apparemment une batterie. Le verre à l'intérieur est cassé."

msgid "13:name=empty battery"
msgstr "batterie déchargée"

msgid "13:description=An intact, rechargable battery. Currently empty."
msgstr "Batterie rechargeable intacte. Actuellement déchargée."

msgid "14:name=charged battery"
msgstr "batterie chargée"

