msgid "A quick death promises the least pain, don't you agree?"
msgstr "Mortes rápidas são menos dolorosas, não concorda?"

msgid "@niko ..."
msgstr "@niko ..."

msgid "When the world ends, would it be better if it was gone in an instant, or slowly fading away?"
msgstr "Seria melhor o mundo acabar de uma hora para outra ou desaparecer lentamente?"

msgid "To be honest, I'd rather the former."
msgstr "Sinceramente, prefiro a primeira opção."

msgid "[HELLO, PERSON.]"
msgstr "[OLÁ, PESSOA.]"

msgid "[THE LIBRARY IS UP AHEAD.]"
msgstr "[A BIBLIOTECA FICA À FRENTE.]"

msgid "@niko_speak Thanks!"
msgstr "@niko_speak Valeu!"

msgid "@niko Hey, \\p?"
msgstr "@niko Ei... \\p?"

msgid "@niko_speak Do you remember where the cafe is?"
msgstr "@niko_speak Você se lembra onde fica o café?"

msgid "[\"Yes\", \"No\"]"
msgstr "[\"Sim\",\"Não\"]"

msgid "@niko Oh, good!"
msgstr "@niko Ah, legal!"

msgid "@niko_eyeclosed Oh..."
msgstr "@niko_eyeclosed Ah..."

msgid "@niko_speak Wait! I think I remember!\\>\\n\\@niko It's up the elevator, and then we take a right and go down some stairs!"
msgstr "@niko_speak Espere! Acho que me lembro!\\>\\n\\@niko É subindo pelo elevador e pegando à direita, depois é só descer as escadas!"

