msgstr "@niko_speak Então você vai... me seguir?"

msgid "[YES.]"
msgstr "[SIM.]"

msgid "[UNTIL YOU SAFELY REACH A BUILDING OF YOUR DESTINATION.]"
msgstr "[ATÉ VOCÊ CHEGAR AO SEU DESTINO EM SEGURANÇA.]"

