msgstr "@niko_speak Vocês não podem entrar nos prédios?"

msgid "[CORRECT.]"
msgstr "[CORRETO.]"

msgid "[WE ARE BUILT FOR OUTDOOR USE ONLY.]"
msgstr "[FOMOS CONSTRUÍDOS PARA O EXTERIOR SOMENTE.]"

