msgstr "@niko Certo."

msgid "@niko Hello"
msgstr "@niko Olá"

msgid "[BOOP]"
msgstr "[BUP]"

msgid "[UNIT RT-3847201 REPORTING FOR DUTY!]"
msgstr "[UNIDADE RT-3847201 APRESENTANDO-SE PARA O TRABALHO!]"

msgid "[IT SEEMS THAT YOU ALREADY HAVE AN ASSIGNED ESCORT, UNIT RM-2883417]"
msgstr "[PARECE QUE VOCÊ JÁ TEM UM ACOMPANHANTE, A UNIDADE RM-2883417]"

msgid "[WOULD YOU LIKE ME TO LEAVE?]"
msgstr "[QUER QUE EU SAIA?]"

