msgid "@niko2 ...oh, but they scurried off..."
msgstr "@niko2 ... ah, mas correram embora..."

msgid "@niko_eyeclosed I hope they didn't think I was gonna eat them..."
msgstr "@niko_eyeclosed Espero que não tenham pensado que eu ia comê-los..."

