msgid "@niko A stapler."
msgstr "@niko Um grampeador."

msgid "@niko_speak It's bolted to the table..."
msgstr "@niko_speak Está preso à mesa..."

msgid "[I AM THE POWER ROOM MECHANIC.]"
msgstr "[SOU O MECÂNICO DA SALA DE ENERGIA.]"

msgid "[DO YOU HAVE AN ISSUE TO REPORT?]"
msgstr "[TEM ALGUM PROBLEMA A RELATAR?]"

msgid "@niko Do you know anything about an elevator code?"
msgstr "@niko Sabe alguma coisa sobre o código do elevador?"

msgid "[ELEVATOR CODE...]"
msgstr "[CÓDIGO DO ELEVADOR...]"

msgid "[COMMAND NOT RECOGNIZED]"
msgstr "[COMANDO NÃO RECONHECIDO]"

msgid "@niko_eyeclosed Well, worth a shot."
msgstr "@niko_eyeclosed Bem, valeu a tentativa."

msgid "@niko Yeah, actually..."
msgstr "@niko Sim, verdade..."

msgid "@niko_speak The surface access elevator appears to be broken!"
msgstr "@niko_speak Parece que o elevador de acesso está quebrado!"

msgid "@niko There's a button missing, and..."
msgstr "@niko Falta um botão e..."

msgid "@niko_speak Can you go take a look?"
msgstr "@niko_speak Você pode dar uma olhada?"

msgid "[...]"
msgstr "[...]"

msgid "[LEAVING THIS ROOM IS NOT IN MY PROGRAMMING.]"
msgstr "[SAIR DESTA SALA NÃO ESTÁ NA MINHA PROGRAMAÇÃO.]"

msgid "@niko_eyeclosed Ah, nevermind..."
msgstr "@niko_eyeclosed Ah, deixa para lá..."

msgid "[I AM ONLY ABLE TO FIX ISSUES IN THIS BUILDING.]"
msgstr "[SÓ POSSO CONSERTAR OS PROBLEMAS NESTE PRÉDIO.]"

msgid "[SORRY FOR THE INCONVENIENCE.]"
msgstr "[DESCULPE O INCÔMODO.]"

msgid "@niko It's okay..."
msgstr "@niko Tudo bem..."

msgid "$They are just bolted so people won't steal them."
msgstr "$Eles estão parafusados para ninguém roubar."

msgid "$Feel free to use, though!"
msgstr "$Pode usar à vontade!"

msgid "@niko Some kind of computer terminal..."
msgstr "@niko É uma espécie de terminal de computador..."

msgid "@niko A tape dispenser."
msgstr "@niko Um suporte de fita."

msgid "@niko Oh, of course! I gotta tape it together or it might fall apart."
msgstr "@niko Ah, é claro! É preciso colar isso, senão cairá em pedaços."

msgid "@niko_speak Good thinking, \\p!"
msgstr "@niko_speak Bem pensado, \\p!"

msgid "@niko Oh, I could hold it together with tape."
msgstr "@niko Ah, eu poderia colar isso com uma fita."

msgid "@niko_eyeclosed I should've done this in the first place..."
msgstr "@niko_eyeclosed Eu já deveria ter feito isso..."

msgid "@niko If I cut off a piece of tape to keep it would just lose its stickiness."
msgstr "@niko Se eu cortasse um pedaço de fita para isso, perderia a cola."

