msgstr "@maize_strain !!!!"

msgid "@maize_strain ...the islands... \\.\\.will collapse... \\>if I don't do something..."
msgstr "@maize_strain ... as ilhas... \\.\\.vão desmoronar... \\>se eu não fizer nada..."

msgid "@maize_strain ...that's why... \\.\\.the vines..."
msgstr "@maize_strain ... é por isso que... \\.\\.as trepadeiras..."

msgid "@niko2 ...\\>you're... making the vines grow..."
msgstr "@niko2 ... \\>você... está fazendo as trepadeiras crescerem..."

