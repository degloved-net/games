msgstr "@niko2 Eu...\\.\\.eh... \\>queria lhe perguntar uma coisa..."

msgid "@maize_thisisfine ...yes?"
msgstr "@maize_thisisfine ... pois não?"

msgid "@niko5 It looks like most of the bridges around the Glen are broken, and..."
msgstr "@niko5 Parece que as pontes ao redor do Vale estão quebradas e..."

msgid "@maize_stress ...that's right...\\.\\. the bridges..."
msgstr "@maize_stress ... isso mesmo...\\.\\.as pontes..."

msgid "@maize_stress You...\\.\\. need to cross them on your pilgrimage...."
msgstr "@maize_stress Você...\\.\\.precisa cruzá-las em sua peregrinação..."

msgid "@maize_thisisfine ...would you\\.\\. ...like me to fix them?"
msgstr "@maize_thisisfine ... gostaria que\\.\\.... eu as consertasse?"

msgid "@niko2 Yeah! \\>\\@niko4 Is it possible?"
msgstr "@niko2 Sim! \\>\\@niko4 É possível?"

msgid "@maize_stress ..."
msgstr "@maize_stress ..."

msgid "@maize_strain ...difficult."
