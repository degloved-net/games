msgstr "@niko4 ..."

msgid "@maize_stress They're all in danger, savior..."
msgstr "@maize_stress Estão todos correndo perigo, messias..."

msgid "@maize_strain The villagers...\\.\\. the children..."
msgstr "@maize_strain Os aldeões...\\.\\. as crianças..."

msgid "@maize_strain ...my final hours...\\> mustn't go to waste."
msgstr "@maize_strain ... minhas últimas horas... \\>não devem ser desperdiçadas."

msgid "@maize_thisisfine The people deserve to live... even if just for another day..."
msgstr "@maize_thisisfine As pessoas merecem viver... mesmo se for por mais um dia..."

