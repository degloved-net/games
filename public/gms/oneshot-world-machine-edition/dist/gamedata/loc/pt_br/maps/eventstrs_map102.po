msgstr "@ed [Foi ELE, não foi?]"

msgid "@ed [And now... now....]"
msgstr "@ed [E agora... agora...]"

msgid "@ed [Niko is upset.]"
msgstr "@ed [Niko se inquieta.]"

msgid "@ed [What even happened in that room back there?]"
msgstr "@ed [O que aconteceu naquela sala?]"

msgid "@ed [What did Niko learn?]"
msgstr "@ed [O que Niko descobriu?]"

msgid "@ed [I can feel it.]"
msgstr "@ed [Posso sentir.]"

msgid "@ed [I told you to turn back, \\p!]"
msgstr "@ed [Mandei voltar, \\p!]"

msgid "@ed [But you've chosen to trust that man instead of me.]"
msgstr "@ed [Mas você preferiu confiar naquele homem em vez de mim.]"

msgid "@ed [...No, not even that.]"
msgstr "@ed [... Não, nem foi nele.]"

msgid "@ed [Just his book.]"
msgstr "@ed [No livro dele.]"

msgid "@ed [His ghost.]"
msgstr "@ed [No fantasma dele.]"

msgid "@ed [This world is not real.]"
msgstr "@ed [Este mundo não é real.]"

msgid "@ed [The people are not real.]"
msgstr "@ed [As pessoas não são reais.]"

msgid "@ed [Niko... is....]"
msgstr "@ed [Niko... está...]"

msgid "@ed [No no no no no.]"
msgstr "@ed [Não, não, não, não.]"

msgid "@ed [Everything.]"
msgstr "@ed [Está...]"

msgid "@ed [Is.]"
msgstr "@ed [tudo...]"

msgid "@ed [  W  r  o  n  g  !  !  ]"
msgstr "@ed [ e r r a d o ! ! ]"

msgid "@niko_shock AH!!"
msgstr "@niko_shock AH!!"

msgid "@silver_worry [...The minecart!]"
msgstr "@silver_worry [... A vagoneta!]"

msgid "@silver3 [Earthquake...]"
msgstr "@silver3 [Terremoto...]"

msgid "@niko_surprised Th-\\.\\.the tunnel back out just collapsed!"
msgstr "@niko_surprised O...\\.\\. o túnel de volta desmoronou!"

msgid "@silver_worry [No!!]"
msgstr "@silver_worry [Não!]"

msgid "@niko3 What are we gonna do?!"
msgstr "@niko3 O que vamos fazer?!"

msgid "@silver_worry [I....]"
msgstr "@silver_worry [Eu....]"

msgid "@proto1 [Wait.]"
msgstr "@proto1 [Espere.]"

msgid "@proto2 [The exit just caved, didn't it.]"
msgstr "@proto2 [A saída desmoronou, não foi?]"

msgid "@proto2b [Sigh.]"
msgstr "@proto2b [Ah.]"

msgid "@proto2 [I saw this coming, but this is a bit more sudden than I anticipated.]"
msgstr "@proto2 [Sabia que aconteceria, mas foi um pouco mais cedo que previ.]"

msgid "@proto1 [Both of you. Follow me.]"
msgstr "@proto1 [Vocês dois, sigam-me.]"

msgid "@niko3 Where to?"
msgstr "@niko3 Para onde?"

msgid "@proto1 [The way out.]"
msgstr "@proto1 [Para a saída.]"

