msgstr "@cedric Só sei que não existe nenhum equipamento no meu mundo natal com capacidade para executar o código de forma independente."

msgid "@cedric So, asides from the standard hardware, it also needed to borrow the mental processing abilities of a living person."
msgstr "@cedric Por isso, além do hardware padrão, ele também precisava usar as capacidades de processamento mental de uma pessoa de carne e osso."

msgid "@cedric Father used himself for that, during the initial testing phases."
msgstr "@cedric Papai usou ele mesmo para isso durante as fases iniciais de teste."

msgid "@cedric2 Like I said, it took many iterations for him to make the experience stable enough."
msgstr "@cedric2 Como eu disse, foram necessárias várias iterações para ele tornar a experiência estável o suficiente."

msgid "@cedric_sigh2 ...but as you can see, even that's breaking down."
msgstr "@cedric_sigh2 ... mas, como pode ver, nem isso deu certo."

msgid "@niko2 Ah..."
msgstr "@niko2 Ah..."

