msgid "@niko_what If everyone in this world is code..."
msgstr "@niko_what Se todo mundo daqui é feito de código..."

msgid "@niko2 ...how can he build...\\.\\. \\@niko_what himself...?"
msgstr "@niko2 ... como ele conseguiu... \\.\\.\\@niko_what criar ele mesmo...?"

msgid "@cedric2 That's...\\.\\. um...\\>\\n\\@cedric_sigh not really what happened."
msgstr "@cedric2 É, não foi... \\.\\.ahm... \\>\\n\\@cedric_sigh bem isso o que aconteceu."

