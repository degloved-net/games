msgstr "@niko3 Ah..."

msgid "@proto2 [\\p only owns a machine that is able to generate the world from preexisting code.]"
msgstr "@proto2 [\\p só tem uma máquina capaz de gerar o mundo a partir do código preexistente.]"

msgid "@proto2b [They actually have fairly limited control of the events.]"
msgstr "@proto2b [Na verdade, nem é oferecido tanto controle sobre os acontecimentos.]"

msgid "@proto2 [The world was built by someone else altogether.]"
msgstr "@proto2 [O mundo foi construído por alguém completamente diferente.]"

msgid "@proto1c [Someone you cannot begin to fathom.]"
msgstr "@proto1c [Alguém que você nem imagina.]"

msgid "@proto2b [It was also not designed to be the futile quest that it is now, but...]"
msgstr "@proto2b [Também não foi projetado para ser a missão fútil que é agora, mas...]"

msgid "@proto_eyeclosed [...too many things went wrong.]"
msgstr "@proto_eyeclosed [... muitas coisas deram errado.]"

msgid "@proto1c [There's... a type of signal disruption that he never expected.]"
msgstr "@proto1c [Surgiram... tipos de interferência de sinal que ele nunca tinha previsto.]"

msgid "@proto1b [It's eating away at the world, slowly rendering it into an unrecognizable mess.]"
msgstr "@proto1b [Isso está devorando o mundo, transformando-o lentamente numa bagunça irreconhecível.]"

msgid "@proto2b [Even if you bring back the sun, it will not go away.]"
msgstr "@proto2b [Mesmo se você trouxer o sol de volta, isso não acabará.]"

msgid "@niko3 The square stuff, isn't it?"
msgstr "@niko3 São os quadrados, né?"

msgid "@niko_eyeclosed I remember those from before..."
msgstr "@niko_eyeclosed Eu me lembro disso, de antes..."

msgid "@proto1b [Then you know what to watch out for.]"
msgstr "@proto1b [Então já deve conhecer os perigos à frente.]"

msgid "@proto1c [...The creator knows what might be causing it, but there is nothing that he could do...]"
msgstr "@proto1c [... O criador sabe o que pode estar causando isso, mas nada podia ser feito...]"

msgid "@proto1 [...until now.]"
msgstr "@proto1 [... até agora.]"

msgid "@proto1b [You managed to find me, after all.]"
msgstr "@proto1b [Afinal, você conseguiu me encontrar.]"

msgid "@niko2 ...?"
msgstr "@niko2 ...?"

msgid "@proto2 [You being here was due to his help.]"
msgstr "@proto2 [Você está aqui por causa da ajuda dele.]"

msgid "@niko2 Oh...\\> I guess it has something to do with the journal?"
msgstr "@niko2 Ah... \\>Então isso tem alguma coisa a ver com o diário?"

msgid "@proto1b [Correct.]"
msgstr "@proto1b [Correto.]"

msgid "@proto1 [Looks like he wants to have one final attempt at fixing it.]"
msgstr "@proto1 [Parece que ele quer tentar consertá-lo uma última vez.]"

msgid "@proto2 [...and he might need to do it through you.]"
msgstr "@proto2 [... e talvez ele precise fazer isso através de você.]"

msgid "@proto1b [Niko, do you remember how to get to the Glen?]"
msgstr "@proto1b [Niko, você ainda se lembra do caminho até o Vale?]"

msgid "@proto2 [Whatever you did in your last session, you should stick with it for now.]"
msgstr "@proto2 [Seja lá o que tenha feito na última sessão, é melhor não fugir muito disso por enquanto.]"

msgid "@niko4 I..."
msgstr "@niko4 Eu..."

msgid "@niko_eyeclosed I remember a boat..."
msgstr "@niko_eyeclosed Eu me lembro de um barco..."

msgid "@niko ...more specifically, fixing a robot that drives the boat."
msgstr "@niko ... mais especificamente, eu me lembro de um robô que pilotava o barco."

msgid "@proto2 [Alright, then go do that.]"
msgstr "@proto2 [Certo, então vá fazer isso.]"

msgid "@niko3 But..."
msgstr "@niko3 Mas..."

msgid "@niko_eyeclosed The boat robot has those squares over it..."
msgstr "@niko_eyeclosed O robô do barco está coberto daqueles quadrados..."

msgid "@proto_gasp2 ...oh."
msgstr "@proto_gasp2 ... ah."

msgid "@proto2b [Then do whatever you must to find a new boat.]"
msgstr "@proto2b [Então faça o que for necessário para encontrar outro barco.]"

msgid "@proto2 [There are plenty of machine parts around the Barrens that can be repurposed.]"
msgstr "@proto2 [Nos arredores das Terras Áridas tem um monte de peças de máquinas dá para reaproveitar.]"

msgid "@niko_upset ...\\>\\n\\@niko_upset2 .........."
msgstr "@niko_upset ... \\>\\n\\@niko_upset2 .........."

msgid "@niko_eyeclosed Sigh..."
msgstr "@niko_eyeclosed Ah..."

msgid "@proto2 [You seem enthusiastic.]"
msgstr "@proto2 [Você parece feliz.]"

msgid "@proto2b [...that was sarcasm.]"
msgstr "@proto2b [... sarcasmo?]"

msgid "@niko_upset Knowing everything isn't real..."
msgstr "@niko_upset Saber que tudo não é real..."

msgid "@niko_upset2 ...really does make it feel pointless..."
msgstr "@niko_upset2 ... faz a gente se sentir inútil..."

msgid "@proto1b [But you DO want to go home, right?]"
msgstr "@proto1b [Mas você QUER ir para casa, não quer?]"

msgid "@niko3 Yeah, but..."
msgstr "@niko3 Sim, mas..."

msgid "@niko_distressed2 How will I know that this isn't just another..."
msgstr "@niko_distressed2 Como vou saber que isso não é apenas mais uma..."

msgid "@proto2b [Because this session might be the last one.]"
msgstr "@proto2b [Porque esta pode ser a última sessão.]"

msgid "@niko3 ...?"
msgstr "@niko3 ...?"

msgid "@proto1c [The creator is mobilizing things, throwing everything into this one last shot.]"
msgstr "@proto1c [O criador está mobilizando as coisas, apostando tudo nessa última tentativa.]"

msgid "@proto2b [There might not be enough internal resources left for \\p to be able to generate another session after this.]"
msgstr "@proto2b [Pode não haver recursos internos suficientes para \\p conseguir gerar outra sessão depois disso.]"

msgid "@proto1c [...Just go find a new boat for now.]"
msgstr "@proto1c [... Preocupe-se em achar outro barco, por enquanto.]"

msgid "@proto1c [...Just go fix the rowbot for now.]"
msgstr "@proto1c [... Preocupe-se em consertar o remobô, por enquanto.]"

msgid "@proto1b [But please, be careful.]"
msgstr "@proto1b [Por favor, tome cuidado.]"

msgid "@niko3 What about you?"
msgstr "@niko3 E você?"

msgid "@proto2 [I will meet you at the docks later.]"
msgstr "@proto2 [Encontrarei você nas docas mais tarde.]"

msgid "@proto2b [...Need to take care of something first.]"
msgstr "@proto2b [... Preciso cuidar de uma coisa primeiro.]"

msgid "@proto2 [...\\>\\nThis disk is blank.]"
msgstr "@proto2 [... \\>\\nEste disco está em branco.]"

msgid "@niko_83c Whoops!"
msgstr "@niko_83c Opa!"

msgid "@proto2 [Please help me restore my memory.\\>\\nBring the disk once you have the backup installed.]"
msgstr "@proto2 [Ajude-me a restaurar minha memória.]\\>\\n[Traga o disco de volta quando tiver instalado o backup.]"

msgid "@proto1b [That was a session.]"
msgstr "@proto1b [Isso foi uma sessão.]"

msgid "@proto2 [I also tried to tell you about the restriction at the end...]"
msgstr "@proto2 [Eu sempre tentei lhe contar sobre a restrição no fim...]"

msgid "@proto2b [...But you kinda started freaking out.]"
msgstr "@proto2b [... Mas você meio que pirou.]"

msgid "@niko_upset2 Sorry..."
msgstr "@niko_upset2 Sinto muito..."

msgid "@proto1 [Truth is, the session was designed to be run only once.]"
msgstr "@proto1 [A verdade é que a sessão foi projetada para ser executada apenas uma vez.]"

msgid "@proto1b [You weren't supposed to come back to this world after you are done.]"
msgstr "@proto1b [Você não deveria ter voltado para este mundo depois de acabar.]"

msgid "@proto2b [But... a lot of things that aren't supposed to happen have happened.]"
msgstr "@proto2b [Mas... muitas coisas que não deveriam ter acontecido aconteceram.]"

msgid "@proto2 [...I'm willing to wager that \\p bypassed the restriction through the progress log failsafe method.]"
msgstr "@proto2 [... Estou disposto a apostar que \\p contornou a restrição pelo método de falha de salvamento de registro de andamento.]"

msgid "@proto2b [It can restart the session, but it's an easily repeatable process.]"
msgstr "@proto2b [É possível reiniciar a sessão, mas é um processo facilmente repetível.]"

msgid "@proto2b [...Which means...]"
msgstr "@proto2b [... o que significa...]"

msgid "@proto1b [...it's entirely possible that \\p has brought you back more than once, too.]"
msgstr "@proto1b [... que também é possível que \\p tenha trazido você mais de uma vez.]"

msgid "@proto1c [You may have carried out this mission too many times to count.]"
msgstr "@proto1c [Você pode ter realizado essa missão incontáveis vezes.]"

msgid "@proto2b [...might explain why your memories felt like they were from a long time ago.]"
msgstr "@proto2b [... Isso pode explicar porque suas memórias parecem ser tão antigas.]"

msgid "@niko_upset2 ..."
msgstr "@niko_upset2 ..."

msgid "@niko_upset So...\\.\\. why can \\p... do that...."
msgstr "@niko_upset Então...\\.\\. por que \\p... pode fazer isso..."

msgid "@proto2 [Shh...]"
msgstr "@proto2 [Shh...]"

msgid "@proto2b [Trying to establish a connection here...]"
msgstr "@proto2b [Tentando estabelecer uma conexão aqui...]"

msgid "@niko_eyeclosed Sorry..."
msgstr "@niko_eyeclosed Sinto muito..."

msgid "@silver [Hey, you okay in there?]"
msgstr "@silver [Ei, você está bem aí?]"

msgid "@silver_eyeclosed [I did what I could with the terminals for now, and...]"
msgstr "@silver_eyeclosed [Fiz o que pude com os terminais agora e...]"

msgid "@silver2 [...It's you...]"
msgstr "@silver2 [... é você...]"

msgid "@silver2 [...you're the robot that insisted on living in the mines, are you not?]"
msgstr "@silver2 [... você é o robô que insistiu em morar nas minas, não é?]"

msgid "@silver_eyeclosed [My friend told me to keep an eye out for you, should we ever cross paths.]"
msgstr "@silver_eyeclosed [Minha amiga me falou para ficar de olho em você se nos encontrássemos.]"

msgid "@proto1b [...Likewise.]"
msgstr "@proto1b [... Igualmente.]"

msgid "@proto1 [...Your...\\.\\. friend gave you something the last time you saw each other.]"
msgstr "@proto1 [... Sua...\\.\\. companhia lhe deu alguma coisa da última vez que vocês se viram.]"

msgid "@proto1 [Can you show me what it is?]"
msgstr "@proto1 [Pode me mostrar o que é?]"

msgid "@silver2 [Wait...\\.\\. You know about the amber?]"
msgstr "@silver2 [Calma aí... \\.\\.Você sabe do âmbar?]"

msgid "@proto2b [I just asked to see it, didn't I?]"
msgstr "@proto2b [Acabei de pedir para vê-lo, não foi?]"

msgid "@silver2 [Oh, actually...]"
msgstr "@silver2 [Ah, na verdade...]"

msgid "@niko_speak I needed it to fix a robot, so she gave it to me!"
msgstr "@niko_speak Preciso dele para consertar um robô, aí ela me deu isto!"

msgid "@proto2 [Oh?]"
msgstr "@proto2 [Hã?]"

msgid "@niko_speak Here! See?"
msgstr "@niko_speak Aqui! Viu?"

msgid "@proto2b [Ah.]"
msgstr "@proto2b [Ah.]"

msgid "@silver2 [Alright... here it is.]"
msgstr "@silver2 [Certo... Aqui está.]"

msgid "@proto2b [Thought so.]"
msgstr "@proto2b [Foi o que pensei.]"

msgid "@proto2 [He seemed to trust you, so I will treat you as an ally as well.]"
msgstr "@proto2 [Como ele parecia confiar em nós, também vou tratá-lo como um aliado.]"

msgid "@silver2 [...Okay?]"
msgstr "@silver2 [... Certo?]"

msgid "@proto1b [Please listen carefully.]"
msgstr "@proto1b [Ouça atentamente.]"

msgid "@proto1 [You need to escort the messiah for the remainder of the Barrens.]"
msgstr "@proto1 [Você precisa escoltar o messias pelo resto das Terras Áridas.]"

msgid "@proto2b [I predict a high concentration of square particle disruptions in the near future.]"
msgstr "@proto2b [Prevejo uma concentração alta de alterações de partículas quadradas num futuro próximo.]"

msgid "@silver2 [...No way.]"
msgstr "@silver2 [... Nem pensar.]"

msgid "@proto2b [Yes....\\.\\. way.]"
msgstr "@proto2b [Sim....\\.\\. pensar.]"

msgid "@proto2 [It's likely that structures in the vicinity of the messiah might be affected.]"
msgstr "@proto2 [É provável que essas estruturas próximas ao messias sejam afetadas.]"

msgid "@proto2 [...Making it a far more treacherous pilgrimage than the previous....\\> \\@proto2b er, expectations.]"
msgstr "@proto2 [... Tornando esta jornada muito mais perigosa do que a última.... \\>\\@proto2b ahm, expectativas anteriores.]"

msgid "@proto1 [\\p and the messiah need all the extra help they can get right now.]"
msgstr "@proto1 [\\p e o messias precisam de toda a ajuda que conseguirem agora.]"

msgid "@silver_eyeclosed [Understood.]"
msgstr "@silver_eyeclosed [Entendido.]"

msgid "@niko2 O...\\.\\. okay..."
msgstr "@niko2 Tá... \\.\\.certo..."

msgid "@silver [Guess we should head back soon.]"
msgstr "@silver [Acho melhor voltarmos já, já.]"

msgid "@silver_lookup [Even without the squares, the mines are not a safe place to be.]"
msgstr "@silver_lookup [Mesmo sem os quadrados, as minas não são um lugar seguro.]"

msgid "@silver2 [Come on, I'll wait for you outside.]"
msgstr "@silver2 [Venha, esperarei você lá fora.]"

msgid "@niko3 Wait! I want to ask you-"
msgstr "@niko3 Espere! Quero lhe perguntar..."

msgid "@niko_eyeclosed She left."
msgstr "@niko_eyeclosed Ela foi embora."

msgid "@proto1b [...If you were going to ask her about being \"not real\", save your breath.]"
msgstr "@proto1b [... Se queria perguntar a ela sobre “não ser real”, nem se dê ao trabalho.]"

msgid "@proto1b [None of the people here know their predicament.]"
msgstr "@proto1b [Ninguém daqui tem consciência desse dilema.]"

msgid "@proto1c [In fact... I don't think they can even comprehend it.]"
msgstr "@proto1c [Na realidade... Acho que eles sequer conseguem compreender isso.]"

msgid "@proto2 [It would be in your best interest to just... pretend like we never had this conversation.]"
msgstr "@proto2 [Seria melhor você só... fingir que nunca conversamos isso.]"

msgid "@proto2b [Causing mass confusion in the world's residents would likely result in unfavorable conditions for you.]"
msgstr "@proto2b [Uma confusão em massa entre os habitantes do mundo certamente resultaria em condições desfavoráveis para você.]"

msgid "@niko4 Alright..."
msgstr "@niko4 Certo..."

msgid "@niko3 ...wait, then what about you?"
msgstr "@niko3 ... calma, mas e você?"

msgid "@niko3 How did YOU know?"
msgstr "@niko3 Como VOCÊ sabe?"

msgid "@proto2b [...\\.\\.We never had this conversation, remember?]"
msgstr "@proto2b [... \\.\\.Nunca tivemos essa conversa, lembra?]"

msgid "@niko_eyeclosed Sigh."
msgstr "@niko_eyeclosed Ah..."

msgid "[MAP RECONFIGURATION SUCCESSFUL.]"
msgstr "[RECONFIGURAÇÃO DE MAPA BEM-SUCEDIDA.]"

msgid "@silver [He says the exit is in here, but...]"
msgstr "@silver [Ele disse que a saída fica aqui, mas...]"

msgid "@silver_eyeclosed [...must be hidden.]"
msgstr "@silver_eyeclosed [... deve estar escondida.]"

msgid "@niko I don't think we need to use this anymore, \\p."
msgstr "@niko Acho que não precisamos mais usar isto, \\p."

msgid "[PROPHETBOT 0 BACKUP SYSTEM 1.0]\\>\\n[PLEASE INSERT DISK]"
msgstr "[SISTEMA DE BACKUP 1.0 DE PROFETOBÔ 0]\\>\\n[INSIRA UM DISCO]"

msgid "@niko Alright..."
msgstr "@niko Certo..."

msgid "\\c[1][ERROR: BACKUP REQUEST DENIED]\\c[0]"
msgstr "\\c[1][ERRO: SOLICITAÇÃO DE BACKUP NEGADA]\\c[0]"

msgid "@niko_speak What?"
msgstr "@niko_speak O quê?"

msgid "[DORMITORY ASSIGNMENTS ARE NOT UP TO DATE.]"
msgstr "[ATRIBUIÇÕES DE DORMITÓRIO FORA DE VALIDADE.]"

msgid "[PLEASE CONFIGURE THE RESIDENTIAL TRACKING MACHINE TO CONTINUE.]"
msgstr "[CONFIGURE A MÁQUINA DE RASTREAMENTO RESIDENCIAL PARA CONTINUAR.]"

msgid "@niko_eyeclosed Okay then!"
msgstr "@niko_eyeclosed Tá bom!"

msgid "[PREPARING BACKUP...]\\>\\n[WRITING TO DISK...]\\>\\n"
msgstr "[PREPARANDO BACKUP...]\\>\\n[GRAVANDO NO DISCO...]\\>\\n"

msgid "[26% COMPLETE...]"
msgstr "[26% CONCLUÍDO...]"

msgid "[34% COMPLETE...]"
msgstr "[34% CONCLUÍDO...]"

msgid "[40% COMPLETE...]"
msgstr "[40% CONCLUÍDO...]"

msgid "[100% COMPLETE.]"
msgstr "[100% CONCLUÍDO...]"

msgid "[EJECTING DISK.]"
msgstr "[EJETANDO DISCO.]"

msgid "@niko Yup, that's a computer."
msgstr "@niko É, isso é um computador."

