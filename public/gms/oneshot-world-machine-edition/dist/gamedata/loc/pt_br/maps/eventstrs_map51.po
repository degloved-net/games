msgstr "@george6_fingerguns Eiiiiiiita."

msgid "@niko_speak Um, thanks?"
msgstr "@niko_speak Hm, está bem..."

msgid "@george6 So like, what up?\\>\\n\\@george6_smile Can I getcha anything?"
msgstr "@george6 Então, e aí?\\>\\n\\@george6_smile O que posso fazer por você?"

msgid "@niko_speak Yeah! I heard you can help me!"
msgstr "@niko_speak Isso! Me disseram que você poderia me ajudar!"

msgid "@niko I'm not sure what I'm supposed to do now..."
msgstr "@niko Eu não sei o que fazer agora..."

msgid "@niko_speak I think I'm supposed to go in the Tower...\\>\\n\\@niko But how do I do that?"
msgstr "@niko_speak Acho que preciso ir para a Torre...\\>\\n\\@niko Mas como farei isso?"

