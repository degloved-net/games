msgstr "@george4 Pelo que sei, esse tipo de informação geralmente fica gravada em um livro críptico."

msgid "@george4_golly But I haven't read anything like that before...\\>\\n\\@george4_oops Sorry!"
msgstr "@george4_golly Mas eu nunca li nada do tipo...\\>\\n\\@george4_oops Desculpe-me!"

msgid "@niko Ah..."
msgstr "@niko Ah..."

msgid "@george5 Oh, hello there!"
