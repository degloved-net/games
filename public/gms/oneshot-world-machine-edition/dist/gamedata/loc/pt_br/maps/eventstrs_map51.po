msgstr "@george1 As outras páginas estão rasgadas.\\>\\n\\@george1_hm Não foi você quem fez isso, foi?"

msgid "@niko_speak No!"
msgstr "@niko_speak Não!"

msgid "@george1 A shame! I was wondering what \"window\" was supposed to mean.\\>\\n\\@george1 Ah well, I guess \\p will have to figure out that one."
msgstr "@george1 Uma pena! Fiquei curiosa para saber o que significa a tal “janela”.\\>\\n\\@george1 Ahm, bem... Acho que \\p terá que decifrar esse mistério."

msgid "@niko Right..."
msgstr "@niko Certo..."

