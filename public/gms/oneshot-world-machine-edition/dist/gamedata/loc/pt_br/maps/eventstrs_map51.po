msgid "@george5_hmm Goodness, this is quite the dilemma!"
msgstr "@george5_hmm Minha nossa, isso é um dilema!"

msgid "@george6 Hey, lil' fella!"
msgstr "@george6 Ei, criança!"

msgid "@niko_speak Hello!"
msgstr "@niko_speak Olá!"

msgid "@george6_point So you're gonna like, save the world and stuff!\\>\\n\\@george6_smile Didn't think I'd run into ya. But now I did!"
msgstr "@george6_point Então você quer... salvar o mundo e tudo mais?!\\>\\n\\@george6_smile Eu não pensei que fosse encontrar você, mas que bom que apareceu!"

