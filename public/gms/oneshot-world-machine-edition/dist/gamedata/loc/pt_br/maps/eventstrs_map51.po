msgstr "@niko_speak Ah!\\>\\n\\@niko Eu tenho um pedaço de âmbar e uma pena, ambos têm um brilho amarelo..."

msgid "@george1_hm But alas, you are missing the third, no?"
msgstr "@george1_hm Mas infelizmente lhe falta uma terceira peça, não é?"

msgid "@george1 Fear not! For George, collector of rare artifacts... \\@george1_hm will assist you!\\>\\n\\@george1 Here."
msgstr "@george1 Pois não tema! George, a colecionadora de artefatos raros \\@george1_hm pode ajudar!\\>\\n\\@george1 Tome."

msgid "@niko Oh...\\>\\n\\@niko_speak It looks... \\@niko_huh ...like you?"
msgstr "@niko Ah...\\>\\n\\@niko_speak Parece... \\@niko_huh ... com você?"

msgid "@george1_smile Yes!"
msgstr "@george1_smile Isso!"

msgid "@george1_smile Now you'll never forget my face! \\>\\n\\@george1 The face... \\>\\@george1_hm of knowledge."
msgstr "@george1_smile Agora você nunca esquecerá do meu rosto! \\>\\n\\@george1 O rosto... \\>\\@george1_hm do conhecimento."

msgid "@niko_speak Ah, thank you!"
msgstr "@niko_speak Ah, valeu!"

msgid "@george1 Yes, even someone as great as I must put the proper thought and care into a task like this."
msgstr "@george1 Sim, mesmo alguém tão grandioso quanto eu precisa refletir e dar o máximo de si em uma tarefa como esta.\\>\\n"

msgid "@niko_yawn *yawn*..."
msgstr "@niko_yawn *uaaah*..."

msgid "@niko_eyeclosed Excuse me.... \\>\\n\\@niko ...again."
msgstr "@niko_eyeclosed Com licença... \\>\\n\\@niko ... de novo."

msgid "@george1 Go take a nap, small child! \\>\\n\\@george1_smug Take a nap and appreciate my hospitality!"
msgstr "@george1 Vá tirar um cochilo, criança! \\>\\n\\@george1_smug Tire um cochilo e aproveite minha hospitalidade!"

msgid "@george1 Guest room's in the attic down the hall, in case you forgot."
msgstr "@george1 Se você não se lembra, o quarto de hóspedes fica no sótão ao fim do corredor."

msgid "@niko_speak Oh!"
msgstr "@niko_speak Ah!"

msgid "@niko I do have this book, though!\\>\\n\\@niko_speak I... think it's written in some sort of... words I don't recognize?"
msgstr "@niko Mas eu tenho esse livro!\\>\\n\\@niko_speak Eu... acho que está escrito em um... idioma que não estou reconhecendo."

msgid "@george1 Aha!\\>\\nAn ancient book!\\>\\nWritten by no less than the most ancient... wait a minute."
msgstr "@george1 A-há!\\>\\nUm livro antigo!\\>\\nEscrito pelo mais antigo... calma aí."

msgid "@george1_hm This isn't ancient at all!\\>\\n\\@george1 But it's written in a dead language nevertheless."
msgstr "@george1_hm Isso não é antigo coisa nenhuma!\\>\\n\\@george1 Mas de qualquer forma está escrito numa língua morta."

msgid "@george1_hm It's time... for me to unleash my brilliance!"
msgstr "@george1_hm Hora de... dar asas à minha geniosidade!"

msgid "@george1 For George (me),\\npossessor of at least one PhD...\\>\\n\\@george1_smug shall translate this!"
msgstr "@george1 Pois George (eu),\\ndotada de um ou mais doutorados...\\>\\n\\@george1_smug traduzirei isto!"

msgid "@george1 ...this will take some time, however."
msgstr "@george1 ... mas levará algum tempo."

msgid "@niko I see...\\>\\n\\@niko_yawn *yawn*..."
msgstr "@niko Entendo...\\>\\n\\@niko_yawn *uaaah*..."

msgid "@niko_eyeclosed Excuse me...."
msgstr "@niko_eyeclosed Com licença..."

msgid "@george1_hm Oh? What's this? \\>\\nYou are sleepy?"
msgstr "@george1_hm Hã? O que é isso? \\>\\nEstá com sono?"

msgid "@niko_eyeclosed A little...."
msgstr "@niko_eyeclosed Um pouquinho..."

msgid "@george1_smile Fear not! \\>Because I have read a book on hospitality before!"
msgstr "@george1_smile Pois não tema! \\>Já li um livro sobre hospitalidade!"

msgid "@george1_smug ...and thus, have prepared for this exact situation!"
msgstr "@george1_smug ... e, sendo assim, estou preparada para essa situação específica!"

msgid "@george1 ...Guest room's in the attic down the hall."
msgstr "@george1 ... O quarto de hóspedes fica no sótão ao final do corredor."

msgid "@niko So...."
msgstr "@niko Então..."

msgid "@george1 If you have any questions regarding books, then fear not."
msgstr "@george1 Se tiver alguma pergunta relacionada a livros, não se preocupe."

msgid "@george1_smug For I, George the head librarian, know a lot about \\c[3]books\\c[0]."
msgstr "@george1_smug Pois eu, George, a bibliotecária-chefe, tenho amplo conhecimento sobre \\c[3]livros\\c[0]."

msgid "@george2_grr What? You need me to explain again?"
msgstr "@george2_grr O quê? Precisa que eu explique de novo?"

msgid "@george2_sigh FINE."
msgstr "@george2_sigh CERTO."

msgid "@george2 The Journal says you have to go to the small room at the base of the Tower while holding three pieces of the previous sun."
msgstr "@george2 O diário diz que você precisa visitar a salinha na base da Torre portando três partes do sol anterior."

