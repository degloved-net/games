msgstr "@george1 Enfim, fiz uma transcrição literal. \\>\\nParece que o diário foi escrito para \\p."

msgid "@niko_speak Oh?"
msgstr "@niko_speak Hm?"

msgid "@george1 Here, take a look yourself."
msgstr "@george1 Tome, dê uma olhada."

msgid "@george1 There, that's the last of it."
msgstr "@george1 Pronto, isso é tudo."

