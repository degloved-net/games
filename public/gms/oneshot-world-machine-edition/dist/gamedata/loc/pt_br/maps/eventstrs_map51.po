msgstr "@george5_smile Você deve ser o messias!"

msgid "@george5_aww And also, the cutest darn thing I have ever seen!"
msgstr "@george5_aww E, também, a coisa mais lindinha que eu já vi!"

msgid "@niko U-um... \\>\\n\\@niko_speak Thank you!"
