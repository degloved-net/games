msgstr "@niko_eyeclosed ... Deixe para lá..."

msgid "@niko How about... hide and seek?"
msgstr "@niko Que tal... esconde-esconde?"

msgid "@niko_speak Well... maybe not too easy?"
msgstr "@niko_speak Bem... talvez não tão fácil?"

