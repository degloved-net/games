msgstr "[Inicializando. Modo Implacável.]"

msgid "[TARGET: LOCKED.\\| YOU HAVE EXACTLY 14 SECONDS.\\nSTART.\\| RUNNING.]"
msgstr "[ALVO: BLOQUEADO.\\| VOCÊ TEM EXATAMENTE 14 SEGUNDOS.\\nINICIAR.\\| CORRER.]"

msgid "@niko_wtf ..."
msgstr "@niko_wtf ..."

