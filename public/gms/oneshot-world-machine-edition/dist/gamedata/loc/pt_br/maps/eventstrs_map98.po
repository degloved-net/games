msgstr "[PARA GARANTIR MAIS ACESSO AOS LABORATÓRIOS...]"

msgid "[YOU MUST PASS THE SECURITY SYSTEM TEST.]"
msgstr "[É NECESSÁRIO PASSAR PELO TESTE DO SISTEMA DE SEGURANÇA.]"

msgid "@niko The... huh?"
msgstr "@niko O... hm?"

msgid "[YOU MUST CHANGE THE COLOR OF THE LIGHTS INTO A SPECIFIC CONFIGURATION.]"
msgstr "[É NECESSÁRIO ALTERAR A COR DAS LUZES PARA UMA CONFIGURAÇÃO ESPECÍFICA.]"

msgid "[ALLOW ME.]"
msgstr "[PERMITA-ME.]"

msgid "@niko_eyeclosed Locked."
msgstr "@niko_eyeclosed Trancado."

