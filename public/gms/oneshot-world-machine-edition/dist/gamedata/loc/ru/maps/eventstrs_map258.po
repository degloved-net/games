msgid "@en2 [...]"
msgstr "@en2 [...]"

msgid "@en3 [\\p...\\> you're... back.]"
msgstr "@en3 [\\p...\\> Ты... снова здесь.]"

msgid "@en_upset2 [I restored the world, I sent Niko home...]"
msgstr "@en_upset2 [Я восстановил мир, вернул Нико домой...]"

msgid "@en4 [Are you...\\.\\. \\@en3 not happy?]"
msgstr "@en4 [Тебе...\\.\\.\\@en3 этого не достаточно?]"

msgid "@en_upset2 [...]"
msgstr "@en_upset2 [...]"

msgid "@en_upset2 [Even if you wanted to see Niko again...]"
msgstr "@en_upset2 [Если тебе хотелось снова увидеть Нико...]"

msgid "@en_eyeclosed [You can't, \\p.\\> Niko's gone.]"
msgstr "@en_eyeclosed [Не получится, \\p.\\> Нико здесь нет.]"

msgid "@en_eyeclosed2 [And without Niko, there is no story for me to tell, no messiah to traverse across the land.]"
msgstr "@en_eyeclosed2 [А без Нико нет и истории, которую я мог бы рассказать, и мессии, который бы отправился в путешествие.]"

msgid "@en_eyeclosed [...No way for you to connect with the world.]"
msgstr "@en_eyeclosed [...И никакой возможности для тебя войти в контакт с этим миром.]"

msgid "@en_upset [...]"
msgstr "@en_upset [...]"

msgid "@en2 [But...\\.\\. Niko still remembers this place.]"
msgstr "@en2 [Но...\\.\\. Нико до сих пор вспоминает это место.]"

msgid "@en4 [...]"
msgstr "@en4 [...]"

msgid "@en3 [If you really want to see this world again, I could still...]"
msgstr "@en3 [Если ты так хочешь снова заглянуть в этот мир, я, конечно, могу...]"

msgid "@en_distressed2 [Oh...\\.\\. but it won't be the same.]"
msgstr "@en_distressed2 [О...\\.\\. конечно, это будет не то же самое.]"

msgid "@en_distressed2 [It'll just be a recording.\\>\\nIt'll just be me using Niko's memories.]"
msgstr "@en_distressed2 [Это будет просто запись.]\\>\\n[Для этого я воспользуюсь воспоминаниями Нико.]"

msgid "@en_eyeclosed [...Just like how I'm using Niko's reflection now...]"
msgstr "@en_eyeclosed [Как сейчас использую его отражение...]"

msgid "@en3 [Is that...\\.\\. what you want?]"
msgstr "@en3 [Ты...\\.\\. хочешь этого?]"

msgid "[\"Yes\", \"No\"]"
msgstr "[\"Да.\",\"Нет.\"]"

msgid "@en_eyeclosed [Alright.]"
msgstr "@en_eyeclosed [Ладно.]"

msgid "@en3 [I will go rewind the story.]"
msgstr "@en3 [Тогда я перемотаю историю на начало.]"

msgid "@en4 [...so that you can relive it from the beginning.]"
msgstr "@en4 [И ты сможешь пройти её заново.]"

msgid "@en_eyeclosed [I see.]"
msgstr "@en_eyeclosed [Понимаю.]"

msgid "@en4 [If you change your mind, though... feel free to come back.]"
msgstr "@en4 [Если передумаешь... возвращайся.]"

msgid "@en_eyeclosed [It's not like I'm going anywhere.]"
msgstr "@en_eyeclosed [Я никуда не тороплюсь.]"

