msgid "[HELLO, ORGANIC PERSON WHO IS ALIVE.]"
msgstr "[ПРИВЕТСТВУЮ, ОРГАНИЧЕСКОЕ ЖИВОЕ СУЩЕСТВО.]"

msgid "[THE INFIRMARY IS UP AHEAD.]"
msgstr "[МЕДПУНКТ ПРЯМО, ЧУТЬ ДАЛЬШЕ.]"

msgid "INFIRMARY"
msgstr "МЕДПУНКТ"

msgid "[HELLO. DO YOU NEED ANY HELP?]"
msgstr "[ЗДРАВСТВУЙТЕ. ВАМ НУЖНА ПОМОЩЬ?]"

msgid "@niko_speak I'm good, thanks!"
msgstr "@niko_speak Всё хорошо, спасибо!"

msgid "[UNIT RM-2883417 REPORTING FOR DUTY!]"
msgstr "[РОБОТ RM-2883417 ЗАСТУПАЕТ НА ДЕЖУРСТВО!]"

msgid "[I SAW THAT YOU SPOKE WITH THE GUARDIAN OF THE SETTLEMENT.]"
msgstr "[Я ВИДЕЛ, ЧТО ВЫ ГОВОРИЛИ СО СТРАЖНИКОМ В ПОСЕЛЕНИИ.]"

msgid "[I WILL NOW ESCORT YOU UNTIL YOU REACH YOUR DORMITORY.]"
msgstr "[ТЕПЕРЬ Я БУДУ ВАС СОПРОВОЖДАТЬ, ПОКА ВЫ НЕ ДОСТИГНЕТЕ ВАШЕГО ОБЩЕЖИТИЯ.]"

msgid "@niko um... what?"
msgstr "@niko Э-э... Что?"

msgid "@niko_speak So you're just gonna... follow me?"
msgstr "@niko_speak То есть вы просто будете за мной... ходить?"

msgid "[YES.]"
msgstr "[ДА.]"

msgid "[UNTIL YOU SAFELY REACH A BUILDING OF YOUR DESTINATION.]"
msgstr "[ПОКА ВЫ НЕ ДОСТИГНЕТЕ ЗДАНИЯ, В КОТОРОЕ НАПРАВЛЯЕТЕСЬ.]"

msgid "@niko Alright."
msgstr "@niko Ладно."

msgid "@niko Hello"
msgstr "@niko Привет."

msgid "[BOOP]"
msgstr "[БУП]"

msgid "[UNIT RT-3847201 REPORTING FOR DUTY!]"
msgstr "[РОБОТ RT-3847201 ЗАСТУПАЕТ НА ДЕЖУРСТВО!]"

msgid "[IT SEEMS THAT YOU ALREADY HAVE AN ASSIGNED ESCORT, UNIT RM-2883417]"
msgstr "[ВИЖУ, У ВАС УЖЕ ЕСТЬ СОПРОВОЖДАЮЩИЙ, РОБОТ RM-2883417.]"

msgid "[WOULD YOU LIKE ME TO LEAVE?]"
msgstr "[ВЫ ХОТИТЕ, ЧТОБЫ Я УШЁЛ?]"

msgid "@niko You can follow me if you want..."
msgstr "@niko Можете ходить за мной, если хотите..."

msgid "[UNDERSTOOD.]"
msgstr "[ПРИНЯТО.]"

msgid "@niko_speak Are you guys not supposed to go in buildings?"
msgstr "@niko_speak Вы не будете заходить в здания?"

msgid "[CORRECT.]"
msgstr "[ВЕРНО.]"

msgid "[WE ARE BUILT FOR OUTDOOR USE ONLY.]"
msgstr "[МЫ РАЗРАБОТАНЫ ДЛЯ ИСПОЛЬЗОВАНИЯ ВНЕ ПОМЕЩЕНИЙ.]"

msgid "[ENTERING BUILDINGS IS NOT PART OF OUR PROGRAMMING.]"
msgstr "[НАША ПРОГРАММА НЕ ПОЗВОЛЯЕТ НАМ ЗАХОДИТЬ ВНУТРЬ.]"

msgid "@niko That's... strange."
msgstr "@niko Как странно..."

msgid "[BEEP]"
msgstr "[БИП]"

msgid "@blue_gatekeeper [Oh, Hello.]"
msgstr "@blue_gatekeeper [О, Здравствуйте.]"

msgid "@blue_gatekeeper [What Are You Doing Here?]"
msgstr "@blue_gatekeeper [Что Вы Тут делаете?]"

msgid "@niko Hm?"
msgstr "@niko М-м?"

msgid "@blue_gatekeeper [A Living Person Such As Yourself Should Have Evacuated This Place Long Ago.]"
msgstr "@blue_gatekeeper [Живые Существа Вроде Вас Должны Были Давно Эвакуироваться.]"

msgid "@niko_speak Oh, but I just got here! \\>\\n\\@niko To this world, I mean!"
msgstr "@niko_speak Но я только-только сюда попал! \\>\\n\\@niko Ну, в этот мир!"

msgid "@niko_speak See?\\.\\. I have the sun!"
msgstr "@niko_speak Видишь?\\.\\. У меня есть солнце!"

msgid "@blue_gatekeeper [Oh, The Messiah.]"
msgstr "@blue_gatekeeper [А, Мессия.]"

msgid "@blue_gatekeeper [I...\\. Do Not Know What To Say.]"
msgstr "@blue_gatekeeper [Я...\\. Не Знаю, Что Сказать.]"

msgid "@blue_gatekeeper [Greeting You Was Not Part Of My Programming.]"
msgstr "@blue_gatekeeper [В Моей Программе Не Была Заложена Встреча С Вами.]"

msgid "@blue_gatekeeper [Have You\\.\\. Spoken To Prophetbot?]"
msgstr "@blue_gatekeeper [Вы Уже\\.\\. Говорили С Роботом-Пророком?]"

msgid "@niko_speak I think so, yeah!"
msgstr "@niko_speak Думаю, да!"

msgid "@blue_gatekeeper [Prophetbot Was Built With The Sole Purpose Of Greeting You.]"
msgstr "@blue_gatekeeper [Робот-Пророк Был Создан С Единственной Целью — Встретить И Поприветствовать Вас.]"

msgid "@niko Really?"
msgstr "@niko Правда?"

msgid "@blue_gatekeeper [Yes. He Cannot Speak With Anyone Else.] \\>\\n[At Least, Not With Ease.]"
msgstr "@blue_gatekeeper [Да. Он Больше Ни С Кем Не Может Говорить.] \\>\\n[По Крайней Мере, Это Даётся Ему Нелегко.]"

msgid "@niko Oh...\\n\\>\\@niko_eyeclosed that's...\\.\\. kind of sad..."
msgstr "@niko О...\\n\\>\\@niko_eyeclosed Это...\\.\\. довольно грустно..."

msgid "@niko_speak What are you built for, then?"
msgstr "@niko_speak А для чего тогда тебя сделали?"

msgid "@blue_gatekeeper [My Purpose Is To Guard This Settlement.]"
msgstr "@blue_gatekeeper [Моя Задача — Охранять Это Поселение.]"

msgid "@blue_gatekeeper [Even Though The Residents Have Long Gone, I Must Remain.]"
msgstr "@blue_gatekeeper [Пусть Даже Жители Давно Уехали, Я Должен Оставаться Здесь.]"

msgid "@niko Ah..."
msgstr "@niko А..."

msgid "@niko_speak Why, though?"
msgstr "@niko_speak Но почему?"

msgid "@blue_gatekeeper [I Have Not Been Tamed.]"
msgstr "@blue_gatekeeper [Я Не Был Приручён.]"

msgid "@niko_speak Tamed?"
msgstr "@niko_speak Приручены?"

msgid "@blue_gatekeeper [It Was Not Worth The Effort.]"
msgstr "@blue_gatekeeper [Это Того Не Стоило.]"

msgid "@niko ..."
msgstr "@niko ..."

msgid "@blue_gatekeeper [Stay Safe.]"
msgstr "@blue_gatekeeper [Берегите Себя.]"

msgid "@blue_gatekeeper [By The Way, Some Robots May Start Following You Around This Settlement As Well.]"
msgstr "@blue_gatekeeper [Кстати, Некоторые Роботы Могут Начать Следовать За Вами По Поселению.]"

msgid "@blue_gatekeeper [Do Not Be Alarmed.]\\n\\>[It Is Their Job To Keep People Safe.]"
msgstr "@blue_gatekeeper [Не Тревожьтесь.]\\n\\>[Обеспечение Безопасности Людей — Их Задача.]"

