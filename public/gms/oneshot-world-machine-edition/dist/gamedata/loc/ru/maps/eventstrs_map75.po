msgid "[ALL OF THESE TERMINALS DO NOT BOOT.]"
msgstr "[ВСЕ ЭТИ ТЕРМИНАЛЫ НЕ ЗАПУСКАЮТСЯ.]"

msgid "[I AM NOT SURE WHAT TO DO NOW.]"
msgstr "[Я НЕ ЗНАЮ, ЧТО ТЕПЕРЬ ДЕЛАТЬ.]"

msgid "@niko Some of the ink on this page is faded."
msgstr "@niko В некоторых местах чернила совсем выцвели."

msgid "$-likely due some sort of electrical or magnetic interference."
msgstr "$...скорее всего, из-за каких-то электрических или магнитных помех."

msgid "$I'm afraid this operation can no longer be sustained, if the servers continue to fail so much that maintenance cannot keep up the pace."
msgstr "$Боюсь, что эта операция больше не может поддерживаться, если серверы продолжат ломаться так часто, что служба техподдержки не будет справляться с их ремонтом."

msgid "$Fortunately, it does not seem to be happening to the robots."
msgstr "$К счастью, похоже, с роботами этого не происходит."

msgid "$At least, not at a significant rate."
msgstr "$По крайней мере, не в таком количестве."

msgid "$Time will tell."
msgstr "$Время покажет."

msgid "@niko I'm pretty sure these are computers, now..."
msgstr "@niko Теперь я уверен, что это компьютеры..."

msgid "[CHECKING... CHECKING...]"
msgstr "[ПРОВЕРКА... ПРОВЕРКА...]"

msgid "[TERMINAL DOES NOT RESPOND.]"
msgstr "[ТЕРМИНАЛ НЕ ОТВЕЧАЕТ.]"

msgid "[THIS IS A PROBLEM.]"
msgstr "[ОБНАРУЖЕНА ПРОБЛЕМА.]"

