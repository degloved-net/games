msgid "@niko The fireflies light up this room."
msgstr "@niko Эту комнату освещают светлячки."

msgid "Can you see \\p, too?"
msgstr "Тут \\p. Ты тоже видишь божество?"

msgid "@niko_speak Nope! \\@niko I can only hear their voice in my head."
msgstr "@niko_speak Нет! \\@niko Я только слышу голос в голове."

msgid "@alula_gasp That's still really cool!"
msgstr "@alula_gasp Это всё равно очень круто!"

msgid "Daddy says the world is very sick.\\nBut \\p can make it better again!"
msgstr "Папа говорит, что этот мир очень болен.\\nНо \\p может сделать его лучше!"

msgid "...Are you \\p?"
msgstr "Ты \\p?"

msgid "@niko Uh... not really.\\nI'm just the \"messiah\" they sent."
msgstr "@niko Э... не совсем.\\nЯ просто мессия, посланный в ваш мир."

msgid "@niko_speak I can talk with \\p, though!"
msgstr "@niko_speak Но \\p может со мной говорить!"

msgid "Wow!"
msgstr "Ух ты!"

msgid "@alula_gasp Double wow!"
msgstr "@alula_gasp Два раза ух ты!"

msgid "What's that like?"
msgstr "На что это похоже?"

msgid "@niko_speak Really cool!"
msgstr "@niko_speak Очень круто!"

msgid "@niko Fish heads and tails."
msgstr "@niko Рыбные головы и хвосты."

