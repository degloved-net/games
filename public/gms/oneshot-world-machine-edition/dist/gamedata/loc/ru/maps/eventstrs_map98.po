msgid "[YOU MUST PASS THE SECURITY SYSTEM TEST.]"
msgstr "[ВЫ ДОЛЖНЫ ПРОЙТИ ПРОВЕРКУ СИСТЕМЫ БЕЗОПАСНОСТИ.]"

msgid "@niko The... huh?"
msgstr "@niko Чего?"

msgid "[YOU MUST CHANGE THE COLOR OF THE LIGHTS INTO A SPECIFIC CONFIGURATION.]"
msgstr "[ВЫ ДОЛЖНЫ ИЗМЕНИТЬ ЦВЕТ ОГНЕЙ В ОСОБОЙ ПОСЛЕДОВАТЕЛЬНОСТИ.]"

msgid "[ALLOW ME.]"
msgstr "[ПОЗВОЛЬТЕ...]"

msgid "@niko_eyeclosed Locked."
msgstr "@niko_eyeclosed Закрыто."

