msgid "[\\v[31] LIGHTS CORRECT.]"
msgstr "[\\v[31] ЦВЕТА ВЕРНЫ.]"

msgid "\\c[2][ACCESS GRANTED!]\\c[0]"
msgstr "\\c[2][ДОСТУП РАЗРЕШЁН!]\\c[0]"

msgid "\\c[1][ACCESS DENIED. \\v[37] TRIES LEFT.]\\c[0]"
msgstr "\\c[1][ДОСТУП ЗАПРЕЩЁН. \\v[37] ОСТАЛОСЬ ПОПЫТОК.]\\c[0]"

msgid "\\c[1][INTRUDER DETECTED. RESETTING LOCK MECHANISM.]\\c[0]"
msgstr "\\c[1][ОБНАРУЖЕН НАРУШИТЕЛЬ. СБРАСЫВАЮ ЗАМОК МЕХАНИЗМА.]\\c[0]"

msgid "@niko_eyeclosed Sigh... Time to start over..."
msgstr "@niko_eyeclosed Эх... Придётся всё начать заново..."

msgid "[HALT!]"
msgstr "[СТОП!]"

msgid "[PLEASE AWAIT FURTHER INSTRUCTION ON THE SECURITY TEST.]"
msgstr "[ДОЖДИТЕСЬ ПОДРОБНЫХ ИНСТРУКЦИЙ КАСАТЕЛЬНО ПРОВЕКРИ СИСТЕМЫ БЕЗОПАСНОСТИ.]"

