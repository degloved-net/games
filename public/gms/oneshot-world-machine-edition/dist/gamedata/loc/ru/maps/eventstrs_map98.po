msgstr "@niko Мы открыли замок!"

msgid "[THE SECURITY SYSTEM HAS BEEN TEMPORARILY DEACTIVATED.]"
msgstr "[СИСТЕМА БЕЗОПАСНОСТИ ВРЕМЕННО ОТКЛЮЧЕНА.]"

msgid "[WOULD YOU LIKE TO RESET IT?]"
msgstr "[ХОТИТЕ ЕЁ ПЕРЕЗАГРУЗИТЬ?]"

msgid "@niko_eyeclosed ...I don't think I want to go through THAT again..."
msgstr "@niko_eyeclosed ...Мне не очень-то хочется снова через ТАКОЕ проходить..."

msgid "@niko_what um..."
msgstr "@niko_what Хм..."

msgid "@niko How do I... solve this..."
msgstr "@niko Как мне... это решить..."

msgid "[THAT IS PART OF THE TEST.]"
msgstr "[ЭТО ЧАСТЬ ТЕСТА.]"

msgid "@niko_eyeclosed Bummer."
msgstr "@niko_eyeclosed Вот блин."

msgid "[IN ORDER TO GAIN FURTHER ACCESS TO THE LABS.]"
