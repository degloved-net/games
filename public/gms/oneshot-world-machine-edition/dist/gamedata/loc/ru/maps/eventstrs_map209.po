msgid "@niko_speak It's a fish stew!"
msgstr "@niko_speak Это рыбное рагу!"

msgid "@niko A fishing pole."
msgstr "@niko Удочка."

msgid "@alula_gasp My brother knows how to fish too!"
msgstr "@alula_gasp Ещё мой брат умеет рыбачить!"

msgid "@alula But I don't!"
msgstr "@alula А я нет!"

msgid "@niko Same!"
msgstr "@niko Я тоже!"

msgid "@niko An empty jar."
msgstr "@niko Пустая банка."

msgid "@niko A jar of worms."
msgstr "@niko Банка с червями."

msgid "@niko_eyeclosed Gross!"
msgstr "@niko_eyeclosed Кошмар!"

msgid "Oh, hello, messiah."
msgstr "О, привет, мессия!"

msgid "Would you like some stew?"
msgstr "Не хочешь немного рагу?"

msgid "I made enough to feed a whole village!"
msgstr "Я приготовила достаточно, чтобы накормить всю деревню!"

msgid "...literally!"
msgstr "В буквальном смысле слова!"

msgid "@niko_speak It's ok, thanks!"
msgstr "@niko_speak Нет, спасибо!"

msgid "Looks like the Glen is deteriorating faster than ever, now..."
msgstr "Кажется, Долина начала разрушаться ещё быстрее..."

msgid "@niko These are filled with small, dried fish."
msgstr "@niko Они наполнены маленькой сухой рыбёшкой."

msgid "@niko6 At least... I think it's fish!"
msgstr "@niko6 Во всяком случае, я думаю, это рыба!"

msgid "@niko_eyeclosed They look kinda like snakes..."
msgstr "@niko_eyeclosed Они очень похожи на змей..."

