msgstr "@george4_omg Я в предвкушении-и-и-и..."

msgid "@george4_smile His books are in high demand, y'know?"
msgstr "@george4_smile Ты знал, что его книги пользуются огромным спросом?"

msgid "@george4 We literally have people lining up to read them!"
msgstr "@george4 Люди буквально выстраиваются в очередь, чтобы их почитать!"

