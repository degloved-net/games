msgstr "@plight_worry Откуда ты знаешь?"

msgid "@niko_83c ..."
msgstr "@niko_83c ..."

msgid "@niko_speak \\p and I will help you fix it!"
msgstr "@niko_speak \\p и я поможем тебе её починить!"

