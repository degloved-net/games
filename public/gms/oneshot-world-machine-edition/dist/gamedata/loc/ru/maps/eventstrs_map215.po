msgstr "@niko_eyeclosed Похоже, \\p и я должны найти другой путь вниз..."

msgid "@plight_worry But...\\.\\. this is the only elevator in the area..."
msgstr "@plight_worry Но...\\.\\. это единственный лифт в этом районе..."

msgid "@niko We did hear about another one, but... I don't really know where it is."
msgstr "@niko Говорят, есть ещё один, но... я без понятия, где он."

msgid "@niko_speak Do you, \\p?"
msgstr "@niko_speak А ты, \\p?"

msgid "TO: CAFE"
msgstr "К: КАФЕ"

msgid "[NO TRESPASSING!]"
msgstr "[ПРОХОД ЗАПРЕЩЁН!]"

