msgstr "@niko Это лифт."

msgid "@niko_speak Let's find another way down!"
msgstr "@niko_speak Давай найдём другой путь вниз."

msgid "@plight_worry Uh..."
msgstr "@plight_worry Э-э..."

msgid "@plight3 Let me know if you need my help with anything..."
msgstr "@plight3 Дай знать, если понадобится моя помощь."

msgid "@niko_speak We found some elevators!"
msgstr "@niko_speak Мы нашли пару лифтов!"

msgid "@plight_shock What??"
msgstr "@plight_shock Что?!"

msgid "@plight_worry ...seriously?"
msgstr "@plight_worry Серьёзно?"

msgid "@plight_worry2 I've literally never seen another one in this area!"
msgstr "@plight_worry2 Я вообще больше не видел лифтов в этом районе!"

msgid "@niko It WAS in a locked room..."
msgstr "@niko Они в закрытой комнате."

msgid "@plight_worry Oh...."
msgstr "@plight_worry Ого..."

msgid "@plight_worry2 Do they... uh... \\.\\.\\.\\@plight_worry work?"
msgstr "@plight_worry2 И они... Эм... \\.\\.\\.\\@plight_worry работают?"

msgid "@niko_eyeclosed We don't know yet..."
msgstr "@niko_eyeclosed Мы пока не знаем."

msgid "@niko One of them has a lever that's out of my reach."
msgstr "@niko На одном из них рычаг, до которого я не могу дотянуться."

msgid "@niko_speak ...wait! You can help us!"
msgstr "@niko_speak Ой! Ты же можешь нам помочь!"

msgid "@plight_worry What..."
msgstr "@plight_worry Как?.."

msgid "@niko You should be able to reach the lever, cuz...\\>\\n\\@niko_speak You're taller than me!"
msgstr "@niko Ты сможешь дотянуться до рычага, потому что...\\>\\n\\@niko_speak Потому что ты ведь выше меня!"

msgid "@plight3 Ooh... \\@plight_worry I... guess I am?"
msgstr "@plight3 Хм-м... \\@plight_worry Думаю, ты прав."

msgid "@plight So...\\.\\. show me the way, I suppose..."
msgstr "@plight Тогда веди...\\.\\. Покажи, где это находится..."

msgid "@niko Mhm!"
msgstr "@niko Угу!"

msgid "[HELLO.]"
msgstr "[ПРИВЕТСТВУЮ.]"

msgid "[THIS AREA IS UNAUTHORIZED FOR DEMO.]"
msgstr "[ДОСТУП В ЭТУ ЗОНУ ЗАПРЕЩЁН ДЛЯ ДЕМО.]"

msgid "[SORRY ABOUT THE INCONVENIENCE.]"
msgstr "[ПРОШУ ПРОЩЕНИЯ ЗА ДОСТАВЛЕННЫЕ НЕУДОБСТВА.]"

msgid "@niko ...Demo?"
msgstr "@niko Демо?.."

msgid "[I CANNOT LET YOU THROUGH.]"
msgstr "[Я НЕ МОГУ ВАС ПРОПУСТИТЬ.]"

