msgid "@niko A couple of fireflies are buzzing about in this jar."
msgstr "@niko В этой банке мечется несколько светлячков."

msgid "[I AM THE GENERATOR MAINTENANCE UNIT.]"
msgstr "[Я — ЮНИТ, ОБСЛУЖИВАЮЩИЙ ГЕНЕРАТОР.]"

msgid "[EVERYTHING IS FINE HERE.]"
msgstr "[ЗДЕСЬ ВСЁ ХОРОШО.]"

msgid "[HELLO, PERSON.]"
msgstr "[ПРИВЕТ, ЧЕЛОВЕК.]"

msgid "[THIS IS THE MAIN GENERATOR OF THE GLEN.]"
msgstr "[ЭТО ГЛАВНЫЙ ГЕНЕРАТОР ДОЛИНЫ.]"

msgid "@niko_speak Oooh!"
msgstr "@niko_speak О-о-о!"

msgid "@niko \\p and I actually fixed one of these earlier, in that place across the ocean..."
msgstr "@niko \\p и я недавно починили один такой. В том месте через океан..."

msgid "[THIS GENERATOR DOES NOT NEED TO BE FIXED RIGHT NOW.]"
msgstr "[ЭТОТ ГЕНЕРАТОР СЕЙЧАС НЕ НУЖДАЕТСЯ В РЕМОНТЕ.]"

msgid "@niko Right... You guys already have power and all..."
msgstr "@niko Точно... У вас, ребят, есть энергия и всё такое..."

msgid "@niko A generator."
msgstr "@niko Генератор."

msgid "@niko_speak This one's got a working battery!"
msgstr "@niko_speak В нём есть работающая батарея!"

msgid "@niko_speak I don't wanna get shocked again, \\p!"
msgstr "@niko_speak \\p, я не хочу, чтобы меня снова било током!"

msgid "@niko_what Ow!"
msgstr "@niko_what Ой!"

msgid "@niko_eyeclosed I just got shocked..."
msgstr "@niko_eyeclosed Меня только что дёрнуло током..."

