msgstr "@plight Только посмотри на него..."

msgid "@niko I-It looks like an elevator..."
msgstr "@niko Он... выглядит как обычный лифт..."

msgid "@plight_2 Well, you're not wrong, but..."
msgstr "@plight_2 Что ж, в этом ты прав, но..."

msgid "@plight_why Go look at the button panel."
msgstr "@plight_why Поди посмотри на кнопки."

msgid "@plight_2 I am not the button panel."
msgstr "@plight_2 Я не лифтовая панель."

msgid "@plight_shock Whoa! How did you make this?"
msgstr "@plight_shock Вот это да! Как ты её сделал?"

msgid "@niko_speak Out of a coffee can!"
msgstr "@niko_speak Из кофейной банки!"

