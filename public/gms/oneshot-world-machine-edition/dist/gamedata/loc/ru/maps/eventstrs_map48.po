msgstr "@plight_2 Да-а-а... Я боялся, что ты это скажешь..."

msgid "@plight Right now, this elevator is the only way to access the surface. But..."
msgstr "@plight Сейчас единственный способ добраться вниз — этот лифт. Но..."

