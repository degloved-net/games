msgid "@plight_unknown Come ooonnnnnnnnnnnnnnnnnnnnnnnnnnnn!!!!!"
msgstr "@plight_unknown Ну дава-а-а-ай!"

msgid "@plight_unknown Work already!!!"
msgstr "@plight_unknown Работай уже!"

msgid "@niko_speak Huh?"
msgstr "@niko_speak Что?"

msgid "@niko What was that?"
msgstr "@niko Что это было?"

msgid "@plight_unknown WHY. ISN'T. THIS. WORKING??!?"
msgstr "@plight_unknown ПОЧЕМУ. ОН. НЕ. РАБОТАЕТ?!"

msgid "@niko_speak ...I..."
msgstr "@niko_speak Я..."

