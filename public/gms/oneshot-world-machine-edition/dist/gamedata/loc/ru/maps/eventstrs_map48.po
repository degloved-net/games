msgstr "@plight_shock Не знаю, как тебе это удалось, но сработало!"

msgid "@plight_worry ..."
msgstr "@plight_worry ..."

msgid "@plight Good job, kid."
msgstr "@plight Отличная работа, парень."

msgid "@plight You're a genius, you know that?"
msgstr "@plight Ты просто гений, ты знал об этом?"

msgid "@niko_speak Well, I had help from \\p too!"
msgstr "@niko_speak Ну, это не только моя заслуга. Ведь мне помогает \\p!"

msgid "@plight_worry ...Oh, right."
msgstr "@plight_worry А... точно."

msgid "@plight_worry The whole messiah business."
msgstr "@plight_worry Ты же мессия и всё такое."

msgid "@plight ...Anyway, ready to go? I'll be up ahead."
msgstr "@plight ...В общем, ты готов? Я пойду вперёд."

msgid "[\\c[1]ACCESS DENIED.\\c[0]]"
msgstr "[\\c[1]ДОСТУП ЗАПРЕЩЁН.\\c[0]]"

