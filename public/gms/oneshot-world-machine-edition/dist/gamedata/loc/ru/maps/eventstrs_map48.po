msgstr "@plight_why Моё самое нелюбимое занятие..."

msgid "TO: CAFE"
msgstr "К: КАФЕ"

msgid "[NO TRESPASSING!]"
msgstr "[ПРОХОД ЗАПРЕЩЁН!]"

msgid "@niko Oh...excuse me!"
msgstr "@niko О... Прошу прощения!"

msgid "@niko It's an elevator."
msgstr "@niko Это лифт."

msgid "@Niko It's an elevator."
msgstr "@Niko Это лифт."

msgid "@niko_eyeclosed Apparently broken?"
msgstr "@niko_eyeclosed Кажется, не работает?"

msgid "@niko_speak Let's fix the elevator!"
msgstr "@niko_speak Давай починим лифт!"

msgid "@niko_speak It needs a code."
msgstr "@niko_speak Тут нужен код."

msgid "@niko_yawn *yawn* ..."
msgstr "@niko_yawn (Зевает.)"

msgid "@niko I'm having trouble staying awake, \\p.\\>\\nWe should find a place for me to take a nap..."
msgstr "@niko Я уже еле стою на ногах, \\p.\\>\\nНадо найти место, где я смогу вздремнуть..."

msgid "@niko_speak Oh! Thank you for holding the elevator door open for me, mister!"
msgstr "@niko_speak О, спасибо, что подержал дверь лифта!"

msgid "@plight No prob, hop in."
msgstr "@plight На здоровье. Заскакивай!"

msgid "@plight Oh hey, welcome back..."
msgstr "@plight О, привет! С возвращением..."

msgid "@plight_worry That... sure took you a while, huh..."
msgstr "@plight_worry Ты как-то... долго ходил..."

msgid "@niko2 Oh, shoot! You've been waiting this whole time?"
msgstr "@niko2 О, блин! Ты ждал меня всё это время?"

msgid "@niko And... holding the door open?"
msgstr "@niko И... держал дверь?"

msgid "@plight_worry Well I uh...\\.\\. didn't want to be rude..."
msgstr "@plight_worry Ну, я...\\.\\. не хотел показаться невежливым..."

msgid "@niko_eyeclosed I'm sorry, I should've told you to go on ahead..."
msgstr "@niko_eyeclosed Прости. Надо было сказать, чтобы ты ехал без меня..."

msgid "@plight Eh, don't worry about it."
msgstr "@plight Да не парься."

msgid "@niko I'll need to push the button to open the doors."
msgstr "@niko Мне придётся нажать кнопку, чтобы открыть дверь."

msgid "TO:\\nOFFICE BUILDING AND\\nCAFE"
msgstr "К:\\nОФИСНОМУ ЗДАНИЮ И\\nКАФЕ"

