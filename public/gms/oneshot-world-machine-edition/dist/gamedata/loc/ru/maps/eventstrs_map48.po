msgstr "@plight_why Я торчу тут уже столько времени...\\nДумаю, минуты \\v[22] точно."

msgid "@plight_why I'm losing so much time..."
msgstr "@plight_why Я уже столько времени потерял..."

msgid "@plight_why I hate this...."
msgstr "@plight_why Ненавижу..."

msgid "@plight Do you think you'll be able to make that button?"
msgstr "@plight Думаешь, у тебя получится сделать эту кнопку?"

msgid "@plight_2 Well, no pressure, kid."
msgstr "@plight_2 Что ж, не буду тебя подгонять."

msgid "@plight_2b I'll just... stick with my original plan for now..."
msgstr "@plight_2b Я пока буду придерживаться первоначального плана..."

msgid "@plight_2b Time to kick the door again."
msgstr "@plight_2b Пора снова как следует пнуть эту дверь."

msgid "@plight_why My foot hurts..."
msgstr "@plight_why Уже нога заболела..."

msgid "@plight 6, 3, 0, 1, 4..."
msgstr "@plight 6, 3, 0, 1, 4..."

msgid "@plight Guess I did it.\\> \\@plight_worry Somehow."
msgstr "@plight Кажется, получилось.\\> \\@plight_worry Сам не знаю как."

msgid "@niko_speak Did"
msgstr "@niko_speak Ты..."

msgid "@niko_what Did you really try all the codes...\\> \\@niko_what2 starting from 0..."
msgstr "@niko_what Ты правда перепробовал все коды?\\> \\@niko_what2 Начиная с 0?.."

msgid "@plight_smile Eh, it paid off."
msgstr "@plight_smile Получилось же."

msgid "@niko_wtf Still!"
msgstr "@niko_wtf И всё же!"

msgid "@niko6 Now I feel kinda bad for telling him to help, \\p..."
msgstr "@niko6 Теперь мне стыдно, что я попросил его о помощи, \\p..."

msgid "@niko_eyeclosed I didn't think he was gonna actually..."
msgstr "@niko_eyeclosed Не думал, что он и правда..."

msgid "@plight_smile Nah don't worry about it, just glad I could help."
msgstr "@plight_smile Не бери в голову. Я рад помочь."

msgid "@niko_speak Thank... thank you!"
msgstr "@niko_speak Спасибо! Огромное!"

msgid "@plight Yup.\\>\\nAnyway... you ready to go? I'll be up ahead."
msgstr "@plight Не за что.\\>\\nВ общем... ты готов? Я пойду вперёд."

msgid "@plight \\v[26], \\v[27], \\v[28], \\v[29], \\v[30]..."
msgstr "@plight \\v[26], \\v[27], \\v[28], \\v[29], \\v[30]..."

msgid "[PLEASE MAKE HIM STOP.]"
msgstr "[ПОЖАЛУЙСТА, УГОМОНИТЕ ЕГО.]"

msgid "@niko Hi."
msgstr "@niko Привет."

msgid "@plight Hi."
msgstr "@plight Привет."

msgid "@plight ...Can I help with anything?"
msgstr "@plight ...Я могу чем-то помочь?"

msgid "@plight Anything at all?"
msgstr "@plight Хоть чем-нибудь?"

msgid "@plight_worry Being so unproductive for so long... It's really getting to me..."
msgstr "@plight_worry Так долго торчать без дела... Меня это бесит..."

msgid "@niko I think \\p and I got it handled!"
msgstr "@niko Думаю, мы уже с этим справились!"

msgid "@niko What do you think, \\p?"
msgstr "@niko Как ты думаешь, \\p?"

msgid "[\"Tell him to use random codes\", \"Tell him to stand there\"]"
msgstr "[\"Скажи ему использовать случайные коды.\",\"Скажи ему стоять на своём месте.\"]"

msgid "@niko Maybe you can just try out some numbers until you get it..."
msgstr "@niko Может, попробовать набирать разные цифры, пока не сработает..."

msgid "@niko_speak I mean, \\p and I did it before!"
msgstr "@niko_speak \\p и я уже делали так раньше!"

msgid "@niko_eyeclosed Took us a while, but..."
msgstr "@niko_eyeclosed Это было не так уж быстро, но..."

msgid "@plight_worry ....seriously?"
msgstr "@plight_worry Серьёзно?.."

msgid "@plight Alright, I suppose that's better than doing nothing."
msgstr "@plight Ладно. Думаю, это лучше, чем вообще ничего не делать."

msgid "@plight Let's see... 0, 0, 0, 0, 0..."
msgstr "@plight Так, посмотрим... 0, 0, 0, 0, 0..."

msgid "@plight_why Yep, gonna be here for a while. 0, 0, 0, 0, 1....."
msgstr "@plight_why Да, это займёт какое-то время. 0, 0, 0, 0, 1..."

msgid "[\\c[1]ACCESS DENIED.\\c[0]\\| ...YOU AREN'T SERIOUSLY DOING THIS, ARE YOU?]"
msgstr "[\\c[1]ДОСТУП ЗАПРЕЩЁН.\\c[0]\\| ...ВЫ ВЕДЬ НЕ СЕРЬЁЗНО, ПРАВДА?]"

