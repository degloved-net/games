msgstr "@en_distressed_talk [Какая машина...]"

msgid "@en [I'm...]"
msgstr "@en [Я...]"

msgid "@niko3 The squares..."
msgstr "@niko3 Квадраты..."

msgid "@niko_eyeclosed Rue told me it was your own code going bad..."
msgstr "@niko_eyeclosed Рута сказала, что это твой испорченный код..."

msgid "@niko4 But... that's not really your fault, is it?"
msgstr "@niko4 Но... это не твоя вина, да?"

msgid "@en_distressed_meow [YES IT WAS!!!]"
msgstr "@en_distressed_meow [НЕТ, МОЯ!!!]"

msgid "@en_eyeclosed2 [...At first, it was intentional.]"
msgstr "@en_eyeclosed2 [Поначалу это вышло случайно...]"

