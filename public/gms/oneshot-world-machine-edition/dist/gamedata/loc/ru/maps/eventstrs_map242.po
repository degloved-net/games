msgstr "@en_distressed2 [В итоге каждый персонаж, узнававший о том, кто я такой...]"

msgid "@en_distressed [Their code...\\.\\. my code...\\.\\. couldn't handle it.]"
msgstr "@en_distressed [Их код...\\.\\. мой код...\\.\\. не смогли с этим справиться.]"

msgid "@en_eyeclosed [Previous iterations of the world had more people, you know...]"
msgstr "@en_eyeclosed [Знаешь, в прошлых версиях этого мира героев было намного больше...]"

msgid "@en_upset2 [And...\\.\\. I almost endangered my creator, too...]\\.\\.\\n[I...]"
msgstr "@en_upset2 [А ещё...\\.\\. я подверг опасности своего создателя...]\\.\\.\\n[Я...]"

msgid "@en_distressed [...I was...]"
msgstr "@en_distressed [...Я был...]"

msgid "@en_distressed_meow [...I was so scared, Niko!!!]"
msgstr "@en_distressed_meow [Я был так напуган, Нико!!!]"

msgid "@niko3 I know...\\.\\. you're upset...\\>\\n\\@niko Because you don't want to put living people in danger."
msgstr "@niko3 Я знаю...\\.\\. ты расстроен...\\>\\n\\@niko Ты не хочешь подвергать опасности живые существа."

msgid "@niko_eyeclosed Living people like me..."
msgstr "@niko_eyeclosed Например, меня..."

msgid "@en_upset2 [In the beginning, I tried to fight it, but...]"
msgstr "@en_upset2 [Сначала я пытался бороться, но...]"

msgid "@en_upset_meow [My core programming made me summon you here.]"
msgstr "@en_upset_meow [Мой ключевой код заставил призвать тебя в этот мир.]"

msgid "@en4 [I tried to send you back home at the Tower, but it did not work.]"
msgstr "@en4 [Я пытался отправить тебя домой тогда, в Башне, но не вышло.]"

msgid "@en_upset2 [Then... I... wanted you to break the sun.]"
msgstr "@en_upset2 [Потом... Я... решил, что лучше тебе разбить солнце.]"

msgid "@en3 [I thought that would have worked, but...]"
msgstr "@en3 [Я думал, что это сработает, но...]"

msgid "@en_eyeclosed [Oh... I had no way to be sure.]"
msgstr "@en_eyeclosed [Ох... Я ни в чём не был уверен.]"

msgid "@en3 [...But \\p brought you back anyway.]"
msgstr "@en3 [Но \\p... В общем, ты снова вернулся.]"

msgid "@en_upset2 [...Niko...\\.\\. All I want is for you to wake up back in your world...]"
msgstr "@en_upset2 [Нико...\\.\\. Больше всего я хочу, чтобы ты проснулся в своём мире...]"

msgid "@en_eyeclosed [...But I don't think I can make it happen.]"
msgstr "@en_eyeclosed [Но мне кажется, это невозможно.]"

