msgstr "@en_eyeclosed [В тот момент я твёрдо решил, что для всех будет лучше, если я самоотключусь.]"

msgid "@en_upset [...]"
msgstr "@en_upset [...]"

msgid "@en_distressed_meow [I really am a flawed machine, aren't I?]"
msgstr "@en_distressed_meow [Я очень плохая машина, правда?]"

msgid "@niko3 ..."
msgstr "@niko3 ..."

msgid "@en_distressed2 [What kind of machine would go against the wishes of its own creator?]"
msgstr "@en_distressed2 [Какая машина пойдёт против желаний своего создателя?]"

