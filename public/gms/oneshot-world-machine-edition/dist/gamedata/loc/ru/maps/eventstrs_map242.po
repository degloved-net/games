msgstr "@en_eyeclosed [И тогда я...]"

msgid "@en_distressed2 [I panicked.]"
msgstr "@en_distressed2 [Я запаниковал.]"

msgid "@niko2 That was when... the cave in happened...."
msgstr "@niko2 Это произошло... когда я был в пещере..."

