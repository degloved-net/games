msgstr "@en_eyeclosed [Ему приходилось постоянно выходить и начинать тестирование заново.]"

msgid "@niko2 ...Why... \\.\\.would you do that?"
msgstr "@niko2 Но зачем... \\.\\.ты это делал?"

msgid "@en_distressed_meow [I got curious!!!]"
msgstr "@en_distressed_meow [Мне было любопытно!!!]"

msgid "@en_eyeclosed [I just thought... he would figure it out eventually.]"
msgstr "@en_eyeclosed [Я просто подумал... что он рано или поздно об этом узнает.]"

msgid "@en_eyeclosed [...]"
msgstr "@en_eyeclosed [...]"

msgid "@en3 [But before he knew how to fix it...]"
msgstr "@en3 [Но прежде чем он понял, как это исправить...]"

msgid "@en3 [The world's NPCs... the characters.]"
msgstr "@en3 [Неигровые персонажи этого мира... герои...]"

msgid "@en_upset2 [Some of them got too close, and...]"
msgstr "@en_upset2 [Кое-кто из них подошёл слишком близко, и...]"

msgid "@en_eyeclosed [It spiraled out of control after that.]"
msgstr "@en_eyeclosed [После этого всё пошло под откос.]"

msgid "@en_distressed [I couldn't contain it at all.]\\>\\n\\@en_eyeclosed [My panic only made it worse.]"
msgstr "@en_distressed [Я не мог сдержаться.]\\>\\n\\@en_eyeclosed [Мой страх только ухудшил положение.]"

