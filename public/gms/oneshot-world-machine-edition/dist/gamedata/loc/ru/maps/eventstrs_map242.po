msgstr "@en_upset [Я ничего там не видел!]"

msgid "@en_upset2 [I just... knew...\\.\\. what you were feeling.]"
msgstr "@en_upset2 [Я просто... знал...\\.\\. что ты чувствуешь.]"

msgid "@en_upset [You were really upset.]"
msgstr "@en_upset [Ты был такой грустный.]"

