msgid "@niko We made it!"
msgstr "@niko У нас получилось!"

msgid "@calamus C'mon, Alula.\\>\\nLet's go see mom."
msgstr "@calamus Идём, Алула.\\>\\nПроведаем маму."

msgid "@alula_speak Okay!"
msgstr "@alula_speak Ладно!"

msgid "@cedric ...it's fixed."
msgstr "@cedric Готово."

msgid "@cedric We can leave in the next five minutes, if you are ready."
msgstr "@cedric Если ты готов, можем выдвигаться через пять минут."

msgid "@niko_eyeclosed ...alright."
msgstr "@niko_eyeclosed Хорошо..."

msgid "@niko_distressed2 ..."
msgstr "@niko_distressed2 ..."

msgid "@cedric_sigh I understand if you are upset."
msgstr "@cedric_sigh Понимаю, ты расстроен."

msgid "@cedric3 But please...\\.\\. try to understand."
msgstr "@cedric3 Но пожалуйста...\\.\\. попытайся понять."

msgid "@cedric_sigh My father is doing this to help all of us."
msgstr "@cedric_sigh Отец делает это, чтобы всем нам помочь."

msgid "@cedric And that includes you, Niko."
msgstr "@cedric Включая тебя, Нико."

msgid "@cedric_sigh2 The fact that you can't even go back home...\\> I'm sure it upsets him greatly."
msgstr "@cedric_sigh2 Ты ведь не можешь вернуться домой...\\> Я уверен, что это его сильно печалит."

msgid "@cedric It's..."
msgstr "@cedric Просто..."

msgid "@cedric_sigh Sigh..."
msgstr "@cedric_sigh Эх..."

msgid "@cedric_sigh2 The world means a lot to him, you know..."
msgstr "@cedric_sigh2 Знаешь, этот мир много для него значит."

msgid "@niko2 So... \\.\\.how does flying...\\.\\. work?"
msgstr "@niko2 Так как надо... \\.\\.летать...\\.\\. на этой штуке?"

msgid "@cedric_talk ...wait, don't these machines already exist in your world? \\>\\n\\@cedric_hmm You should already know what to expect..."
msgstr "@cedric_talk Ты же сказал, что эти машины есть в твоём мире? \\>\\n\\@cedric_hmm Ты должен знать, чего ожидать..."

msgid "@niko_eyeclosed Not really..."
msgstr "@niko_eyeclosed Вообще-то, нет..."

msgid "@niko I've only heard about them!"
msgstr "@niko Я только слышал про них!"

msgid "@niko_eyeclosed They're usually... a lot bigger than this one, anyway."
msgstr "@niko_eyeclosed И они обычно... намного больше этой."

msgid "@cedric3 Ah..."
msgstr "@cedric3 А..."

msgid "@cedric_talk Well, a word of precaution, before we take to the air..."
msgstr "@cedric_talk Что ж, прежде чем мы взлетим, хочу предостеречь..."

msgid "@cedric_talk Please try not to panic."
msgstr "@cedric_talk Пожалуйста, не впадай в панику."

msgid "@cedric_smile It takes a few minutes of getting used to, but it's not that bad once you are in the air."
msgstr "@cedric_smile Нужно несколько минут, чтобы привыкнуть, но когда ты уже в воздухе, всё не так плохо."

msgid "@niko_eyeclosed I'll... try."
msgstr "@niko_eyeclosed Я... постараюсь."

msgid "@niko_speak Oh! I should probably tell Calamus and Alula where I'm going."
msgstr "@niko_speak Ой! Я должен сказать Каламусу и Алуле, куда собираюсь."

msgid "@cedric_talk You mean those two running over here now?"
msgstr "@cedric_talk Ты имеешь в виду тех двух бегущих к нам ребятишек?"

msgid "@alula_oh Niko!!!!"
msgstr "@alula_oh Нико!!!"

msgid "@alula_oh Bad news!"
msgstr "@alula_oh Плохие новости!"

msgid "@calamus_shock The boat is gone!"
msgstr "@calamus_shock Лодка пропала!"

msgid "@niko3 What?!"
msgstr "@niko3 Что?!"

msgid "@alula_oh It's the squares!"
msgstr "@alula_oh Это всё квадраты!"

msgid "@calamus_speak It looks like they're headed in this direction!"
msgstr "@calamus_speak Кажется, они направляются в эту сторону!"

msgid "@niko3 That's..."
msgstr "@niko3 Это..."

msgid "@cedric_eek ...fast..."
msgstr "@cedric_eek Очень быстро..."

msgid "@cedric_talk ...Calamus, right?"
msgstr "@cedric_talk Ты Каламус, да?"

msgid "@calamus Yeah?"
msgstr "@calamus Ага."

msgid "@cedric_talk How...\\.\\. bad, is it?"
msgstr "@cedric_talk Насколько...\\.\\. быстро?"

msgid "@calamus Doesn't seem to be of immediate danger."
msgstr "@calamus Ну, не то чтобы очень-преочень быстро."

msgid "@cedric_sigh Then... it is of priority that I take you to the city first, Niko"
msgstr "@cedric_sigh Тогда я немедленно отвезу тебя в город, Нико."

msgid "@niko2 But what about them...?"
msgstr "@niko2 А как же они?"

msgid "@cedric I can make a detour later and drop you guys off in the city too, if you want."
msgstr "@cedric Я могу потом вернуться и подбросить вас до города, если хотите."

msgid "@cedric_talk The city is better equipped to handle the squares, you'll be safer there."
msgstr "@cedric_talk Город лучше оснащён в плане устойчивости к квадратам. Там вам будет спокойнее."

msgid "@alula_gasp YOU'RE TAKING US TO THE CITY!!!"
msgstr "@alula_gasp ТЫ ОТВЕЗЁШЬ НАС В ГОРОД?!"

msgid "@cedric_smile If you wish."
msgstr "@cedric_smile Если хотите."

msgid "@alula_gasp OH YEAH!!!"
msgstr "@alula_gasp ОЙ, КОНЕЧНО!!!"

msgid "@cedric Alright."
msgstr "@cedric Хорошо."

msgid "@cedric3 I will be back here in an hour, so please wait for me until then."
msgstr "@cedric3 Я вернусь через час, так что ждите."

msgid "@niko You guys sure you'll be fine here?"
msgstr "@niko Ребята, вы уверены, что всё будет нормально?"

msgid "@alula Mhm!"
msgstr "@alula Ага!"

msgid "@calamus_speak The squares are still moving pretty slowly for now..."
msgstr "@calamus_speak Квадраты пока что передвигаются довольно медленно..."

msgid "@niko2 Alright, then..."
msgstr "@niko2 Тогда ладно."

msgid "@niko_speak Guess we'll run into each other again, soon..."
msgstr "@niko_speak Думаю, мы с вами скоро встретимся."

msgid "@niko_speak I'm ready to go!"
msgstr "@niko_speak Я готов!"

msgid "@cedric_smile Alright!"
msgstr "@cedric_smile Отлично!"

msgid "@calamus This is her grave..."
msgstr "@calamus Это её могила..."

msgid "@calamus We're just about done here, so let us know when you want to go back to the ruins."
msgstr "@calamus Мы здесь почти закончили. Дай знать, когда захочешь вернуться в руины."

msgid "@niko Okay."
msgstr "@niko Хорошо."

msgid "@niko Hey, do you know where I could find a battery?"
msgstr "@niko Эй, ты не знаешь, где тут найти батарею?"

msgid "@calamus Good question.."
msgstr "@calamus Хороший вопрос..."

msgid "@calamus_heh We...\\.\\. don't really use electricity in the Glen."
msgstr "@calamus_heh Тут, в Долине...\\.\\. мы не используем электричество."

msgid "@niko_eyeclosed Ah."
msgstr "@niko_eyeclosed А."

msgid "@calamus_speak Oh, but there are robots at the research station!\\>\\nIf there's a battery anywhere, they'd know where it is."
msgstr "@calamus_speak О, на научной станции есть роботы!\\>\\nМожет, там где-то есть батарея. Они точно знают."

msgid "@niko Gotcha, thanks!"
msgstr "@niko Ясно, спасибо!"

msgid "@alula Hi mom..."
msgstr "@alula Привет, мам..."

msgid "@alula Didja find any...\\@alula_pout ...any..."
msgstr "@alula Ты нашёл эти...\\@alula_pout как их там..."

msgid "@alula_oh ...what were you looking for again?"
msgstr "@alula_oh Что ты там искал?"

msgid "@niko_speak Gears?"
msgstr "@niko_speak Шестерёнки?"

msgid "@alula_speak Gears!\\> \\@alula Didja find any of those?"
msgstr "@alula_speak Шестерёнки!\\>\\@alula Ты их нашёл?"

msgid "@niko No, but... I found this music box though!"
msgstr "@niko Нет, но... Я нашёл эту музыкальную шкатулку!"

msgid "@alula_gasp Ooooh!"
msgstr "@alula_gasp О-о-о!"

msgid "@niko Do you know where I could find some gears?"
msgstr "@niko Ты не знаешь, где найти шестерёнки?"

msgid "@alula Gears?\\>\\nWhat's... that?"
msgstr "@alula Шестерёнки?\\>\\nЧто это такое?"

msgid "@niko_speak It's like...\\.\\. A metal circle thing with teeth!"
msgstr "@niko_speak Это такие...\\.\\. железные кружочки с зубцами!"

msgid "@alula_speak A circle... with teeth?!"
msgstr "@alula_speak Кружочек с зубами?!"

msgid "@alula_speak Haha, that sounds so silly!\\>\\nLike something Magpie would have!"
msgstr "@alula_speak Ха-ха, так смешно звучит!\\>\\nУ Барахольщика наверняка такие есть!"

msgid "@niko Magpie?"
msgstr "@niko Барахольщика?"

msgid "@alula Y'know, the trader guy!"
msgstr "@alula Ну, у парня-торговца."

msgid "@alula He collects all kinds of funny stuff!"
msgstr "@alula Он собирает всякие чудные штуковины!"

msgid "@alula_speak I mean, he even keeps around broken glass and junk!"
msgstr "@alula_speak Он хранит даже разбитые стекляшки и разный мусор!"

msgid "@niko ..."
msgstr "@niko ..."

msgid "@niko_speak ...Oh yeah! \\@niko\\>I think I know who you're talking about."
msgstr "@niko_speak Ага!\\>\\@niko Думаю, я знаю, о ком ты говоришь."

msgid "@alula_speak He's such a weirdo!"
msgstr "@alula_speak Он такой чудик!"

msgid "@niko It's a fire."
msgstr "@niko Это огонь."

