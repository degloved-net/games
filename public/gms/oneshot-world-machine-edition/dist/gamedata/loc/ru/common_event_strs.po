msgstr "@ed [Сейчас нельзя телепортироваться.]"

msgid "@tut FAST TRAVEL\\n\\n\\nYOU CAN QUICKLY TRAVEL TO THE LOCATIONS YOU HAVE ALREADY VISITED BY SELECTING THE \"FAST TRAVEL\" OPTION IN THE MENU.\\n\\nYOU CAN OPEN THE MENU WITH @MAINMENU\\n\\nFAST TRAVEL CANNOT BE USED INDOORS."
msgstr "@tut ТЕЛЕПОРТ\\n\\n\\nВЫ МОЖЕТЕ БЫСТРО ПЕРЕМЕСТИТЬСЯ В УЖЕ ПОСЕЩЁННЫЕ ЛОКАЦИИ. ДЛЯ ЭТОГО ВЫБЕРИТЕ «ТЕЛЕПОРТ» В МЕНЮ.\\n\\nЧТОБЫ ОТКРЫТЬ МЕНЮ, НАЖМИТЕ @MAINMENU\\n\\nТЕЛЕПОРТ НЕДОСТУПЕН В ПОМЕЩЕНИИ."

msgid "@tut2 CONTROLS\\n\\nEXAMINE/SELECT - @OK\\n\\nCANCEL - @CANCEL\\n\\nWALK - @MOVE\\n\\nWALK FASTER - @RUN\\n\\nMENU - @MAINMENU\\n\\nINVENTORY - @INVENTORY"
msgstr "@tut2 УПРАВЛЕНИЕ\\n\\nОСМОТРЕТЬ/ВЫБРАТЬ — @OK\\n\\nОТМЕНИТЬ — @CANCEL\\n\\nШАГ — @MOVE\\n\\nБЕГ — @RUN\\n\\nМЕНЮ — @MAINMENU\\n\\nИНВЕНТАРЬ — @INVENTORY"

msgid "@tut GAMEPLAY\\n\\nEXPLORE AND INTERACT WITH THE ENVIRONMENT AND CHARACTERS. SOMETIMES YOU MAY FIND AN ITEM.\\n\\nONCE YOU HAVE PICKED UP AN ITEM, YOU MAY SELECT IT FROM YOUR INVENTORY.\\n\\nWHEN THE ITEM IS ACTIVE, YOU CAN EITHER COMBINE IT WITH OTHER ITEMS IN THE INVENTORY OR USE IT AT CERTAIN LOCATIONS IN ORDER TO PROGRESS."
msgstr "@tut ИГРОВОЙ ПРОЦЕСС\\n\\nИССЛЕДУЙТЕ МИР И ВЗАИМОДЕЙСТВУЙТЕ С ГЕРОЯМИ. ИНОГДА ВАМ БУДУТ ПОПАДАТЬСЯ ПРЕДМЕТЫ.\\n\\nСОБРАННЫЕ ПРЕДМЕТЫ МОЖНО ВЫБИРАТЬ В ИНВЕНТАРЕ.\\n\\nКОГДА ПРЕДМЕТ АКТИВЕН, ВЫ МОЖЕТЕ КОМБИНИРОВАТЬ ЕГО С ДРУГИМИ ПРЕДМЕТАМИ ИЛИ ИСПОЛЬЗОВАТЬ В ОПРЕДЕЛЁННЫХ ЛОКАЦИЯХ, ЧТОБЫ ПРОЙТИ ДАЛЬШЕ."

msgid "@tut OTHER\\n\\n\\n\\n\\nCLOSING THE GAME WINDOW WILL SAVE YOUR PROGRESS.\\n\\nTHIS GAME ALSO SAVES AFTER SOME KEY EVENTS."
msgstr "@tut ПРОЧЕЕ\\n\\n\\n\\n\\nПРОГРЕСС СОХРАНЯЕТСЯ, КОГДА ВЫ ЗАКРЫВАЕТЕ ИГРУ.\\n\\nИГРА ТАКЖЕ АВТОМАТИЧЕСКИ СОХРАНЯЕТСЯ ПОСЛЕ НЕКОТОРЫХ КЛЮЧЕВЫХ СОБЫТИЙ."

msgid "@niko_speak \\p, there's something in the air here..."
msgstr "@niko_speak \\p, тут что-то в воздухе..."

msgid "@niko_eyeclosed It hurts to breathe..."
msgstr "@niko_eyeclosed Мне больно дышать..."

msgid "@ed [The air here is unbreathable.]"
msgstr "@ed [Воздух здесь непригоден для дыхания.]"

msgid "@niko_gasmask I should be fine with this mask on."
msgstr "@niko_gasmask В этом противогазе со мной ничего не случится."

msgid "Start over?"
msgstr "Начать заново?"

msgid "[\"Yes\", \"No\"]"
msgstr "[\"Да.\",\"Нет.\"]"

msgid "@niko It's an empty rectangular slot.\\>\\nLooks like something could fit in here..."
msgstr "@niko Это пустое прямоугольное отверстие.\\>\\nКажется, сюда можно что-то вставить..."

msgid "@niko_eyeclosed \\p... someone lives here...\\>\\nWe can't just sleep in their bed."
msgstr "@niko_eyeclosed \\p... Здесь кто-то живёт...\\>\\nНельзя лечь спать в чужую постель."

