msgstr "Это действие запишет ваш прогресс в этом мире."

msgid "To return to this world again, you need to relaunch the application."
msgstr "Чтобы вернуться в этот мир, перезапустите приложение."

msgid "Proceed?"
msgstr "Продолжить?"

msgid "@niko I'll wear them when I have to."
msgstr "@niko Надену их, когда понадобится."

msgid "@niko I can't take this off here, \\p!"
msgstr "@niko Я не могу здесь это снять, \\p!"

msgid "@niko I'll wear it when I have to."
msgstr "@niko Надену это, когда понадобится."

