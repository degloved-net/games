msgid "52:name=Library card (sticky)"
msgstr "библ. абонемент (липкий)"

msgid "52:description=There's glitter glue all over her photo now..."
msgstr "Теперь всё её фото в клее..."

msgid "53:name=photo of Niko (sticky)"
msgstr "фото Нико (липкое)"

msgid "53:description=The back of the photo is covered in glitter glue."
