msgid "49:name=boots"
msgstr "сапоги"

msgid "49:description=These boots will make it possible to move quickly."
msgstr "Благодаря этим сапогам можно двигаться быстрее."

msgid "50:name=novelty T-shirt"
msgstr "сувенирная футболка"

msgid "50:description=\"I herded rams and all I got was this lousy T-shirt!\""
msgstr "«Я пас баранов и получил лишь эту футболку»."

msgid "51:name=\"Kip\" 's library card"
msgstr "библ. абонемент Кип"

msgid "51:description=Library card from Kip. Niko's own photo is glued on."
