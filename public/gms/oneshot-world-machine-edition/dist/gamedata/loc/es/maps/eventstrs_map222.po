msgstr "@niko2 Um... ¿Qué son estas cosas?"
msgid "@proto2 [Code portals.]"
msgstr "@proto2 [Portales de código.]"
msgid "@proto1c [They... \\.\\.temporarily remove us from the world.]"
msgstr "@proto1c [Nos... \\.\\.eliminan temporalmente del mundo.]"
msgid "@niko2 ....what?"
msgstr "@niko2 ¿... Cómo?"
