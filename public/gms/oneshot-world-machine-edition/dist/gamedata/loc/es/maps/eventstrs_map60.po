msgid "@niko The world below looks so small..."
msgstr "@niko Ahí abajo el mundo parece tan pequeño..."

msgid "@niko_eyeclosed No turning back now..."
msgstr "@niko_eyeclosed Ya no hay vuelta atrás..."

msgid "@niko_speak So this is where the sun belongs..."
msgstr "@niko_speak Así que este es el lugar al que pertenece el sol..."

msgid "@niko2 If I put the sun in here, we'll be able to save the world, right?"
msgstr "@niko2 Si coloco el sol aquí, seré capaz de salvar el mundo, ¿verdad?"

msgid "@niko ...but if I want to go home...\\> \\@niko_distressed I'll have to...\\> \\@niko_distressed_meow break it?"
msgstr "@niko Pero, si quiero irme a casa... \\>\\@niko_distressed tendré que... \\> \\@niko_distressed_meow ¿romperlo?"

msgid "@niko_sad Oh...."
msgstr "@niko_sad Vaya..."

msgid "@niko_distressed2 ....\\p? \\>\\n\\@niko_distressed2 What should I... do?"
msgstr "@niko_distressed2 ¿...\\p? \\>\\n\\@niko_distressed2 ¿Qué debería... hacer?"

msgid "What's the right thing to do?"
msgstr "¿Cuál es la decisión correcta?"

msgid "@niko_eyeclosed Y-You're right...\\>\\nI can't just leave everyone here to die."
msgstr "@niko_eyeclosed Tienes razón...\\>\\nNo puedo dejar que todo el mundo muera."

msgid "@niko Thank you for your help, \\p.\\>\\nI promise I'll be okay."
msgstr "@niko Gracias por tu ayuda, \\p.\\>\\nTe prometo que voy a estar bien."

msgid "@credits Thanks for Playing!"
msgstr "@credits ¡Gracias por jugar!"

msgid "I...\\> trust your judgement, \\p."
msgstr "Yo...\\> confío en tu criterio, \\p."

