msgid "@niko ..."
msgstr "@niko ..."

msgid "@niko_what Wait, \\p, are we really gonna take these with us?"
msgstr "@niko_what Espera, \\p, ¿de verdad nos los vamos a llevar?"

msgid "@niko_what But they look so heavy..."
msgstr "@niko_what Pero si parece que pesan un montón..."

msgid "@niko_eyeclosed Alright..."
msgstr "@niko_eyeclosed Bueno..."

msgid "@niko_speak Hey! They're actually pretty light!"
msgstr "@niko_speak ¡Oye! ¡En verdad son muy ligeros!"

msgid "@niko It's empty now..."
msgstr "@niko Ahora no hay nada dentro..."

