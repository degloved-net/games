msgid "@niko3 You can do it, I know you can!"
msgstr "@niko3 Tú puedes, ¡sé que puedes!"

msgid "@niko4 You've...\\.\\. helped me come this far."
msgstr "@niko4 Me has...\\.\\. ayudado a llegar hasta aquí."

msgid "@en_upset [...I'll...]\\>\\n\\@en_eyeclosed [I'll try.]"
msgstr "@en_upset [Lo...]\\>\\n\\@en_eyeclosed [Lo intentaré.]"

msgid "@en3 [I can't promise anything, but...]"
msgstr "@en3 [No puedo prometer nada, pero...]"

msgid "@en4 [Here.]"
msgstr "@en4 [Toma.]"

msgid "@en_eyeclosed [Take the sun.]"
msgstr "@en_eyeclosed [Toma el sol.]"

msgid "@en5 [I'll...\\.\\. try to remember the lost code...]"
msgstr "@en5 [Intentaré...\\.\\. recordar el código perdido...]"

msgid "@en4 [...and... recreate it.]"
msgstr "@en4 [... Y... recrearlo.]"

msgid "@en_upset2 [But for that to happen...]"
msgstr "@en_upset2 [Pero, para eso...]"

msgid "@en3 [Niko... you need to navigate through this room...]"
msgstr "@en3 [Niko... tienes que cruzar esta habitación...]"

msgid "@en_eyeclosed [You need to get past the squares somehow...]"
msgstr "@en_eyeclosed [Tendrás que pasar los cuadrados de alguna forma...]"

msgid "@en_distressed [Oh...\\.\\. I don't like this...]"
msgstr "@en_distressed [Oh...\\.\\.Esto no me gusta...]"

msgid "@en_distressed2 [What if you get hurt?]"
msgstr "@en_distressed2 [¿Y si te haces daño?]"

msgid "@niko2 It's fine... It's fine..."
msgstr "@niko2 No pasa nada... No pasa nada..."

msgid "@niko4 I'll...\\.\\. I'll try to be careful, ok?"
msgstr "@niko4 Intentaré...\\.\\. Intentaré tener cuidado, ¿vale?"

msgid "@niko2 I can do this."
msgstr "@niko2 Puedo hacer esto."

