msgid "@niko We made it!"
msgstr "@niko ¡Lo hemos conseguido!"

msgid "@calamus C'mon, Alula.\\>\\nLet's go see mom."
msgstr "@calamus Vamos, Alula.\\>\\nVamos a ver a mamá."

msgid "@alula_speak Okay!"
msgstr "@alula_speak ¡Vale!"

msgid "@cedric ...it's fixed."
msgstr "@cedric ... Solucionado."

msgid "@cedric We can leave in the next five minutes, if you are ready."
msgstr "@cedric Podemos irnos en cinco minutos, si ya has terminado."

msgid "@niko_eyeclosed ...alright."
msgstr "@niko_eyeclosed ... De acuerdo."

msgid "@niko_distressed2 ..."
msgstr "@niko_distressed2 ..."

msgid "@cedric_sigh I understand if you are upset."
msgstr "@cedric_sigh Entiendo que te hayas molestado."

msgid "@cedric3 But please...\\.\\. try to understand."
msgstr "@cedric3 Pero, por favor...\\.\\. Intenta comprenderlo."

msgid "@cedric_sigh My father is doing this to help all of us."
msgstr "@cedric_sigh Mi padre hace esto para ayudarnos a todos."

msgid "@cedric And that includes you, Niko."
msgstr "@cedric Y eso te incluye a ti, Niko."

msgid "@cedric_sigh2 The fact that you can't even go back home...\\> I'm sure it upsets him greatly."
msgstr "@cedric_sigh2 El hecho de que no puedas volver a casa...\\> Seguro que eso le preocupa mucho."

msgid "@cedric It's..."
msgstr "@cedric Es que..."

msgid "@cedric_sigh Sigh..."
msgstr "@cedric_sigh Ay..."

msgid "@cedric_sigh2 The world means a lot to him, you know..."
msgstr "@cedric_sigh2 El mundo significa mucho para él, ¿sabes?"

msgid "@niko2 So... \\.\\.how does flying...\\.\\. work?"
msgstr "@niko2 Entonces... \\.\\.¿Cómo funciona...\\.\\. eso de volar?"

msgid "@cedric_talk ...wait, don't these machines already exist in your world? \\>\\n\\@cedric_hmm You should already know what to expect..."
msgstr "@cedric_talk ... Espera, ¿esas máquinas no existen ya en tu mundo?\\>\\n\\@cedric_hmm Ya deberías saber qué esperar..."

msgid "@niko_eyeclosed Not really..."
msgstr "@niko_eyeclosed En realidad, no..."

msgid "@niko I've only heard about them!"
msgstr "@niko ¡Solo he oído hablar de ellas!"

msgid "@niko_eyeclosed They're usually... a lot bigger than this one, anyway."
msgstr "@niko_eyeclosed Normalmente... son mucho más grandes que esta, de todas formas."

msgid "@cedric3 Ah..."
msgstr "@cedric3 Ah..."

msgid "@cedric_talk Well, a word of precaution, before we take to the air..."
msgstr "@cedric_talk Bueno, una advertencia antes de que despeguemos..."

msgid "@cedric_talk Please try not to panic."
msgstr "@cedric_talk Que no cunda el pánico."

msgid "@cedric_smile It takes a few minutes of getting used to, but it's not that bad once you are in the air."
msgstr "@cedric_smile Tardas unos minutos en acostumbrarte, pero no está tan mal una vez que estás volando."

msgid "@niko_eyeclosed I'll... try."
msgstr "@niko_eyeclosed Lo... intentaré."

msgid "@niko_speak Oh! I should probably tell Calamus and Alula where I'm going."
msgstr "@niko_speak ¡Oh! Quizás debería decirle a Calamus y a Alula a dónde voy."

msgid "@cedric_talk You mean those two running over here now?"
msgstr "@cedric_talk ¿Te refieres a esos dos que vienen corriendo hacia aquí?"

msgid "@alula_oh Niko!!!!"
msgstr "@alula_oh ¡¡Niko!!"

msgid "@alula_oh Bad news!"
msgstr "@alula_oh ¡Malas noticias!"

msgid "@calamus_shock The boat is gone!"
msgstr "@calamus_shock ¡La barca ha desaparecido!"

msgid "@niko3 What?!"
msgstr "@niko3 ¡¿Cómo?!"

msgid "@alula_oh It's the squares!"
msgstr "@alula_oh ¡Han sido los cuadrados!"

msgid "@calamus_speak It looks like they're headed in this direction!"
msgstr "@calamus_speak ¡Parece que vienen en esta dirección!"

msgid "@niko3 That's..."
msgstr "@niko3 Pero eso es..."

msgid "@cedric_eek ...fast..."
msgstr "@cedric_eek ... Qué rápido van..."

msgid "@cedric_talk ...Calamus, right?"
msgstr "@cedric_talk ... Calamus, ¿no?"

msgid "@calamus Yeah?"
msgstr "@calamus ¿Sí?"

msgid "@cedric_talk How...\\.\\. bad, is it?"
msgstr "@cedric_talk ¿Cómo...\\.\\. de peligroso es?"

msgid "@calamus Doesn't seem to be of immediate danger."
msgstr "@calamus No creo que se trate de peligro inminente."

msgid "@cedric_sigh Then... it is of priority that I take you to the city first, Niko"
msgstr "@cedric_sigh Entonces... La prioridad es que te lleve primero a la ciudad, Niko."

msgid "@niko2 But what about them...?"
msgstr "@niko2 ¿Pero qué pasa con ellos...?"

msgid "@cedric I can make a detour later and drop you guys off in the city too, if you want."
msgstr "@cedric Puedo desviarme luego y dejaros en la ciudad también, si queréis."

msgid "@cedric_talk The city is better equipped to handle the squares, you'll be safer there."
msgstr "@cedric_talk La ciudad está mejor equipada para soportar los cuadrados, allí estaréis más seguros."

msgid "@alula_gasp YOU'RE TAKING US TO THE CITY!!!"
msgstr "@alula_gasp ¡¡NOS VAS A LLEVAR A LA CIUDAD!!"

msgid "@cedric_smile If you wish."
msgstr "@cedric_smile Si así lo queréis..."

msgid "@alula_gasp OH YEAH!!!"
msgstr "@alula_gasp ¡¡OH, SÍ!!"

msgid "@cedric Alright."
msgstr "@cedric Muy bien."

msgid "@cedric3 I will be back here in an hour, so please wait for me until then."
msgstr "@cedric3 Estaré de vuelta en una hora, así que esperadme hasta entonces."

msgid "@niko You guys sure you'll be fine here?"
msgstr "@niko ¿Seguro que aquí estaréis bien?"

msgid "@alula Mhm!"
msgstr "@alula Mmm..."

msgid "@calamus_speak The squares are still moving pretty slowly for now..."
msgstr "@calamus_speak Los cuadrados siguen moviéndose muy despacio por ahora..."

msgid "@niko2 Alright, then..."
msgstr "@niko2 De acuerdo, entonces..."

msgid "@niko_speak Guess we'll run into each other again, soon..."
msgstr "@niko_speak Supongo que nos volveremos a ver pronto..."

msgid "@niko_speak I'm ready to go!"
msgstr "@niko_speak ¡Vámonos!"

msgid "@cedric_smile Alright!"
msgstr "@cedric_smile ¡De acuerdo!"

msgid "@calamus This is her grave..."
msgstr "@calamus Esta es su tumba..."

msgid "@calamus We're just about done here, so let us know when you want to go back to the ruins."
msgstr "@calamus Ya casi hemos terminado, así que avísanos cuando quieras volver a las ruinas."

msgid "@niko Okay."
msgstr "@niko Vale."

msgid "@niko Hey, do you know where I could find a battery?"
msgstr "@niko Oye, ¿sabes dónde puedo encontrar una batería?"

msgid "@calamus Good question.."
msgstr "@calamus Buena pregunta."

msgid "@calamus_heh We...\\.\\. don't really use electricity in the Glen."
msgstr "@calamus_heh La verdad...\\.\\. No usamos electricidad en el Valle."

msgid "@niko_eyeclosed Ah."
msgstr "@niko_eyeclosed Ah."

msgid "@calamus_speak Oh, but there are robots at the research station!\\>\\nIf there's a battery anywhere, they'd know where it is."
msgstr "@calamus_speak Oh, ¡pero en la estación de investigación hay robots!\\>\\nSi hay una batería por alguna parte, ellos sabrán dónde."

msgid "@niko Gotcha, thanks!"
msgstr "@niko Entendido, ¡gracias!"

msgid "@alula Hi mom..."
msgstr "@alula Hola, mamá..."

msgid "@alula Didja find any...\\@alula_pout ...any..."
msgstr "@alula ¿Haz encontrado...\\@alula_pout ... algún...?"

msgid "@alula_oh ...what were you looking for again?"
msgstr "@alula_oh ... ¿Qué estabas buscando ahora?"

msgid "@niko_speak Gears?"
msgstr "@niko_speak ¿Engranajes?"

msgid "@alula_speak Gears!\\> \\@alula Didja find any of those?"
msgstr "@alula_speak ¡Engranajes!\\>\\@alula ¿Has encontrado alguno?"

msgid "@niko No, but... I found this music box though!"
msgstr "@niko No, ¡pero he encontrado esta caja de música!"

msgid "@alula_gasp Ooooh!"
msgstr "@alula_gasp ¡Halaaa!"

msgid "@niko Do you know where I could find some gears?"
msgstr "@niko Oye, ¿sabes dónde podría encontrar algunos engranajes?"

msgid "@alula Gears?\\>\\nWhat's... that?"
msgstr "@alula ¿Engranajes?\\>\\n¿Qué... es eso?"

msgid "@niko_speak It's like...\\.\\. A metal circle thing with teeth!"
msgstr "@niko_speak Son como...\\.\\. ¡Un círculo de metal con dientes!"

msgid "@alula_speak A circle... with teeth?!"
msgstr "@alula_speak ¡¿Un círculo... con dientes?!"

msgid "@alula_speak Haha, that sounds so silly!\\>\\nLike something Magpie would have!"
msgstr "@alula_speak ¡Ja, ja! ¡Suena muy gracioso!\\>\\n¡Como algo que Magpie podría tener!"

msgid "@niko Magpie?"
msgstr "@niko ¿Magpie?"

msgid "@alula Y'know, the trader guy!"
msgstr "@alula ¡Ya sabes, el comerciante!"

msgid "@alula He collects all kinds of funny stuff!"
msgstr "@alula ¡Colecciona toda clase de objetos curiosos!"

msgid "@alula_speak I mean, he even keeps around broken glass and junk!"
msgstr "@alula_speak ¡Vamos, hasta se queda con los cristales rotos y la basura!"

msgid "@niko ..."
msgstr "@niko ..."

msgid "@niko_speak ...Oh yeah! \\@niko\\>I think I know who you're talking about."
msgstr "@niko_speak ¡Ah, sí! \\@niko\\>Creo que sé de quién me hablas."

msgid "@alula_speak He's such a weirdo!"
msgstr "@alula_speak ¡Es más raro que un perro verde!"

msgid "@niko It's a fire."
msgstr "@niko Es una hoguera."

