msgid "@niko Jars full of dried fish."
msgstr "@niko Tarros llenos de pescado seco."

msgid "@niko Fireflies light up this room."
msgstr "@niko Las luciérnagas iluminan esta sala."

msgid "@niko It's a book with a clover on the cover."
msgstr "@niko Es un libro con un trébol en la cubierta."

msgid "@calamus_heh I really need to finish this..."
msgstr "@calamus_heh Tengo que acabarlo ya..."

msgid "@niko There's a clover symbol on the cover of this book."
msgstr "@niko La cubierta de este libro tiene el símbolo de un trébol."

msgid "@niko_speak Hey! Just like-"
msgstr "@niko_speak ¡Anda! Igual que..."

msgid "@calamus_speak Oh! My book!"
msgstr "@calamus_speak ¡Oh! ¡Mi libro!"

msgid "@calamus_shame Gosh, I still need to finish studying it..."
msgstr "@calamus_shame Vaya, aún tengo que acabar de estudiármelo..."

msgid "@niko Oh?"
msgstr "@niko Ah, ¿sí?"

msgid "@calamus My friend gave it to me for Solstice Day."
msgstr "@calamus Me lo dio mi amigo por el día del solsticio."

msgid "@calamus_speak He's the one who wrote it, actually!"
msgstr "@calamus_speak ¡En realidad, fue él quien lo escribió!"

msgid "@calamus_smile He's also the one who taught me how to read!"
msgstr "@calamus_smile ¡Y también me enseñó a leer!"

msgid "@niko_speak Oooh!"
msgstr "@niko_speak ¡Hala!"

msgid "@calamus_smile I have a few more of his books somewhere..."
msgstr "@calamus_smile Tengo más libros suyos en algún lado..."

msgid "@niko It's a jar full of worms!"
msgstr "@niko ¡Es un tarro lleno de gusanos!"

msgid "@niko_speak It's a plush toy!"
msgstr "@niko_speak ¡Es un peluche!"

msgid "@niko I have one at home too..."
msgstr "@niko Yo también tengo uno en casa..."

msgid "@niko_83c But mine's an owl and not a fox!"
msgstr "@niko_83c ¡Pero el mío no es un zorro, es un búho!"

msgid "@alula My fox is named Ruby, by the way!"
msgstr "@alula ¡Por cierto, mi zorro se llama Ruby!"

msgid "@alula_speak That's mine! \\>\\@alula Our friend gave it to me last year!"
msgstr "@alula_speak ¡Es mío! \\>\\@alula ¡Me lo dio nuestro amigo el año pasado!"

msgid "@alula_gasp Yeah! He has a fox too!\\nAnd she can even talk!"
msgstr "@alula_gasp ¡Sí! ¡También tiene un zorro!\\n¡Y hasta puede hablar!"

msgid "@niko ...what?"
msgstr "@niko ... ¿Qué?"

msgid "@alula_speak I know! I thought she was the coolest thing ever!"
msgstr "@alula_speak ¿A que sí? ¡A mí me parecía la cosa más chula del mundo!"

msgid "@alula So he got me a fox plush for Solstice Day!"
msgstr "@alula ¡Así que me dio un zorro de peluche el día del solsticio!"

msgid "@niko_speak Oh! That's nice of him!"
msgstr "@niko_speak ¡Vaya! ¡Qué amable por su parte!"

msgid "@alula_speak He's the best!"
msgstr "@alula_speak ¡Es el mejor!"

msgid "@calamus_speak Oh, by the way, what happened to the sun?"
msgstr "@calamus_speak Ah, por cierto, ¿qué le ha pasado al sol?"

msgid "@niko I lent it to someone in the ruins.\\>\\n\\@niko_eyeclosed She said she wanted to feel the sun again, before she..."
msgstr "@niko Se lo dejé a alguien en las ruinas.\\>\\n\\@niko_eyeclosed Me dijo que quería volver a sentir el sol antes de que..."

msgid "@calamus_speak Oh, you must be talking about Maize."
msgstr "@calamus_speak Ah, seguro que te refieres a Maize."

msgid "@niko_speak Is that her name?"
msgstr "@niko_speak ¿Así se llama?"

msgid "@calamus_speak She's a powerful plant spirit. She used to protect the Glen."
msgstr "@calamus_speak Es un poderoso espíritu planta. Solía proteger el Valle."

msgid "@calamus_sad ...but once the sun died, her health rapidly deteriorated."
msgstr "@calamus_sad ... Pero cuando el sol se apagó, su salud empeoró rápidamente."

msgid "@niko_eyeclosed Oh..."
msgstr "@niko_eyeclosed Vaya..."

msgid "@calamus I'm glad you were able to find her in time."
msgstr "@calamus Me alegro de que la encontrases a tiempo."

msgid "@niko_eyeclosed I think we might be already too late to save her..."
msgstr "@niko_eyeclosed Creo que ya es demasiado tarde para salvarla..."

msgid "@calamus_sad I know."
msgstr "@calamus_sad Lo sé."

msgid "@calamus But I'm glad she got to see the sun again."
msgstr "@calamus Pero me alegro de que haya vuelto a ver el sol."

msgid "@calamus I hope the squares don't spread too fast..."
msgstr "@calamus Espero que los cuadrados no se extiendan muy rápido..."

msgid "@niko Jars full of dried moss."
msgstr "@niko Tarros llenos de musgo seco."

msgid "@alula_speak You're here! You're here!"
msgstr "@alula_speak ¡Has venido! ¡Has venido!"

msgid "@alula I'll go get the thing!"
msgstr "@alula ¡Voy a por la cosa!"

msgid "@calamus_smile So uh... welcome to our home!\\>\\n\\@calamus_heh I know it's not much, but...\\>\\n\\@calamus_smile feel free to make yourself comfortable."
msgstr "@calamus_smile Bueno, eh... ¡Te damos la bienvenida a nuestra casa!\\>\\n\\@calamus_heh Sé que no es gran cosa, pero...\\>\\n\\@calamus_smile siéntete como en tu propia casa."

msgid "@alula Ah! There it is!"
msgstr "@alula ¡Ah! ¡Ahí está!"

msgid "@alula_speak Here, we want you to have this!"
msgstr "@alula_speak ¡Toma, queremos que tengas esto!"

msgid "@niko Oh, a feather!\\>\\n\\@niko_speak The edges are glowing yellow!"
msgstr "@niko ¡Oh, una pluma!\\>\\n\\@niko_speak ¡Los bordes tienen un brillo amarillo!"

msgid "@calamus_speak It's a sacred feather from the great Prophet."
msgstr "@calamus_speak Es una pluma sagrada de la Gran Profeta."

msgid "@niko_speak Oh?"
msgstr "@niko_speak Ah, ¿sí?"

msgid "@alula_speak Yeah!"
msgstr "@alula_speak ¡Sí!"

msgid "@alula She's this old lady our dad used to know!"
msgstr "@alula ¡Es una señora anciana que nuestro padre conocía!"

msgid "@alula_gasp Her feathers can glow in the dark and she can see into the future!"
msgstr "@alula_gasp ¡Sus plumas brillan en la oscuridad y es capaz de ver el futuro!"

msgid "@niko_speak What!"
msgstr "@niko_speak ¿Qué?"

msgid "@alula Or... something like that!"
msgstr "@alula O... ¡algo así!"

msgid "@calamus_speak She gave one of her feathers to father before she died."
msgstr "@calamus_speak Le dio una de sus plumas a padre antes de morir."

msgid "@calamus Father wanted to pass this down as an heirloom, although...\\>\\n\\@calamus_smile ...it feels more fitting for you to have it."
msgstr "@calamus Padre quería dejárnosla en herencia, pero...\\>\\n\\@calamus_smile ... me parece mejor que la tengas tú."

msgid "@niko A-are you sure?"
msgstr "@niko ¿Es... Estás segura?"

msgid "@alula_speak Totally sure!"
msgstr "@alula_speak ¡Claro!"

msgid "@calamus I think that's what father would have wanted."
msgstr "@calamus Creo que es lo padre habría querido."

msgid "@niko_speak Thank you!"
msgstr "@niko_speak ¡Gracias!"

msgid "@alula That's the sun!"
msgstr "@alula ¡Eso es el sol!"

msgid "@alula It's a book!"
msgstr "@alula ¡Es un libro!"

msgid "@alula_speak I can't read yet!"
msgstr "@alula_speak Todavía no sé leer."

msgid "@alula Our friend says he'll teach me when I'm older, though!"
msgstr "@alula ¡Pero nuestro amigo dice que me enseñará cuando sea mayor!"

msgid "@alula_speak It's a pretty feather, isn't it?"
msgstr "@alula_speak Es una pluma muy bonita, ¿a que sí?"

msgid "@alula_speak Wooow! \\>That's a pretty necklace!"
msgstr "@alula_speak ¡Hala! \\>¡Qué collar más bonito!"

msgid "@niko The robot lady from the Barrens gave it to me!"
msgstr "@niko ¡Me lo dio la mujer robot de los Baldíos!"

msgid "@alula_gasp You've been to the Barrens?"
msgstr "@alula_gasp ¿Has estado en los Baldíos?"

msgid "@niko_speak Yeah! \\p and I came from there, actually!"
msgstr "@niko_speak ¡Sí! De hecho, \\p y yo venimos de ahí."

msgid "@alula_pout But... I thought you came from another world..."
msgstr "@alula_pout Pero... yo creía que venías de otro mundo..."

msgid "@niko Ah, I just meant we were there first, before we got to the Glen!"
msgstr "@niko Ah, quería decir que hemos estado ahí antes. ¡Antes de venir al Valle!"

msgid "@alula_speak That makes more sense!"
msgstr "@alula_speak ¡Eso tiene más sentido!"

msgid "@alula_speak It's good to be home again!"
msgstr "@alula_speak ¡Me alegro de volver a casa!"

msgid "@niko Jars full of beans."
msgstr "@niko Tarros llenos de judías."

msgid "@niko Fireflies!"
msgstr "@niko ¡Luciérnagas!"

msgid "@niko_eyeclosed Looks like spoiled food."
msgstr "@niko_eyeclosed Parece comida en mal estado."

msgid "@calamus_heh I'll... deal with it later."
msgstr "@calamus_heh Me... ocuparé de eso más tarde."

msgid "@calamus_shame Oh no!"
msgstr "@calamus_shame ¡Oh no!"

msgid "@calamus_heh I guess that's what happens if you leave your house for three days..."
msgstr "@calamus_heh Supongo que eso es lo que pasa cuando te vas de casa tres días..."

msgid "@niko_eyeclosed The back room is full of dust and cobwebs..."
msgstr "@niko_eyeclosed La habitación trasera está llena de polvo y telarañas..."

msgid "@niko It's a fishing pole."
msgstr "@niko Es una caña de pescar."

msgid "@calamus That reminds me, I need to go fishing later..."
msgstr "@calamus Eso me recuerda a que tengo que ir a pescar más tarde..."

msgid "@alula Do you like fish, Niko?"
msgstr "@alula ¿Te gusta el pescado, Niko?"

msgid "@niko_speak Yeah!"
msgstr "@niko_speak ¡Sí!"

msgid "@alula_speak So do we! \\|\\@alula They're good in stews."
msgstr "@alula_speak ¡A nosotras también! \\|\\@alula Está buenísimo en estofados."

msgid "@niko_speak Or soups!"
msgstr "@niko_speak ¡O en sopas!"

msgid "@niko_eyeclosed ...but I know some people back home who like to eat them raw."
msgstr "@niko_eyeclosed ... Aunque sé que hay gente en mi aldea a la que le gusta comerlo crudo."

msgid "@alula_speak Ewww!"
msgstr "@alula_speak ¡Puaj!"

msgid "@niko_eyeclosed Yeup."
msgstr "@niko_eyeclosed Sí."

msgid "@niko Coals."
msgstr "@niko Trozos de carbón."

msgid "@niko They're cold now."
msgstr "@niko Están fríos."

