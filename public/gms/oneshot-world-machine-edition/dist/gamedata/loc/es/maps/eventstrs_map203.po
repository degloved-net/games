msgid "@maize_thisisfine Do not worry.\\>\\nI am fine."
msgstr "@maize_thisisfine No te preocupes.\\>\\nEstoy bien."

msgid "@maize_stress Hello..."
msgstr "@maize_stress Hola..."

msgid "@niko2 I...\\.\\. um...\\> have something to ask of you..."
msgstr "@niko2 Yo...\\.\\. Er...\\>Tengo que pedirte un favor..."

msgid "@maize_thisisfine ...yes?"
msgstr "@maize_thisisfine ¿Sí...?"

msgid "@niko5 It looks like most of the bridges around the Glen are broken, and..."
msgstr "@niko5 Al parecer, la mayoría de los puentes cerca del Valle están rotos, y..."

msgid "@maize_stress ...that's right...\\.\\. the bridges..."
msgstr "@maize_stress ... cierto...\\.\\.los puentes..."

msgid "@maize_stress You...\\.\\. need to cross them on your pilgrimage...."
msgstr "@maize_stress Debes...\\.\\. cruzarlos para tu peregrinaje..."

msgid "@maize_thisisfine ...would you\\.\\. ...like me to fix them?"
msgstr "@maize_thisisfine ¿... Te gustaría\\.\\.... que los reparara?"

msgid "@niko2 Yeah! \\>\\@niko4 Is it possible?"
msgstr "@niko2 ¡Sí! \\>\\@niko4 ¿Es posible?"

msgid "@maize_stress ..."
msgstr "@maize_stress ..."

msgid "@maize_strain ...difficult."
msgstr "@maize_strain ... Complicado."

msgid "@maize_stress ...bridges...\\.\\. are in very specific locations, over water..."
msgstr "@maize_stress ... Los puentes...\\.\\. están situados en emplazamientos específicos, por encima del agua..."

msgid "@maize_strain ...need to find the right points... \\. \\.\\nvines must be very strong, too..."
msgstr "@maize_strain ... Necesitaría encontrar los puntos exactos... \\. \\.\\nY las enredaderas también deben ser muy fuertes..."

msgid "@maize_stress ...an undertaking."
msgstr "@maize_stress ... Todo un desafío."

msgid "@niko_eyeclosed Ah..."
msgstr "@niko_eyeclosed Ah..."

msgid "@maize_stress ...but, possible."
msgstr "@maize_stress ... pero es posible."

msgid "@maize_thisisfine I...\\.\\. intend to use the last of my strength."
msgstr "@maize_thisisfine Intentaré usar...\\.\\. todas las fuerzas que me queden."

msgid "@niko3 ..."
msgstr "@niko3 ..."

msgid "@maize_strain ...please stand back."
msgstr "@maize_strain ... Quedaos atrás."

msgid "@niko_shock ..."
msgstr "@niko_shock ..."

msgid "@niko3 ...what... happened?"
msgstr "@niko3 ... ¿Qué... ha ocurrido?"

msgid "@niko3 Are you okay...?"
msgstr "@niko3 ¿Estás bien...?"

msgid "@niko_distressed_talk ...are you..."
msgstr "@niko_distressed_talk ¿...Tú...?"

msgid "@niko_distressed .\\..\\.."
msgstr "@niko_distressed .\\..\\.."

msgid "@niko_distressed2 .\\..\\.."
msgstr "@niko_distressed2 .\\..\\.."

msgid "@niko_distressed2 ..."
msgstr "@niko_distressed2 ..."

msgid "@maize_stress ...S...\\.\\.savior..."
msgstr "@maize_stress ¿... Sa...\\.\\.Salvador...?"

msgid "@maize_thisisfine ......\\.you're\\.\\. ...here to see me...?"
msgstr "@maize_thisisfine ... \\.¿Has venido\\.\\.... a verme...?"

msgid "@niko_shock ...what... \\.\\@niko3 happened to you?"
msgstr "@niko_shock ... ¿Qué... \\.\\@niko3 te ha ocurrido?"

msgid "@maize_stress ...\\>\\nhold on."
msgstr "@maize_stress ...\\>\\nAguanta."

msgid "@maize_stress ...I.... \\.\\.need to concentrate"
msgstr "@maize_stress ... Necesito...\\.\\.concentrarme."

msgid "@niko2 ...?"
msgstr "@niko2 ¿...?"

msgid "@maize_strain !!!!"
msgstr "@maize_strain ¡¡!!"

msgid "@maize_strain ...the islands... \\.\\.will collapse... \\>if I don't do something..."
msgstr "@maize_strain ... Las islas... \\.\\.se derrumbarán...\\>si no hago algo..."

msgid "@maize_strain ...that's why... \\.\\.the vines..."
msgstr "@maize_strain ... Por eso... \\.\\.las enredaderas..."

msgid "@niko2 ...\\>you're... making the vines grow..."
msgstr "@niko2 ...\\>Estás haciendo... que crezcan las enredaderas..."

msgid "@niko4 ...is that why there are vines everywhere?"
msgstr "@niko4 ... ¿Por eso hay enredaderas por todos lados?"

msgid "@niko3 Are you... \\.\\.trying to hold the land together?"
msgstr "@niko3 ¿Estás intentando... \\.\\.mantener unida la tierra?"

msgid "@maize_stress My powers... the best I could do. Yes."
msgstr "@maize_stress Mis poderes... Lo intento lo mejor que puedo, sí."

msgid "@niko3 That's..."
msgstr "@niko3 Pero eso es..."

msgid "@niko2 Should I leave the sun here for you? \\>\\n\\@niko4 I know you wanted to see it..."
msgstr "@niko2 ¿Quieres que te deje el sol aquí? \\>\\n\\@niko4 Sé que querías verlo..."

msgid "@maize_thisisfine ...tempting... \\>\\nBut I musn't..."
msgstr "@maize_thisisfine ... Tentador... \\>\\nPero no debería..."

msgid "@maize_stress ...the sun brings me comfort, but..."
msgstr "@maize_stress ... El sol me aporta comodidad, pero..."

msgid "@maize_stress Stress is good... for this, fear is good..."
msgstr "@maize_stress El estrés es bueno... Para esto, me viene bien el miedo..."

msgid "@maize_strain ...makes me strong.\\> ...vines grow faster."
msgstr "@maize_strain ... Me hace fuerte. \\>... Las vides crecen más rápido."

msgid "@niko4 But..."
msgstr "@niko4 Pero..."

msgid "@maize_stress If I'm at ease... \\.\\.the vines might retreat."
msgstr "@maize_stress Si estoy en calma... \\.\\.quizás las vides retrocedan."

msgid "@niko4 ..."
msgstr "@niko4 ..."

msgid "@maize_stress They're all in danger, savior..."
msgstr "@maize_stress Todos corren peligro, salvador..."

msgid "@maize_strain The villagers...\\.\\. the children..."
msgstr "@maize_strain Los aldeanos...\\.\\. Los niños..."

msgid "@maize_strain ...my final hours...\\> mustn't go to waste."
msgstr "@maize_strain ... Mis últimas horas...\\>no deben ser en vano."

msgid "@maize_thisisfine The people deserve to live... even if just for another day..."
msgstr "@maize_thisisfine La gente merece vivir... incluso aunque sea un día más..."

