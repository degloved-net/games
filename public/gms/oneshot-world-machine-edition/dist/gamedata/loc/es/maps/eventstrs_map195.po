msgstr "@niko Esto me da mala espina..."

msgid "@niko_speak What do you think, \\p?\\>\\nShould we head back?"
msgstr "@niko_speak ¿Tú qué crees, \\p?\\>\\n¿Volvemos?"

msgid "[\"Let's head back\", \"Continue into the mines\"]"
msgstr "[\"Volvamos\",\"Continuemos por las minas\"]"

msgid "@niko \\p says we should go back."
msgstr "@niko \\p dice que deberíamos volver."

msgid "@silver [Alright.]"
