msgid "@ed [I... do not recognize this place in the protocol.]"
msgstr "@ed [No... reconozco este lugar en el protocolo.]"

msgid "@ed [This...]"
msgstr "@ed [Esto...]"

msgid "@ed [This isn't what I'm supposed to be showing you at all!]"
msgstr "@ed [¡No es para nada lo que debería estar enseñándote!]"

msgid "@ed [How did you get here?]"
msgstr "@ed [¿Cómo has llegado aquí?]"

msgid "@ed [...I can only think of one person.]"
msgstr "@ed [... Solo se me ocurre una persona.]"

msgid "@ed [He... contacted you?]"
msgstr "@ed [¿Se puso en contacto contigo...?]"

msgid "@ed [How long has he been... doing this?]"
msgstr "@ed [¿Cuánto... lleva haciendo esto?]"

msgid "@ed [...]"
msgstr "@ed [...]"

msgid "@ed [...it doesn't matter at this point.]"
msgstr "@ed [... Llegados a este punto, no tiene importancia.]"

msgid "@ed [You are going out of bounds.]"
