msgstr "[26 % COMPLETADO...]"

msgid "[34% COMPLETE...]"
msgstr "[34 % COMPLETADO...]"

msgid "[40% COMPLETE...]"
msgstr "[40 % COMPLETADO...]"

msgid "[100% COMPLETE.]"
msgstr "[100 % COMPLETADO.]"

