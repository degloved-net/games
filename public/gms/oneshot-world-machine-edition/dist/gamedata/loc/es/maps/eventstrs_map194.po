msgid "@proto2b [They actually have fairly limited control of the events.]"
msgstr "@proto2b [En realidad tiene un control bastante limitado sobre los eventos.]"

msgid "@proto2 [The world was built by someone else altogether.]"
msgstr "@proto2 [El mundo fue construido por otra persona distinta.]"

msgid "@proto1c [Someone you cannot begin to fathom.]"
msgstr "@proto1c [Alguien que no puedes ni empezar a comprender.]"

msgid "@proto2b [It was also not designed to be the futile quest that it is now, but...]"
msgstr "@proto2b [Tampoco fue diseñado para ser la aventura inútil que es ahora, pero...]"

msgid "@proto_eyeclosed [...too many things went wrong.]"
msgstr "@proto_eyeclosed [... demasiadas cosas fallaron.]"

msgid "@proto1c [There's... a type of signal disruption that he never expected.]"
msgstr "@proto1c [Hay... un tipo de alteración de señal que jamás esperó.]"

msgid "@proto1b [It's eating away at the world, slowly rendering it into an unrecognizable mess.]"
msgstr "@proto1b [Está consumiendo el mundo, lo está convirtiendo lentamente en un lio irreconocible.]"

msgid "@proto2b [Even if you bring back the sun, it will not go away.]"
msgstr "@proto2b [Incluso si recuperaras el sol, no desaparecerá.]"

msgid "@niko3 The square stuff, isn't it?"
msgstr "@niko3 Los cuadrados, ¿verdad?"

msgid "@niko_eyeclosed I remember those from before..."
msgstr "@niko_eyeclosed Los recuerdo..."

msgid "@proto1b [Then you know what to watch out for.]"
msgstr "@proto1b [Entonces ya sabes con qué tener cuidado.]"

msgid "@proto1c [...The creator knows what might be causing it, but there is nothing that he could do...]"
msgstr "@proto1c [... El creador sabe qué podría estar causándolo, pero no hay nada que pueda hacer...]"

msgid "@proto1 [...until now.]"
msgstr "@proto1 [... Hasta ahora.]"

msgid "@proto1b [You managed to find me, after all.]"
msgstr "@proto1b [Has conseguido encontrarme, después de todo.]"

msgid "@niko2 ...?"
msgstr "@niko2 ¿...?"

msgid "@proto2 [You being here was due to his help.]"
msgstr "@proto2 [Que tú estés aquí ha sido por su ayuda.]"

msgid "@niko2 Oh...\\> I guess it has something to do with the journal?"
msgstr "@niko2 Oh... \\>¿Tiene algo que ver con el diario?"

msgid "@proto1b [Correct.]"
msgstr "@proto1b [Correcto.]"

msgid "@proto1 [Looks like he wants to have one final attempt at fixing it.]"
msgstr "@proto1 [Parece que quiere hacer un último intento por arreglarlo.]"

msgid "@proto2 [...and he might need to do it through you.]"
msgstr "@proto2 [... Y puede que te necesite para conseguirlo.]"

msgid "@proto1b [Niko, do you remember how to get to the Glen?]"
msgstr "@proto1b [Niko, ¿te acuerdas de cómo llegar al Valle?]"

msgid "@proto2 [Whatever you did in your last session, you should stick with it for now.]"
msgstr "@proto2 [Por ahora, deberías hacer lo mismo que en tu última sesión.]"

msgid "@niko4 I..."
msgstr "@niko4 Yo..."

msgid "@niko_eyeclosed I remember a boat..."
msgstr "@niko_eyeclosed Recuerdo una barca..."

msgid "@niko ...more specifically, fixing a robot that drives the boat."
msgstr "@niko ... En concreto, recuerdo arreglar al robot que llevaba la barca."

msgid "@proto2 [Alright, then go do that.]"
msgstr "@proto2 [Muy bien, entonces ve a hacer eso.]"

msgid "@niko3 But..."
msgstr "@niko3 Pero..."

msgid "@niko_eyeclosed The boat robot has those squares over it..."
msgstr "@niko_eyeclosed El robot de la barca está cubierto por cuadrados..."

msgid "@proto_gasp2 ...oh."
msgstr "@proto_gasp2 ... Oh."

msgid "@proto2b [Then do whatever you must to find a new boat.]"
msgstr "@proto2b [Entonces haz lo que sea necesario para encontrar otro barca.]"

msgid "@proto2 [There are plenty of machine parts around the Barrens that can be repurposed.]"
msgstr "@proto2 [Hay muchas piezas de máquina en los Baldíos que se pueden reutilizar.]"

msgid "@niko_upset ...\\>\\n\\@niko_upset2 .........."
msgstr "@niko_upset ...\\>\\n\\@niko_upset2 .........."

msgid "@niko_eyeclosed Sigh..."
msgstr "@niko_eyeclosed Ay..."

msgid "@proto2 [You seem enthusiastic.]"
msgstr "@proto2 [Pareces entusiasmado.]"

msgid "@proto2b [...that was sarcasm.]"
msgstr "@proto2b [... Intentaba ser sarcástico.]"

msgid "@niko_upset Knowing everything isn't real..."
msgstr "@niko_upset Saber que todo esto no es real..."

msgid "@niko_upset2 ...really does make it feel pointless..."
msgstr "@niko_upset2 ... Hace que parezca que no tiene sentido..."

msgid "@proto1b [But you DO want to go home, right?]"
msgstr "@proto1b [Pero, tú QUIERES ir a casa, ¿verdad?]"

msgid "@niko3 Yeah, but..."
msgstr "@niko3 Sí, pero..."

msgid "@niko_distressed2 How will I know that this isn't just another..."
msgstr "@niko_distressed2 ¿Cómo sé que esta no es otra...?"

msgid "@proto2b [Because this session might be the last one.]"
msgstr "@proto2b [Porque esta sesión podría ser la última.]"

msgid "@niko3 ...?"
msgstr "@niko3 ¿...?"

msgid "@proto1c [The creator is mobilizing things, throwing everything into this one last shot.]"
msgstr "@proto1c [El creador está movilizando cosas, usando todo lo que puede para esta última oportunidad.]"

msgid "@proto2b [There might not be enough internal resources left for \\p to be able to generate another session after this.]"
msgstr "@proto2b [Puede que no queden suficientes recursos internos para que \\p pueda generar otra sesión después de esta.]"

msgid "@proto1c [...Just go find a new boat for now.]"
msgstr "@proto1c [... Por ahora ve a buscar otro barca.]"

msgid "@proto1c [...Just go fix the rowbot for now.]"
msgstr "@proto1c [... Por ahora ve a arreglar el remobot.]"

msgid "@proto1b [But please, be careful.]"
msgstr "@proto1b [Pero, por favor, ten cuidado.]"

msgid "@niko3 What about you?"
msgstr "@niko3 ¿Y qué pasa contigo?"

msgid "@proto2 [I will meet you at the docks later.]"
msgstr "@proto2 [Te veré en el muelle más tarde.]"

msgid "@proto2b [...Need to take care of something first.]"
msgstr "@proto2b [... Tengo algo que hacer antes.]"

msgid "@proto2 [...\\>\\nThis disk is blank.]"
msgstr "@proto2 [...\\>\\nEste disco está vacío.]"

msgid "@niko_83c Whoops!"
msgstr "@niko_83c ¡Ups!"

msgid "@proto2 [Please help me restore my memory.\\>\\nBring the disk once you have the backup installed.]"
msgstr "@proto2 [Ayúdame a restaurar mi memoria.\\>\\nTráeme el disco cuando hayas instalado la copia de seguridad.]"

msgid "@proto1b [That was a session.]"
msgstr "@proto1b [Eso era una sesión.]"

msgid "@proto2 [I also tried to tell you about the restriction at the end...]"
msgstr "@proto2 [También intenté hablarte de la restricción al final...]"

msgid "@proto2b [...But you kinda started freaking out.]"
msgstr "@proto2b [... Pero empezaste a desquiciarte.]"

msgid "@niko_upset2 Sorry..."
msgstr "@niko_upset2 Lo siento..."

msgid "@proto1 [Truth is, the session was designed to be run only once.]"
msgstr "@proto1 [Lo cierto es que la sesión fue diseñada para ejecutarse una sola vez.]"

msgid "@proto1b [You weren't supposed to come back to this world after you are done.]"
msgstr "@proto1b [Se supone que no debías volver a este mundo tras terminar.]"

msgid "@proto2b [But... a lot of things that aren't supposed to happen have happened.]"
msgstr "@proto2b [Pero... muchas cosas que no debían ocurrir han ocurrido.]"

msgid "@proto2 [...I'm willing to wager that \\p bypassed the restriction through the progress log failsafe method.]"
msgstr "@proto2 [... Seguro que \\p superó la restricción con el método de registro de progreso a prueba de fallos.]"

msgid "@proto2b [It can restart the session, but it's an easily repeatable process.]"
msgstr "@proto2b [Puede reiniciar la sesión, pero es un proceso fácil de repetir.]"

msgid "@proto2b [...Which means...]"
msgstr "@proto2b [... Lo que significa...]"

msgid "@proto1b [...it's entirely possible that \\p has brought you back more than once, too.]"
msgstr "@proto1b [... Que también es muy posible que \\p te haya traído de vuelta más de una vez.]"

msgid "@proto1c [You may have carried out this mission too many times to count.]"
msgstr "@proto1c [Puede que hayas perdido la cuenta de las veces que has llevado a cabo esta misión.]"

msgid "@proto2b [...might explain why your memories felt like they were from a long time ago.]"
msgstr "@proto2b [... Quizá por eso percibes tus recuerdos como recuerdos muy antiguos.]"

msgid "@niko_upset2 ..."
msgstr "@niko_upset2 ..."

msgid "@niko_upset So...\\.\\. why can \\p... do that...."
msgstr "@niko_upset Entonces...\\.\\. ¿por qué puede \\p... hacer eso...?"

msgid "@proto2 [Shh...]"
msgstr "@proto2 [Shh...]"

msgid "@proto2b [Trying to establish a connection here...]"
msgstr "@proto2b [Estoy intentando establecer una conexión...]"

msgid "@niko_eyeclosed Sorry..."
msgstr "@niko_eyeclosed Lo siento..."

msgid "@silver [Hey, you okay in there?]"
msgstr "@silver [Ey, ¿estás bien?]"

msgid "@silver_eyeclosed [I did what I could with the terminals for now, and...]"
msgstr "@silver_eyeclosed [He hecho lo que he podido por ahora con las terminales, y...]"

msgid "@silver2 [...It's you...]"
msgstr "@silver2 [... Eres tú...]"

msgid "@silver2 [...you're the robot that insisted on living in the mines, are you not?]"
msgstr "@silver2 [... eres el robot que insistió en vivir en las minas, ¿no?]"

msgid "@silver_eyeclosed [My friend told me to keep an eye out for you, should we ever cross paths.]"
msgstr "@silver_eyeclosed [Mi amigo me dijo que tuviera cuidado si me cruzaba contigo.]"

msgid "@proto1b [...Likewise.]"
msgstr "@proto1b [... Igualmente.]"

msgid "@proto1 [...Your...\\.\\. friend gave you something the last time you saw each other.]"
msgstr "@proto1 [... Tu...\\.\\. amigo te dio algo la última vez que os visteis.]"

msgid "@proto1 [Can you show me what it is?]"
msgstr "@proto1 [¿Puedes enseñármelo?]"

msgid "@silver2 [Wait...\\.\\. You know about the amber?]"
msgstr "@silver2 [Espera...\\.\\.¿Sabes lo del ámbar?]"

msgid "@proto2b [I just asked to see it, didn't I?]"
msgstr "@proto2b [Acabo de pedirte que me lo enseñes, ¿no?]"

msgid "@silver2 [Oh, actually...]"
msgstr "@silver2 [Oh, en realidad...]"

msgid "@niko_speak I needed it to fix a robot, so she gave it to me!"
msgstr "@niko_speak ¡Lo necesitaba para arreglar un robot, así que me lo dio!"

msgid "@proto2 [Oh?]"
msgstr "@proto2 [¿Oh?]"

msgid "@niko_speak Here! See?"
msgstr "@niko_speak ¡Toma! ¿Ves?"

msgid "@proto2b [Ah.]"
msgstr "@proto2b [Ah.]"

msgid "@silver2 [Alright... here it is.]"
msgstr "@silver2 [Vale... aquí está.]"

msgid "@proto2b [Thought so.]"
msgstr "@proto2b [Eso pensaba.]"

msgid "@proto2 [He seemed to trust you, so I will treat you as an ally as well.]"
msgstr "@proto2 [Él parecía confiar en ti, así que yo también te trataré como mi aliado.]"

msgid "@silver2 [...Okay?]"
msgstr "@silver2 [... Vale.]"

msgid "@proto1b [Please listen carefully.]"
msgstr "@proto1b [Escucha con atención, por favor.]"

msgid "@proto1 [You need to escort the messiah for the remainder of the Barrens.]"
msgstr "@proto1 [Tienes que escoltar al mesías el resto de los Baldíos.]"

msgid "@proto2b [I predict a high concentration of square particle disruptions in the near future.]"
msgstr "@proto2b [Preveo una alta concentración de alteraciones de cuadrados en el futuro cercano.]"

msgid "@silver2 [...No way.]"
msgstr "@silver2 [... No puede ser.]"

msgid "@proto2b [Yes....\\.\\. way.]"
msgstr "@proto2b [Sí...\\.\\. puede ser.]"

msgid "@proto2 [It's likely that structures in the vicinity of the messiah might be affected.]"
msgstr "@proto2 [Posiblemente afecte a las estructuras cercanas al mesías.]"

msgid "@proto2 [...Making it a far more treacherous pilgrimage than the previous....\\> \\@proto2b er, expectations.]"
msgstr "@proto2 [... Convirtiéndolo en un peregrinaje mucho más traicionero que en las anteriores...\\>\\n\\@proto2b em... expectativas.]"

msgid "@proto1 [\\p and the messiah need all the extra help they can get right now.]"
msgstr "@proto1 [\\p y el mesías necesitan ahora mismo toda la ayuda extra que puedan recibir.]"

msgid "@silver_eyeclosed [Understood.]"
msgstr "@silver_eyeclosed [Entendido.]"

msgid "@niko2 O...\\.\\. okay..."
msgstr "@niko2 V...\\.\\.vale..."

msgid "@silver [Guess we should head back soon.]"
msgstr "@silver [Supongo que deberíamos volver pronto.]"

msgid "@silver_lookup [Even without the squares, the mines are not a safe place to be.]"
msgstr "@silver_lookup [Incluso sin los cuadrados, la minas no son un lugar seguro.]"

msgid "@silver2 [Come on, I'll wait for you outside.]"
msgstr "@silver2 [Vamos, te esperaré afuera.]"

msgid "@niko3 Wait! I want to ask you-"
msgstr "@niko3 ¡Espera! Quiero preguntarte..."

msgid "@niko_eyeclosed She left."
msgstr "@niko_eyeclosed Se ha ido."

msgid "@proto1b [...If you were going to ask her about being \"not real\", save your breath.]"
msgstr "@proto1b [... Si ibas a preguntarle sobre «no ser real», ahórratelo.]"

msgid "@proto1b [None of the people here know their predicament.]"
msgstr "@proto1b [Nadie aquí es consciente de esas cosas.]"

msgid "@proto1c [In fact... I don't think they can even comprehend it.]"
msgstr "@proto1c [De hecho... Ni siquiera creo que sean capaces de comprenderlo.]"

msgid "@proto2 [It would be in your best interest to just... pretend like we never had this conversation.]"
msgstr "@proto2 [Te convendría... fingir... que nunca hemos tenido esta conversación.]"

msgid "@proto2b [Causing mass confusion in the world's residents would likely result in unfavorable conditions for you.]"
msgstr "@proto2b [Provocar una confusión masiva entre los residentes del mundo posiblemente resultaría en condiciones poco favorables para ti.]"

msgid "@niko4 Alright..."
msgstr "@niko4 Vale..."

msgid "@niko3 ...wait, then what about you?"
msgstr "@niko3 ... Un momento, entonces, ¿qué pasa contigo?"

msgid "@niko3 How did YOU know?"
msgstr "@niko3 ¿Cómo lo sabías?"

msgid "@proto2b [...\\.\\.We never had this conversation, remember?]"
msgstr "@proto2b [...\\.\\.No hemos tenido esta conversación, ¿te acuerdas?]"

msgid "@niko_eyeclosed Sigh."
msgstr "@niko_eyeclosed En fin..."

msgid "[MAP RECONFIGURATION SUCCESSFUL.]"
msgstr "[RECONFIGURACIÓN DE MAPA REALIZADA.]"

msgid "@silver [He says the exit is in here, but...]"
msgstr "@silver [Dice que la salida está aquí dentro, pero...]"

msgid "@silver_eyeclosed [...must be hidden.]"
msgstr "@silver_eyeclosed [... Debe estar oculta.]"

msgid "@niko I don't think we need to use this anymore, \\p."
msgstr "@niko No creo que tengamos que volver a usar esto, \\p."

msgid "[PROPHETBOT 0 BACKUP SYSTEM 1.0]\\>\\n[PLEASE INSERT DISK]"
msgstr "[SISTEMA DE COPIA DE SEGURIDAD 1.0 DE PROFETABOT 0]\\>\\n[INSERTAR DISCO]"

msgid "@niko Alright..."
msgstr "@niko Vale..."

msgid "\\c[1][ERROR: BACKUP REQUEST DENIED]\\c[0]"
msgstr "\\c[1][ERROR: SOLICITUD DE COPIA DE SEGURIDAD DENEGADA]\\c[0]"

msgid "@niko_speak What?"
msgstr "@niko_speak ¿Qué?"

msgid "[DORMITORY ASSIGNMENTS ARE NOT UP TO DATE.]"
msgstr "[LA ASIGNACIÓN DE DORMITORIOS NO ESTÁ ACTUALIZADA.]"

msgid "[PLEASE CONFIGURE THE RESIDENTIAL TRACKING MACHINE TO CONTINUE.]"
msgstr "[CONFIGURA LA MÁQUINA DE SEGUIMIENTO RESIDENCIAL PARA CONTINUAR.]"

msgid "@niko_eyeclosed Okay then!"
msgstr "@niko_eyeclosed ¡Pues vale!"

msgid "[PREPARING BACKUP...]\\>\\n[WRITING TO DISK...]\\>\\n"
msgstr "[PREPARANDO COPIA DE SEGURIDAD...]\\>\\n[ESCRIBIENDO EN DISCO...]\\>\\n"

