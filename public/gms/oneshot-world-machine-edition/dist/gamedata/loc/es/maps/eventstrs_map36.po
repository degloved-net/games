msgid "@niko The fireflies light up this room."
msgstr "@niko Las luciérnagas iluminan esta sala."

msgid "Can you see \\p, too?"
msgstr "¿También puedes ver a \\p?"

msgid "@niko_speak Nope! \\@niko I can only hear their voice in my head."
msgstr "@niko_speak ¡No! \\@niko Solo puedo oír su voz en mi cabeza."

msgid "@alula_gasp That's still really cool!"
msgstr "@alula_gasp ¡Pero eso también es muy guay!"

msgid "Daddy says the world is very sick.\\nBut \\p can make it better again!"
msgstr "Papá dice que el mundo está muy enfermo.\\n¡Pero \\p puede curarlo!"

msgid "...Are you \\p?"
msgstr "...¿Tú eres \\p?"

msgid "@niko Uh... not really.\\nI'm just the \"messiah\" they sent."
msgstr "@niko Eh... no.\\nSolo soy el \"mesías\" que han enviado."

msgid "@niko_speak I can talk with \\p, though!"
msgstr "@niko_speak ¡Aunque puedo hablar con \\p!"

msgid "Wow!"
msgstr "¡Guau!"

msgid "@alula_gasp Double wow!"
msgstr "@alula_gasp ¡Doble guau!"

msgid "What's that like?"
msgstr "¿Y qué tal es eso?"

msgid "@niko_speak Really cool!"
msgstr "@niko_speak ¡Qué guay!"

msgid "@niko Fish heads and tails."
msgstr "@niko Cabezas y colas de pescado."

