msgstr "@niko  ¡Me gustaría saber cómo ir hasta la superficie!"
msgid "@plight_2 ...yeeahh... I was afraid you were gonna say that..."
msgstr "@plight_2 Yaaa... Temía que me preguntaras eso..."
