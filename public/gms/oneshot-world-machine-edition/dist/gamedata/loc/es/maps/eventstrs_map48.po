msgstr "@niko_yawn *Uaaa*..."
msgid "@niko I'm having trouble staying awake, \\p.\\>\\nWe should find a place for me to take a nap..."
msgstr "@niko Me está costando no dormirme, \\p.\\>\\nDeberíamos encontrar un lugar en el que echar una siesta..."
msgid "@niko_speak Oh! Thank you for holding the elevator door open for me, mister!"
msgstr "@niko_speak ¡Ah! Gracias por sujetarme la puerta del ascensor, señor."
msgid "@plight No prob, hop in."
msgstr "@plight No es nada. Pasa."
