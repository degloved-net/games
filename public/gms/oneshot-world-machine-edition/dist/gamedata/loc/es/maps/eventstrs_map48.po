msgstr "@plight_unknown Por... qué... no... ¡¿FUNCIONAAA?!"
msgid "@niko_speak ...I..."
msgstr "@niko_speak Creo..."
msgid "@niko_speak ....think someone might need help."
msgstr "@niko_speak que alguien necesita ayuda..."
msgid "PATH CLOSED"
msgstr "RUTA CERRADA"
msgid "TO: OFFICE"
msgstr "A: OFICINA"
msgid "@plight Come oonnn..."
msgstr "@plight Vaaamos..."
msgid "@plight Come oonnnnnnn!"
msgstr "@plight ¡Vaaamosss...!"
msgid "@plight I'm too busy for this!"
msgstr "@plight ¡Tengo cosas que hacer!"
msgid "@niko ...Uh"
msgstr "@niko ... Eh"
msgid "@niko_speak ....Excuse me..."
msgstr "@niko_speak ... Disculpa..."
