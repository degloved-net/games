msgid "@niko Something is poking out from this shelf."
msgstr "@niko Hay algo que destaca en este estante."

msgid "@niko_speak Ah... it's a screwdriver."
msgstr "@niko_speak Ah... Es un destornillador."

msgid "@silver [You can take it if you want. It may help you.]"
msgstr "@silver [Puedes cogerlo si quieres. Podría serte de ayuda.]"

msgid "@niko Oh! Are you sure?"
msgstr "@niko ¡Oh! ¿Estás segura?"

msgid "@silver [Yes. I have many.]"
msgstr "@silver [Sí. Tengo muchos.]"

msgid "@niko Thank you!"
msgstr "@niko ¡Gracias!"

msgid "@niko It's a photo of two people."
msgstr "@niko Es una foto de dos personas."

msgid "@niko The glass is a bit too foggy to see details, though."
msgstr "@niko Pero el cristal está demasiado empañado como para ver los detalles."

msgid "@niko There's lots of tiny glowing shrimp swimming in this jar."
msgstr "@niko En este tarro hay muchos camarones diminutos luminiscentes nadando."

msgid "@niko And lots of tiny shrimp that aren't glowing..."
msgstr "@niko Y muchos camarones diminutos que no brillan..."

msgid "@niko_eyeclosed ...or swimming..."
msgstr "@niko_eyeclosed ... ni nadan..."

msgid "@silver2 [No way! I just refilled that two days ago!]"
msgstr "@silver2 [¡No puede ser! ¡Lo rellené hace tan solo dos días!]"

msgid "@silver_eyeclosed [Guess I'll make a trip to the shore later...]"
msgstr "@silver_eyeclosed [Supongo que más tarde haré una excursión a la costa...]"

msgid "@silver_eyeclosed [These jars don't last very long.]"
msgstr "@silver_eyeclosed [Estos tarros no duran mucho tiempo.]"

msgid "@niko A jar full of glowing shrimp."
msgstr "@niko Un tarro lleno de camarones luminiscentes."

msgid "@silver2 [Oh, it's that journal you showed me in the mines.]"
msgstr "@silver2 [Oh, es aquel diario que me enseñaste en las minas.]"

msgid "@silver [Doesn't look like it's glowing anymore, though.]"
msgstr "@silver [Aunque parece que ya no brilla.]"

msgid "@niko Do you know what I'm supposed to do with it?"
msgstr "@niko ¿Sabes qué tengo que hacer con él?"

msgid "@silver2 [I am unsure, but...]"
msgstr "@silver2 [No estoy segura, pero...]"

msgid "@silver [...hold on to the journal for now.]"
msgstr "@silver [... No te deshagas del diario por ahora.]"

msgid "@silver [It will be important.]"
msgstr "@silver [Será importante.]"

msgid "@niko O...kay..."
msgstr "@niko Va... le..."

msgid "@niko Excuse me, miss..."
msgstr "@niko Perdone, señorita..."

msgid "@niko_speak I found this book.\\nDo you know anything about it?"
msgstr "@niko_speak Me he encontrado este libro.\\n¿Sabe algo de él?"

msgid "@silver [Let me see.\\..\\..]"
msgstr "@silver [A ver.\\..\\..]"

msgid "@silver2 [What language is this...?]"
msgstr "@silver2 [¿Qué idioma es este?]"

msgid "@silver_eyeclosed [I'm sorry, I... don't even recognize this writing system.]"
msgstr "@silver_eyeclosed [Lo siento, ni siquiera reconozco este sistema de escritura.]"

msgid "@niko Ah, well, it was worth a shot."
msgstr "@niko Bueno, tenía que intentarlo."

msgid "@silver2 [Although... this insignia.]"
msgstr "@silver2 [Aunque... esta insignia.]"

msgid "@silver [...]"
msgstr "@silver [...]"

msgid "@silver [Off you go...]"
msgstr "@silver [Vete...]"

msgid "@silver [There's no reason for you to linger in the Barrens.]"
msgstr "@silver [No hay motivo para que permanezcas en los Baldíos.]"

msgid "@niko_speak Excuse me again, miss..."
msgstr "@niko_speak Perdone de nuevo, señorita..."

msgid "@niko_speak I found a robot who can take me towards the Tower!"
msgstr "@niko_speak ¡He encontrado un robot que puede llevarme a la Torre!"

msgid "@niko_eyeclosed ...but it's having some trouble, so it told me to talk to you."
msgstr "@niko_eyeclosed ... Pero le pasa algo, así que me pidió que hablara con usted."

msgid "@silver [Alright.\\>\\nWhat is the issue?]"
msgstr "@silver [De acuerdo.]\\>\\n[¿Qué sucede?]"

msgid "@niko It said something about its navigation circuits being fried."
msgstr "@niko Ha dicho algo de que sus circuitos de navegación se están friendo."

msgid "@silver2 [Just the navigation circuits?]"
msgstr "@silver2 [¿Solo los circuitos de navegación?]"

msgid "@niko_speak Apparently!\\>\\n\\@niko \\p and I fixed everything else, I think..."
msgstr "@niko_speak ¡Sí, eso parece!\\n\\>\\@niko \\p y yo hemos arreglado el resto, creo..."

msgid "@silver [Hm...]"
msgstr "@silver [Mmm...]"

msgid "@silver [I have something that may help.]"
msgstr "@silver [Tengo algo que podría ayudar.]"

msgid "@silver_lookup [Rowbots have the ability to trace material from their source locations.]"
msgstr "@silver_lookup [Los remobots tienen la habilidad de rastrear materiales desde su ubicación de origen.]"

msgid "@silver [If you let the rowbot borrow this, then its backup tracking system should activate.]"
msgstr "@silver [Si le das esto al remobot, su sistema auxiliar de rastreo debería activarse.]"

msgid "@niko_speak That's a very pretty necklace!"
msgstr "@niko_speak ¡Qué collar más bonito!"

msgid "@niko What's it made of?"
msgstr "@niko ¿De qué está hecho?"

msgid "@silver_lookup [Amber found from the Glen.]"
msgstr "@silver_lookup [Es ámbar del Valle.]"

msgid "@niko What's the thing inside the amber?"
msgstr "@niko ¿Qué es lo que hay dentro del ámbar?"

msgid "@silver2 [The black clover?\\>\\n\\@silver That's a common plant in our world.]"
msgstr "@silver2 [¿El trébol negro? \\>\\n\\@silver Es una planta común en nuestro planeta.]"

msgid "@silver_lookup [It's also...]"
msgstr "@silver_lookup [También es...]"

msgid "@niko ?"
msgstr "@niko ¿?"

msgid "@silver_eyeclosed [Sigh... I'm not sure if I can bear to part with this.]"
msgstr "@silver_eyeclosed [Ay... No sé si podré soportar desprenderme de esto.]"

msgid "@silver_eyeclosed [My programming says yes, but I still feel conflicted.]"
msgstr "@silver_eyeclosed [Mi programación me dice que sí, pero aún así siento un conflicto.]"

msgid "@niko ...?"
msgstr "@niko ¿...?"

msgid "@silver_eyeclosed [Nevermind.]"
msgstr "@silver_eyeclosed [Da igual.]"

msgid "@silver_eyeclosed [You need to finish your mission more than I need a keepsake.]"
msgstr "@silver_eyeclosed [Es más importante para ti terminar la misión que para mí tener un recuerdo.]"

msgid "@silver [Here.]"
msgstr "@silver [Toma.]"

msgid "@niko_speak Oh, thank you!"
msgstr "@niko_speak ¡Ah, gracias!"

msgid "@silver [Do you need further assistance?]"
msgstr "@silver [¿Necesitas más ayuda?]"

msgid "@niko We're good, thanks!"
msgstr "@niko ¡No, gracias!"

msgid "@niko_speak What's inside the Tower?"
msgstr "@niko_speak ¿Qué hay dentro de la Torre?"

msgid "@silver_lookup [I don't know. Nobody's ever entered it before.]"
msgstr "@silver_lookup [No lo sé. Nadie ha entrado nunca.]"

msgid "@silver [At least, nobody history knows.]"
msgstr "@silver [Al menos, nadie conocido en la historia.]"

msgid "@niko Then... who built it?"
msgstr "@niko Entonces... ¿quién la construyó?"

msgid "@silver2 [Built?]"
msgstr "@silver2 [¿Construyó?]"

msgid "@silver [As far as anyone can tell, it's been there since the beginning of time.]"
msgstr "@silver [Hasta donde se conoce, lleva ahí desde el origen de los tiempos.]"

msgid "@silver [I know someone who wanted to study it before, but...]"
msgstr "@silver [Conozco a alguien que quiso estudiarla, pero...]"

msgid "@silver_eyeclosed [...]"
msgstr "@silver_eyeclosed [...]"

msgid "@niko Oh?"
msgstr "@niko Ah, ¿sí?"

msgid "@silver [He never told me if it went anywhere.]"
msgstr "@silver [Nunca me dijo si fue.]"

msgid "@silver2 [The lightbulb...]"
msgstr "@silver2 [La bombilla...]"

msgid "@silver2 [So, are you the \"messiah\"?]"
msgstr "@silver2 [Entonces, ¿tú eres el \"mesías\"?]"

msgid "@niko That's what I've been told."
msgstr "@niko Eso me han dicho."

msgid "@silver [I expected someone... taller.]"
msgstr "@silver [Me esperaba a alguien más... alto.]"

msgid "@silver_eyeclosed [Or at least someone that doesn't look like a kitten.]"
msgstr "@silver_eyeclosed [O, al menos, alguien que no parezca un gatito.]"

msgid "@silver [That's what you are, right? Some sort of cat?]"
msgstr "@silver [Eso es lo que eres, ¿verdad? ¿Algún tipo de gato?]"

msgid "@niko Nuh-uh!"
msgstr "@niko ¡No, no!"

msgid "@niko_speak I'm a person!"
msgstr "@niko_speak ¡Soy una persona!"

msgid "@silver [You got the eyes of a cat...]"
msgstr "@silver [Tienes ojos de gato...]"

msgid "@niko_speak But cats walk on four legs!"
msgstr "@niko_speak ¡Pero los gatos andan a cuatro patas!"

msgid "@silver_eyeclosed [Well, either way...]"
msgstr "@silver_eyeclosed [Bueno, da igual...]"

msgid "@silver_lookup [A child like you being the messiah... just doesn't feel right.]"
msgstr "@silver_lookup [Que una criatura como tú sea el mesías... no me da buena espina.]"

msgid "@niko_eyeclosed But that robot back there says there's no mistake..."
msgstr "@niko_eyeclosed Pero ese robot de ahí dice que no hay equivocación..."

msgid "@silver [I know.]"
msgstr "@silver [Lo sé.]"

msgid "@silver_eyeclosed [...sigh.]"
msgstr "@silver_eyeclosed [... Ay.]"

msgid "@silver_eyeclosed [This is going to sound cold, but...]"
msgstr "@silver_eyeclosed [Esto va a sonar frío, pero...]"

msgid "@silver_lookup [I honestly think you are better off just... leaving and letting the world die naturally.]"
msgstr "@silver_lookup [Sinceramente, creo que sería mejor que... te marchases y dejases al mundo morir de forma natural.]"

msgid "@silver [The world has been falling apart for a long time.]"
msgstr "@silver [El mundo lleva mucho tiempo destruyéndose.]"

msgid "@silver_eyeclosed [This manner of decay... It's highly unprobable that the sun can fix it.]"
msgstr "@silver_eyeclosed [Este tipo de decadencia... es muy improbable que el sol pueda arreglarla.]"

msgid "@silver [You've already seen how bad it can get, right?]"
msgstr "@silver [Ya has visto lo terrible que puede llegar a ser, ¿no?]"

msgid "@niko We... haven't seen much of anything, actually..."
msgstr "@niko No... no hemos visto mucho aún, en realidad..."

msgid "@niko_eyeclosed And we can't really just leave..."
msgstr "@niko_eyeclosed Y tampoco podemos marcharnos realmente..."

msgid "@silver2 [Oh, so you just got here?]"
msgstr "@silver2 [Ah, ¿entonces acabas de llegar?]"

msgid "@silver [Then you must be headed towards the Tower.]"
msgstr "@silver [Entonces seguro que te diriges a la Torre.]"

msgid "@niko M-hm!"
msgstr "@niko ¡Ajá!"

msgid "@niko It's where I'm supposed put the lightbulb... er, sun, isn't it?"
msgstr "@niko Es donde se supone que debo poner la bombilla... eh, sol, ¿no?"

msgid "@silver [Yes, at the very top.]"
msgstr "@silver [Sí, en lo más alto.]"

msgid "@silver_lookup [We know that the Tower contains a force that nobody could comprehend.]"
msgstr "@silver_lookup [Sabemos que la Torre alberga una fuerza que nadie puede comprender.]"

msgid "@silver_lookup [And the power is strongest at the summit.]"
msgstr "@silver_lookup [Y el poder se vuelve más fuerte en lo más alto.]"

msgid "@silver [Maybe it will send you back home after you complete your mission.]"
msgstr "@silver [Puede que te envíe de regreso a casa una vez hayas completado la misión.]"

msgid "@niko_pancakes Oh!"
msgstr "@niko_pancakes ¡Vaya!"

msgid "@silver_eyeclosed [Don't take my word for it, though.]"
msgstr "@silver_eyeclosed [Aunque tampoco me hagas mucho caso.]"

msgid "@niko Before I go...\\. Is there anything I can do in return?"
msgstr "@niko Antes de que me vaya...\\. ¿hay algo que pueda hacer a cambio?"

msgid "@silver [Actually...]"
msgstr "@silver [En realidad...]"

msgid "@silver2 [Do you...\\.\\. know how to play chess?]"
msgstr "@silver2 [¿Sabes... \\.\\. jugar al ajedrez?]"

msgid "@niko_speak Yeah!\\>\\n\\@niko Well, sort of..."
msgstr "@niko_speak ¡Sí!\\n\\>\\@niko Bueno, más o menos..."

msgid "@niko_speak I've played it with some older kids before!"
msgstr "@niko_speak ¡He jugado con otros niños mayores!"

msgid "@silver [Then, will you play a game with me?]"
msgstr "@silver [Entonces, ¿quieres echar una partida conmigo?]"

msgid "@niko_eyeclosed I mean, I don't know the rules very well...."
msgstr "@niko_eyeclosed Bueno, no conozco muy bien las reglas..."

msgid "@niko_speak But I guess it's the least I could do!"
msgstr "@niko_speak ¡Pero creo que es lo menos que podría hacer!"

msgid "@niko You're really good at this!"
msgstr "@niko ¡Se te da muy bien esto!"

msgid "@silver [Thank you.\\>\\n\\@silver2 It was built into my code.]"
msgstr "@silver [Gracias.]\\>\\n\\@silver2 [Lo integraron en mi código.]"

msgid "@niko Ah."
msgstr "@niko Ah."

msgid "@niko So....\\> \\@niko_speak What's it like?\\>\\n\\@niko Being a robot and all..."
msgstr "@niko Y... \\>\\@niko_speak ¿Cómo es?\\>\\n\\@niko Ser un robot y eso..."

msgid "@niko I've talked to other robots, and they all say something about programming and code and stuff."
msgstr "@niko He hablado con otros robots y todos me dicen cosas de programación, códigos y tal..."

msgid "@niko_speak Even you did, just now!"
msgstr "@niko_speak ¡En fin, tú lo acabas de hacer ahora mismo!"

msgid "@niko_eyeclosed It's a little hard to understand sometimes."
msgstr "@niko_eyeclosed A veces, es un poco difícil de comprender."

msgid "@silver_eyeclosed [Most of the robots here are not tamed.]"
msgstr "@silver_eyeclosed [La mayoría de estos robots no están domados.]"

msgid "@niko_speak Tamed?"
msgstr "@niko_speak ¿Domado?"

msgid "@silver [Watch out.]"
msgstr "@silver [Cuidado.]"

msgid "@niko_what ...\\.\\.there goes my bishop..."
msgstr "@niko_what ...\\.\\. Ahí va mi alfil..."

msgid "@silver [Taming...\\.\\. is complicated.]"
msgstr "@silver [Domar... \\.\\. es complicado.]"

msgid "@niko_speak How complicated, exactly?"
msgstr "@niko_speak ¿Cómo de complicado, exactamente?"

msgid "@niko_eyeclosed ...\\.\\.there goes my other bishop..."
msgstr "@niko_eyeclosed ...\\.\\. Ahí va mi otro alfil..."

msgid "@silver_lookup [I can't really explain what tamed robots are.]"
msgstr "@silver_lookup [No sé explicar realmente lo que son los robots domados.]"

msgid "@silver [But I'm one of them.]"
msgstr "@silver [Pero yo soy uno de ellos.]"

msgid "@silver_lookup [All the other tamed robots have been moved to other regions.]"
msgstr "@silver_lookup [Al resto de robots domados se los han llevado a otras regiones.]"

msgid "@silver_eyeclosed [Exactly where, I don't know.]"
msgstr "@silver_eyeclosed [Exactamente a donde, no lo sé.]"

msgid "@niko_what ...\\.\\.there goes my little horse..."
msgstr "@niko_what ...\\.\\. Ahí va mi caballito..."

msgid "@silver [Knight.]"
msgstr "@silver [Caballo.]"

msgid "@niko_eyeclosed Right..."
msgstr "@niko_eyeclosed Ya..."

msgid "@niko_speak Oh! Have you ever been to any other regions?\\>\\n\\@niko I heard that there's two more."
msgstr "@niko_speak ¡Ah! ¿Has estado alguna vez en las otras regiones?\\n\\>\\@niko He oído que hay dos más."

msgid "@silver [In the past, yes.]"
msgstr "@silver [Sí, en el pasado.]"

msgid "@silver_eyeclosed [I still have the data, the coordinates,\\. the memories...]"
msgstr "@silver_eyeclosed [Aún conservo los datos, las coordenadas,\\. los recuerdos...]"

msgid "@silver_eyeclosed [...I don't know how much of that still holds true.]"
msgstr "@silver_eyeclosed [... No sé cuanto seguirá siendo verdad.]"

msgid "@silver [The world may be a very different place now.]"
msgstr "@silver [Puede que el mundo sea un lugar muy diferente ahora.]"

msgid "@niko Because the sun is gone?"
msgstr "@niko ¿Porque el sol ya no está?"

msgid "@silver [No.]"
msgstr "@silver [No.]"

msgid "@silver2 [I said this already, didn't I?]"
msgstr "@silver2 [Ya te lo he dicho, ¿no?]"

msgid "@silver [The sun probably won't save the world.]"
msgstr "@silver [Probablemente, el sol no salve el mundo.]"

msgid "@silver_lookup [The decaying started back before the sun went out.]"
msgstr "@silver_lookup [La decadencia comenzó antes de que el sol desapareciese.]"

msgid "@silver_eyeclosed [The sun's sudden death was just the tipping point, and things went south really fast after that.]"
msgstr "@silver_eyeclosed [La repentina muerte del sol era solo la punta del iceberg; todo empezó a ir muy rápido después.]"

msgid "@niko Oh..."
msgstr "@niko Vaya..."

msgid "@niko_eyeclosed Then... there's nothing I can do?"
msgstr "@niko_eyeclosed Entonces... ¿no hay nada que pueda hacer?"

msgid "@silver [Check.]"
msgstr "@silver [Jaque.]"

msgid "@niko_speak W-what!"
msgstr "@niko_speak ¿Có... cómo?"

msgid "@niko_eyeclosed When did your queen get there..."
msgstr "@niko_eyeclosed ¿Cuándo ha llegado su reina ahí...?"

msgid "@silver [The only thing you can do is complete your pilgrimage.]"
msgstr "@silver [Lo único que puedes hacer es completar tu peregrinación.]"

msgid "@silver_lookup [In a way, you are only supposed to be a second chance for the people.]"
msgstr "@silver_lookup [En cierto modo, se supone que eres como una segunda oportunidad para la gente.]"

msgid "@silver [Just like how the Barrens was only supposed to be a second chance for me.]"
msgstr "@silver [Al igual que los Baldíos debían ser una segunda oportunidad para mí.]"

msgid "@silver_eyeclosed [There's no guarantee that things will work out.]"
msgstr "@silver_eyeclosed [No hay garantía de que las cosas vayan a funcionar.]"

msgid "@niko But..."
msgstr "@niko Pero..."

msgid "@silver [Checkmate.]"
msgstr "@silver [Jaque mate.]"

msgid "@niko ..."
msgstr "@niko ..."

msgid "@silver_eyeclosed [Alright, guess I've kept you long enough...]"
msgstr "@silver_eyeclosed [Bueno, creo que ya te he entretenido bastante...]"

msgid "@silver [...Thank you for listening.]"
msgstr "@silver [... Gracias por escucharme.]"

msgid "@silver [I hope you get home safely.]"
msgstr "@silver [Espero que llegues a casa sano y salvo.]"

msgid "@niko Ah, thank you also!"
msgstr "@niko ¡Ah, gracias a ti también!"

msgid "@silver [Please do not touch that.]"
msgstr "@silver [No toques eso, por favor.]"

msgid "@niko_speak Oh!"
msgstr "@niko_speak ¡Vaya!"

msgid "@niko_eyeclosed Sorry... I got curious..."
msgstr "@niko_eyeclosed Perdón... Era por curiosidad..."

msgid "@niko ...what is this thing?"
msgstr "@niko ... ¿Qué es?"

msgid "@silver [Back-up power cell. It keeps me functional.]"
msgstr "@silver [Una batería de reserva. Me mantiene en funcionamiento.]"

msgid "@silver_lookup [The main generator for the Barrens ran out of power some time ago.]"
msgstr "@silver_lookup [El generador principal de los Baldíos se quedó sin energía hace algún tiempo.]"

msgid "@silver_eyeclosed [It could not even last a week without the sun.]"
msgstr "@silver_eyeclosed [No duró ni una semana sin el sol.]"

msgid "@niko_eyeclosed Sorry to hear that..."
msgstr "@niko_eyeclosed Lo siento..."

msgid "@silver_lookup [All we can do is make use of the light we have.]"
msgstr "@silver_lookup [Lo único que podemos hacer es aprovechar la luz que tenemos.]"

msgid "@niko This is some kind of power cell, apparently!"
msgstr "@niko ¡Parece una especie de batería!"

msgid "@niko The word \"SILVER\" is written on the side."
msgstr "@niko La palabra \"SILVER\" está escrita en un lado."

msgid "@niko_speak Why does it say that?"
msgstr "@niko_speak ¿Por qué pone eso?"

msgid "@silver_eyeclosed [That's not important.]"
msgstr "@silver_eyeclosed [No es importante.]"

msgid "@niko Okay..."
msgstr "@niko Está bien..."

msgid "@niko_what Ow!"
msgstr "@niko_what ¡Ay!"

msgid "@niko I got shocked..."
msgstr "@niko Me ha dado calambre..."

msgid "@silver_eyeclosed [I told you not to touch it...]"
msgstr "@silver_eyeclosed [Te dije que no la tocaras...]"

msgid "@niko_eyeclosed \\p made me."
msgstr "@niko_eyeclosed \\p me ha obligado."

msgid "@niko_eyeclosed I'm not falling for that one again, \\p..."
msgstr "@niko_eyeclosed No pienso volver a caer, \\p..."

msgid "@niko Some sort of small machine."
msgstr "@niko Una especie de máquina pequeña."

msgid "@niko I wonder what it does?"
msgstr "@niko Me pregunto qué hará."

msgid "@niko_speak I can feel my hair standing up a little..."
msgstr "@niko_speak Noto cómo se me eriza el pelo un poco..."

msgid "$Dear Silver,"
msgstr "$Querida Silver:"

msgid "$I heard the news about the mines."
msgstr "$Me he enterado de lo que ha pasado en las minas."

msgid "$I'm sorry... I can't imagine what you're feeling."
msgstr "$Lo siento... No soy capaz de imaginarme cómo te sientes."

msgid "$It's been two weeks..."
msgstr "$Han pasado dos semanas..."

msgid "$I know it must be hard, but maybe it's better that you came back..."
msgstr "$Sé que debe ser duro, pero tal vez sea mejor que regreses..."

msgid "$It's only a matter of time before the rowbots are recalled."
msgstr "$Solo es cuestión de tiempo el que retiren a los remobots."

msgid "$At least let me know you got my message, okay?"
msgstr "$Dime al menos que has recibido mi mensaje, ¿de acuerdo?"

msgid "$-Kip"
msgstr "$-Kip"

msgid "@niko The top is covered with a wire mesh."
msgstr "@niko La tapa tiene una rejilla de alambre."

msgid "@niko It's a crate."
msgstr "@niko Es una caja."

msgid "@niko The chess table has 2 small chairs."
msgstr "@niko La mesa de ajedrez tiene 2 sillas pequeñas."

msgid "@niko A chess table.\\>\\nIt's not dusty anymore."
msgstr "@niko Una mesa de ajedrez.\\>\\nYa no tiene polvo."

msgid "@niko A dusty chess table."
msgstr "@niko Una mesa de ajedrez polvorienta."

msgid "@niko It's a metal chess table covered in dust."
msgstr "@niko Es una mesa de ajedrez de metal llena de polvo."

msgid "@silver [I haven't played chess with anyone else for a very long time.]"
msgstr "@silver [Hace mucho tiempo que no juego con nadie más al ajedrez.]"

msgid "@niko_speak Not even...\\.\\. with the other robots?"
msgstr "@niko_speak ¿Ni siquiera... \\.\\. con los otros robots?"

msgid "@silver_eyeclosed [No.]\\>\\n\\@silver [Nobody in the Barrens have that capacity in their programming.]"
msgstr "@silver_eyeclosed [No.]\\>\\n\\@silver [En los Baldíos no hay nadie programado para ello.]"

msgid "@silver_eyeclosed [Nobody here is tamed, for that matter.]"
msgstr "@silver_eyeclosed [Nadie está adiestrado para esa cuestión.]"

msgid "@niko A bed."
msgstr "@niko Una cama."

msgid "@niko_speak It's made of metal...?"
msgstr "@niko_speak ¿Es de metal...?"

msgid "@niko_eyeclosed Doesn't look very comfortable..."
msgstr "@niko_eyeclosed No parece muy cómoda..."

msgid "@niko A shelf of weird tools and pieces of metal."
msgstr "@niko Un estante con herramientas raras y trozos de metal."

msgid "@niko Lots of tiny shrimp are swimming in this jar."
msgstr "@niko En este tarro hay muchos camarones diminutos nadando."

