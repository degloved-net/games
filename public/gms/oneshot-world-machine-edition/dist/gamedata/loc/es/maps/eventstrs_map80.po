msgstr "[ESO ES ERRÓNEO.]"

msgid "[ROBOTS DO NOT CONSUME BATTERIES IN THE SAME WAY PEOPLE CONSUME FOOD.]"
msgstr "[LOS ROBOTS NO CONSUMEN BATERÍAS DE LA MISMA FORMA EN QUE LA GENTE CONSUME COMIDA.]"

msgid "[IN FACT, ROBOTS DO NOT POSSESS DIGESTIVE SYSTEMS.]"
msgstr "[DE HECHO, LOS ROBOTS NO CUENTAN CON SISTEMAS DIGESTIVOS]"

msgid "[SOME ROBOTS DO NOT EVEN HAVE MOUTHS.]"
