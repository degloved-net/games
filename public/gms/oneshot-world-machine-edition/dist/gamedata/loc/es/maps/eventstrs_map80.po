msgstr "[\"¡Intenta hablar como un robot!\"]"

msgid "@niko um..."
msgstr "@niko Mmm..."

msgid "@niko_eyeclosed *ahem*"
msgstr "@niko_eyeclosed *ejem*"

msgid "@niko [BEEEP BOOP]"
