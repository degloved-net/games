msgid "@niko_speak I mean, I see them in cartoons and stuff, but I've never seen one in person!"
msgstr "@niko_speak A ver, los he visto en los dibujos y eso, ¡pero nunca en persona!"

msgid "@niko They're pretty neat, don't you think?"
msgstr "@niko Son muy guays, ¿no crees?"

msgid "[\"Yeah.\", \"Hey Niko do a robot voice\"]"
msgstr "[\"Sí.\",\"Oye, Niko, pon voz de robot.\"]"

msgid "@niko Yeah!"
msgstr "@niko ¡Sí!"

msgid "@niko ..."
msgstr "@niko ..."

msgid "@niko_speak ...What?"
msgstr "@niko_speak ... ¿Qué?"

