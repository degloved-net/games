msgid "@alula_gasp You saved me!"
msgstr "@alula_gasp ¡Me has salvado!"

msgid "@alula Thank you!"
msgstr "@alula ¡Gracias!"

msgid "@alula I was trapped in there for so long..."
msgstr "@alula Llevaba tanto tiempo atrapada..."

msgid "@niko So are you Alula?"
msgstr "@niko ¿Entonces tú eres Alula?"

msgid "@alula_gasp ..."
msgstr "@alula_gasp ..."

msgid "@alula_gasp You... knew my name?"
msgstr "@alula_gasp ¿Sabías mi... nombre?"

msgid "@alula_speak Wow! The messiah really does know everything!"
msgstr "@alula_speak ¡Madre mía! ¡Es verdad que el mesías lo sabe todo!"

msgid "@niko_eyeclosed Actually...\\.\\. \\@niko_speak I just met your brother earlier."
msgstr "@niko_eyeclosed En realidad...\\.\\. \\@niko_speak Antes he conocido a tu hermano."

msgid "@alula_oh Oh, right!"
msgstr "@alula_oh ¡Ah, vale!"

msgid "@alula_pout Gosh... Calamus must be so worried..."
msgstr "@alula_pout Jope... Calamus debe estar muy preocupado..."

msgid "@alula Can you bring me to him?"
msgstr "@alula ¿Puedes llevarme hasta él?"

msgid "@niko Wait a minute...\\>\\n\\@niko_speak How did you know that I was the,\\. um,\\. messiah?\\>\\n\\@niko_eyeclosed I don't have the sun with me..."
msgstr "@niko Un momento...\\>\\n\\@niko_speak ¿Cómo sabías que yo era el,\\. mmm,\\. mesías?\\>\\n\\@niko_eyeclosed No llevo el sol..."

msgid "@alula Your eyes!"
msgstr "@alula ¡Por tus ojos!"

msgid "@niko Huh?"
msgstr "@niko Bueno..."

msgid "@alula_speak They reminded me of the sun!"
msgstr "@alula_speak ¡Me han recordado al sol!"

msgid "@niko_speak Oh!"
msgstr "@niko_speak ¡Vaya!"

msgid "@alula That's why you're our messiah, right?"
msgstr "@alula Por eso eres nuestro mesías, ¿verdad?"

msgid "@niko Well...\\. I... \\>\\n\\@niko_speak A lot of people back in my home world have eyes like mine..."
msgstr "@niko Bueno...\\. Mmm... \\>\\n\\@niko_speak En mi mundo hay mucha gente con ojos como los míos..."

msgid "@alula_pout Home... world?"
msgstr "@alula_pout ¿En tu... mundo?"

msgid "@niko_speak Yeah! \\>\\@niko I'm actually from another world, you see!\\>\\nIt's a place where the sun is in the sky and not in a Tower."
msgstr "@niko_speak ¡Sí! \\>\\@niko ¡En realidad soy de otro mundo!\\>\\nDe un lugar en el que el sol está en el cielo y no en una Torre."

msgid "@alula Do you like this world too?"
msgstr "@alula ¿También te gusta este mundo?"

msgid "@niko I...\\> \\@niko_speak Yeah."
msgstr "@niko Bueno... \\>\\@niko_speak Sí."

msgid "@alula_speak Yay!\\>\\n\\@alula_pout Calamus keeps saying how this world is getting more dangerous by the minute."
msgstr "@alula_speak ¡Genial!\\>\\n\\@alula_pout Calamus no para de decir que este mundo se está volviendo cada vez más peligroso."

msgid "@alula_speak But that's ok! You're here now!\\>\\n\\@alula You can make everything better!"
msgstr "@alula_speak ¡Pero no pasa nada porque ahora tú estás aquí!\\>\\n\\@alula ¡Puedes arreglar las cosas!"

msgid "@niko Yeah..."
msgstr "@niko Sí..."

msgid "@niko_speak W-What in the world is this thing in the doorway?"
msgstr "@niko_speak ¿Qué diantres es eso que hay en la puerta?"

msgid "@niko It reminds me of what I saw a while ago, at the cliffs...\\nFor some reason, I'm afraid to touch it."
msgstr "@niko Me recuerda a algo que vi hace tiempo en los acantilados...\\nPor alguna razón me da miedo tocarlo."

msgid "@alula_oh Hey! Where are you going?"
msgstr "@alula_oh ¡Oye! ¿Adónde vas?"

