msgid "@niko Excuse me..."
msgstr "@niko Perdón..."

msgid "@george2_stress Hey!!!"
msgstr "@george2_stress ¡¡Oye!!"

msgid "@george2_grr Who the heck do you think you are, barging in here like that?"
msgstr "@george2_grr ¿Quién diablos te crees que eres para gritar así aquí dentro?"

msgid "@george2_NO I don't care if you're the Messiah, manners are still a thing!"
msgstr "@george2_NO Por mí como si eres el mesías, ¡hay que cuidar los modales!"

msgid "@niko I'm... \\>\\@niko_speak sorry?"
msgstr "@niko ¿Lo... \\>\\@niko_speak siento?"

msgid "@george2 Well? Are you just here to apologize?"
msgstr "@george2 ¿Y bien? ¿Has venido hasta aquí solo para disculparte?"

msgid "@niko ...Yes? \\.\\.\\n\\@niko_speak I mean, no!"
msgstr "@niko ¿Sí? \\.\\.\\n\\@niko_speak Es decir, ¡no!"

msgid "@niko_eyeclosed I mean, I need your help...\\>\\n\\@niko I'm not sure what I need to do next."
msgstr "@niko_eyeclosed Es decir... necesito tu ayuda...\\>\\n\\@niko No estoy seguro de lo que tengo que hacer ahora."

msgid "@niko I think I need to go in the Tower?"
msgstr "@niko ¿Podría ser que tenga que ir a la Torre?"

msgid "@george2 Seriously? You haven't figured that one out yet?"
msgstr "@george2 ¿En serio? ¿Todavía no sabes eso?"

msgid "@niko_speak I don't know how to get in!"
msgstr "@niko_speak ¡No sé cómo entrar!"

msgid "@george2_grr Well, I don't know either.\\n\\>\\@george2 Shouldn't \\p help you with that?"
msgstr "@george2_grr Bueno, yo tampoco.\\n\\>\\@george2 ¿No debería ser \\p quien te ayudase con eso?"

msgid "@george2_sigh All I know is that nobody from this world can get in there."
msgstr "@george2_sigh Solo sé que nadie de este mundo puede entrar."

msgid "@george2_grr Not beyond that tiny entrance room, anyway."
msgstr "@george2_grr No más allá de ese vestíbulo tan pequeño que hay, quiero decir."

msgid "@george2 If anything, there might be a book on how the Messiah of all people can get in."
msgstr "@george2 Como mucho, puede que haya algún libro sobre cómo puede entrar el mesías de todo el mundo."

msgid "@george2_sigh But I don't got anything like that in MY collection."
msgstr "@george2_sigh Pero no dispongo de nada así en MI colección."

msgid "@george2_grr Would like to, though."
msgstr "@george2_grr Estaría bien."

msgid "@george3_sad Si\\.i\\.i\\.\\.i\\.\\.igh."
msgstr "@george3_sad U\\.u\\.u\\.\\.u\\.\\.ff."

msgid "@niko Um... hi?"
msgstr "@niko Mmm... ¿hola?"

msgid "@george3_sigh ...\\.Hi."
msgstr "@george3_sigh ...\\.Hola."

msgid "@niko_speak Are you alright?"
msgstr "@niko_speak ¿Estás bien?"

msgid "@george3_sad .\\..\\..\\.."
msgstr "@george3_sad .\\..\\..\\.."

msgid "@niko .\\..\\..\\.."
msgstr "@niko .\\..\\..\\.."

msgid "@george3_worry Can I... help you..."
msgstr "@george3_worry ¿Puedo... ayudarte?"

msgid "@niko_speak Yeah!"
msgstr "@niko_speak ¡Sí!"

msgid "@niko I was wondering if you can tell me what I should do next?"
msgstr "@niko Me gustaría que me dijeras qué debería hacer ahora."

msgid "@niko I... think I'm supposed to go in the Tower."
msgstr "@niko Creo... Creo que tengo que ir a la Torre."

msgid "@george3_sad ...the Tower....\\>\\n\\@george3_sigh A grim obelisk... \\>\\@george3_sigh a solemn reminder of our fate."
msgstr "@george3_sad La Torre...\\>\\n\\@george3_sigh Un obelisco lúgubre... \\>\\@george3_sigh un recordatorio solemne de tu destino."

msgid "@george3_cry We're all gonna dieeeeeee...."
msgstr "@george3_cry Vamos a morir todoooos..."

msgid "@niko_what Um..."
msgstr "@niko_what Mmm..."

msgid "@niko_what ...so...\\> \\@niko_eyeclosed how do I... \\>\\@niko_speak get in?"
msgstr "@niko_what Entonces...\\>\\@niko_eyeclosed ¿cómo... \\>\\@niko_speak se entra?"

msgid "@george3_cry I don't know...!!!\\>\\n\\@george3_sad I've been reading and studying all my life, and yet..."
msgstr "@george3_cry ¡¡¡Y yo qué sé...!!!\\>\\n\\@george3_sad Llevo leyendo y estudiando toda la vida, pero aun así..."

msgid "@george3_cry I haven't even found any books about entering the Tower!"
msgstr "@george3_cry ¡Ni siquiera me he encontrado con ningún libro que diga cómo entrar en la Torre!"

msgid "@george3 Oh, I know there's a small room you can go in, but...\\>\\n\\@george3_cry Everybody knows that!"
msgstr "@george3 Sí, sé que hay un pequeño vestíbulo al que se puede acceder, pero...\\>\\n\\@george3_cry ¡eso lo sabe todo el mundo!"

msgid "@george4_smile Helloooo~!\\>\\nYou must be the savior!"
msgstr "@george4_smile ¡Holaaa!\\>\\n¡Tú debes de ser el salvador!"

msgid "@george4_omg I'm soooo happy I actually get to meet you! <3"
msgstr "@george4_omg ¡Me alegro tanto de conocerte por fin! <3"

msgid "@niko_speak It's nice to meet you too, miss!"
msgstr "@niko_speak ¡Es un placer conocerte, señorita!"

msgid "@george4 So! Are you here to check out the archives?\\>\\n\\@george4_omg I can give you a tour!"
msgstr "@george4 ¡Bueno! ¿Has venido a ver los archivos?\\>\\n\\@george4_omg ¡Puedo hacerte un tour!"

msgid "@niko Actually... \\>\\n\\@niko_speak I need your help!"
msgstr "@niko Pues el caso...\\>\\n\\@niko_speak ¡es que necesito tu ayuda!"

msgid "@niko_speak Can you tell me what I need to do next?\\>\\n\\@niko I think... I'm supposed to go in the Tower..."
msgstr "@niko_speak ¿Puedes decirme qué tengo que hacer ahora?\\>\\n\\@niko Creo... Creo que tengo que ir a la Torre..."

msgid "@george4 Yup!"
msgstr "@george4 ¡Sí!"

msgid "@niko Do you know how I can get in?"
msgstr "@niko ¿Sabes cómo puedo entrar?"

msgid "@george4 Nope!"
msgstr "@george4 ¡No!"

msgid "@george4_golly Gosh, I don't think ANYONE's supposed to get inside the Tower!"
msgstr "@george4_golly ¡Vaya, se supone que NADIE debe poder entrar en la Torre!"

msgid "@george4 I mean, there's a little room that you can go into...\\>\\n\\@george4_golly But there's no stairs or elevators or anything else..."
msgstr "@george4 A ver, hay un pequeño vestíbulo al que se puede acceder...\\>\\n\\@george4_golly Pero sin escaleras ni ascensores, ni nada por estilo..."

msgid "@george4 If you want my guess, you'll probably need \\p's help?"
msgstr "@george4 Yo diría que necesitas la ayuda de \\p."

msgid "@george4_oops I don't know how exactly..."
msgstr "@george4_oops No sé cómo exactamente..."

msgid "@george4 In my experience, that kind of knowledge is usually recorded in some sort of cryptic book."
msgstr "@george4 Por lo que yo sé, ese tipo de conocimientos se suelen registrar en libros crípticos."

msgid "@george4_golly But I haven't read anything like that before...\\>\\n\\@george4_oops Sorry!"
msgstr "@george4_golly Pero no he leído nada así hasta ahora...\\>\\n\\@george4_oops ¡Lo siento!"

msgid "@niko Ah..."
msgstr "@niko Ah..."

msgid "@george5 Oh, hello there!"
msgstr "@george5 ¡Oh, hola!"

msgid "@george5_smile You must be the savior!"
msgstr "@george5_smile ¡Tú debes de ser el salvador!"

msgid "@george5_aww And also, the cutest darn thing I have ever seen!"
msgstr "@george5_aww ¡Y además estás para mojar pan!"

msgid "@niko U-um... \\>\\n\\@niko_speak Thank you!"
msgstr "@niko E... Eh... \\>\\n\\@niko_speak ¡Gracias!"

msgid "@george5_smile Can I help you with anything, sweetie?"
msgstr "@george5_smile ¿En qué te puedo ayudar, cariño?"

msgid "@niko Mhm!\\>\\n\\@niko I want to know what I should do next!"
msgstr "@niko ¡Gracias!\\>\\n\\@niko ¡Quiero saber qué tengo que hacer ahora!"

msgid "@niko I think I'm supposed to go in the Tower?"
msgstr "@niko ¿Me parece que tengo que ir a la Torre?"

msgid "@george5 Oooh that's right, the Tower!"
msgstr "@george5 ¡Oooh, eso es, la Torre!"

msgid "@george5_smile I know there's a small room that you can go into, but..."
msgstr "@george5_smile Sí, sé que hay un pequeño vestíbulo al que se puede acceder, pero..."

msgid "@george5_hmm ...I'm afraid nobody knows how to get in beyond that!"
msgstr "@george5_hmm ¡Me temo que nadie sabe cómo llegar más allá de él!"

msgid "@george5_heh Not even silly ol' me, who spent her entire life reading books about the world..."
msgstr "@george5_heh Ni siquiera esta vieja estúpida que se ha pasado toda la vida leyendo libros sobre el mundo..."

msgid "@george5 I think you need some help from \\p, but I don't know any details!"
msgstr "@george5 Creo que necesitarás la ayuda de\\p, pero yo no sé nada más."

msgid "@george5_hmm I've never found any books about this before...\\>\\n\\@george5_smile You'd think there would be at least ONE book on this, but I guess that's just how it is!"
msgstr "@george5_hmm Jamás he visto ningún libro al respecto...\\>\\n\\@george5_smile Una pensaría que al menos tiene que haber UNO sobre ello, pero supongo que así son las cosas."

msgid "@george5_hmm Goodness, this is quite the dilemma!"
msgstr "@george5_hmm ¡Madre mía, esto es todo un dilema!"

msgid "@george6 Hey, lil' fella!"
msgstr "@george6 ¡Hola, amigo!"

msgid "@niko_speak Hello!"
msgstr "@niko_speak ¡Hola!"

msgid "@george6_point So you're gonna like, save the world and stuff!\\>\\n\\@george6_smile Didn't think I'd run into ya. But now I did!"
msgstr "@george6_point ¡Así que vas a salvar el mundo y todo eso!\\>\\n\\@george6_smile Pensaba que no me encontraría contigo, pero ¡acabo de hacerlo!"

msgid "@george6_fingerguns Eyyyyyy."
msgstr "@george6_fingerguns Yepaaa."

msgid "@niko_speak Um, thanks?"
msgstr "@niko_speak Mmm, ¿gracias?"

msgid "@george6 So like, what up?\\>\\n\\@george6_smile Can I getcha anything?"
msgstr "@george6 Bueno, ¿entonces qué?\\>\\n\\@george6_smile ¿Puedo ayudarte con algo?"

msgid "@niko_speak Yeah! I heard you can help me!"
msgstr "@niko_speak ¡Sí! ¡Me han dicho que puedes ayudarme!"

msgid "@niko I'm not sure what I'm supposed to do now..."
msgstr "@niko No tengo muy claro qué tengo que hacer ahora..."

msgid "@niko_speak I think I'm supposed to go in the Tower...\\>\\n\\@niko But how do I do that?"
msgstr "@niko_speak Me parece que tengo que ir a la Torre...\\>\\n\\@niko Pero ¿cómo se hace?"

msgid "@george6 Ya don't.\\>\\n\\@george6_shrug At least, WE don't."
msgstr "@george6 No se hace.\\>\\n\\@george6_shrug Al menos, NOSOTROS no lo hacemos."

msgid "@george6 The Tower's only got one teeny room in it, it ain't even got stairs!"
msgstr "@george6 En la Torre solo hay un pequeño vestíbulo, ¡ni siquiera tiene escaleras!"

msgid "@george6_point I bet you need \\p's help on this one, pal...\\>\\n\\@george6_shrug Exactly how? I dunno."
msgstr "@george6_point Apuesto a que necesitas la ayuda de \\p para esto, amigo...\\>\\n\\@george6_shrug ¿Cómo exactamente? Ni idea."

msgid "@george6 But I bet'cha anything that sorta knowledge is in some mystery book somewhere."
msgstr "@george6 Pero me juego algo a que ese tipo de conocimiento se encuentra en algún libro misterioso a saber dónde."

msgid "@george6_shrug Nothin' in my collection fits the description, tho."
msgstr "@george6_shrug Nada de lo que tengo en mi colección concuerda con ello."

msgid "@niko A box full of notebooks."
msgstr "@niko Una caja llena de libretas."

msgid "@niko A book is poking out from the shelf."
msgstr "@niko Hay un libro que destaca en este estante."

msgid "@niko_speak Ah, this looks like a sketchbook of some sort!"
msgstr "@niko_speak ¡Ah, parece un libro de bocetos!"

msgid "@george1 Oh, do you need George to tell you what to do again?"
msgstr "@george1 Ah, ¿necesitas que George te diga otra vez lo que tienes que hacer?"

msgid "@niko_speak Yes please!"
msgstr "@niko_speak ¡Sí, por favor!"

msgid "@george1 According to the journal, you must go to the small room at the base of the Tower while having three pieces of the previous sun in your possession."
msgstr "@george1 Según el diario, debes poseer tres partes del sol anterior y dirigirte a la sala pequeña que hay en la base de la Torre."

msgid "@george1 With those three items at hand, you must stand in the room, and \\p will do something about floor patterns and windows."
msgstr "@george1 Con estos tres objetos en tus manos, debes entrar en la sala. A continuación, \\p hará algo con las ventanas y el patrón del suelo."

msgid "@niko Alright... thank you!"
msgstr "@niko Muy bien... ¡Gracias!"

msgid "@george1_smile Good luck on your journey, small child!"
msgstr "@george1_smile ¡Buena suerte en tu viaje, pequeño!"

msgid "@george1 George shall bid you farewell now."
msgstr "@george1 George se despide de ti."

msgid "@george1 I've done it!"
msgstr "@george1 ¡Lo he logrado!\\>\\n"

msgid "@george1_smile I have finished the daunting task of translating this journal!"
msgstr "@george1_smile ¡Por fin he terminado la formidable tarea de traducir este diario!"

msgid "@niko_speak Oh! That was fast!"
msgstr "@niko_speak ¡Vaya! Qué rapidez."

msgid "@george1_smug But of course! I AM the speediest translator in recent history."
msgstr "@george1_smug ¡Por supuesto! Soy la traductora más rápida de la historia reciente."

msgid "@george1 Anyway, I made you a line-by-line transcript. \\>\\nIt looks like this journal might be meant for \\p."
msgstr "@george1 En fin. He elaborado una transcripción línea por línea. \\>\\nParece que este diario podría ser para \\p."

msgid "@niko_speak Oh?"
msgstr "@niko_speak Ah, ¿sí?"

msgid "@george1 Here, take a look yourself."
msgstr "@george1 Toma, míralo tú mismo."

msgid "@george1 There, that's the last of it."
msgstr "@george1 Esta es la última."

msgid "@george1 The rest of the pages are torn out.\\>\\n\\@george1_hm You didn't do this, did you?"
msgstr "@george1 El resto de páginas están arrancadas.\\>\\n\\@george1_hm No habrás sido tú, ¿verdad?"

msgid "@niko_speak No!"
msgstr "@niko_speak ¡No!"

msgid "@george1 A shame! I was wondering what \"window\" was supposed to mean.\\>\\n\\@george1 Ah well, I guess \\p will have to figure out that one."
msgstr "@george1 ¡Qué lástima! Me preguntaba qué querrá decir con \"ventana\".\\>\\n\\@george1 Bueno, supongo que \\p tendrá que averiguarlo por su cuenta."

msgid "@niko Right..."
msgstr "@niko Claro..."

msgid "@niko_speak By the way, what does it mean by \"three pieces of the previous sun\"?\\>\\n\\@niko I only have this sun..."
msgstr "@niko_speak Por cierto, ¿qué significa \"tres partes del sol anterior\"?\\>\\n\\@niko Solo tengo este sol..."

msgid "@george1_hm Aha!\\>\\nThat... \\@george1_smug is a question George can answer!"
msgstr "@george1_hm ¡Ajá!\\>\\nEsa... \\@george1_smug es una pregunta que George puede responder."

msgid "@george1 It means you need items containing yellow phosphor, the rarest of the phosphors.\\>\\n\\@george1 ...said to absorb sunlight for the longest time and never fade out."
msgstr "@george1 Significa que necesitas objetos que contengan fósforo amarillo, que es el más escaso.\\>\\n\\@george1 ... Dicen que absorbe la luz solar durante más tiempo que ninguno, y que no se agota nunca."

msgid "@niko_speak Oh!\\>\\n\\@niko I do have a piece of amber and a feather, they're both glowing yellow..."
msgstr "@niko_speak ¡Ah!\\>\\n\\@niko Tengo un trozo de ámbar y una pluma, y las dos son de color amarillo brillante..."

msgid "@george1_hm But alas, you are missing the third, no?"
msgstr "@george1_hm Entonces te faltaría un tercer objeto, ¿no?"

msgid "@george1 Fear not! For George, collector of rare artifacts... \\@george1_hm will assist you!\\>\\n\\@george1 Here."
msgstr "@george1 ¡No temas! Pues George, coleccionista de artefactos extraños... \\@george1_hm ¡acudirá en tu ayuda!\\>\\n\\@george1 Toma."

msgid "@niko Oh...\\>\\n\\@niko_speak It looks... \\@niko_huh ...like you?"
msgstr "@niko Ah...\\>\\n\\@niko_speak Se parece... \\@niko_huh ¿a ti...?"

msgid "@george1_smile Yes!"
msgstr "@george1_smile ¡Sí!"

msgid "@george1_smile Now you'll never forget my face! \\>\\n\\@george1 The face... \\>\\@george1_hm of knowledge."
msgstr "@george1_smile ¡Así nunca olvidarás mi rostro! \\>\\n\\@george1 El rostro... \\>\\@george1_hm de la sabiduría."

msgid "@niko_speak Ah, thank you!"
msgstr "@niko_speak ¡Ah, gracias!"

msgid "@george1 Yes, even someone as great as I must put the proper thought and care into a task like this."
msgstr "@george1 En efecto, incluso alguien de mi grandeza debe volcar todo su empeño y cuidado cuando se trata de una tarea semejante.\\>\\n"

msgid "@niko_yawn *yawn*..."
msgstr "@niko_yawn *Uaaa*..."

msgid "@niko_eyeclosed Excuse me.... \\>\\n\\@niko ...again."
msgstr "@niko_eyeclosed Perdona... \\>\\n\\@niko otra vez..."

msgid "@george1 Go take a nap, small child! \\>\\n\\@george1_smug Take a nap and appreciate my hospitality!"
msgstr "@george1 ¡Ve a echarte una siesta, pequeño! \\>\\n\\@george1_smug ¡Duerme y disfruta de mi hospitalidad!"

msgid "@george1 Guest room's in the attic down the hall, in case you forgot."
msgstr "@george1 Por si lo olvidabas, la habitación de invitados se encuentra en el altillo que hay al fondo del pasillo."

msgid "@niko_speak Oh!"
msgstr "@niko_speak ¡Vaya!"

msgid "@niko I do have this book, though!\\>\\n\\@niko_speak I... think it's written in some sort of... words I don't recognize?"
msgstr "@niko ¡Tengo un libro!\\>\\n\\@niko_speak Creo que está escrito con... una especie de palabras que no reconozco."

msgid "@george1 Aha!\\>\\nAn ancient book!\\>\\nWritten by no less than the most ancient... wait a minute."
msgstr "@george1 ¡Ajá!\\>\\n¡Un libro antiguo!\\>\\nEscrito por nada más y nada menos que... Un momento..."

msgid "@george1_hm This isn't ancient at all!\\>\\n\\@george1 But it's written in a dead language nevertheless."
msgstr "@george1_hm ¡Esto no es antiguo en absoluto!\\>\\n\\@george1 No obstante, es cierto que está escrito en una lengua muerta."

msgid "@george1_hm It's time... for me to unleash my brilliance!"
msgstr "@george1_hm Ha llegado el momento... ¡de sacar a relucir toda mi genialidad!"

msgid "@george1 For George (me),\\npossessor of at least one PhD...\\>\\n\\@george1_smug shall translate this!"
msgstr "@george1 Yo, George,\\nposeedora de más de un doctorado...\\>\\n\\@george1_smug ¡me dispongo a traducir este libro!"

msgid "@george1 ...this will take some time, however."
msgstr "@george1 ... Tardaré un poco, eso sí."

msgid "@niko I see...\\>\\n\\@niko_yawn *yawn*..."
msgstr "@niko Ya...\\>\\n\\@niko_yawn *Uaaa*..."

msgid "@niko_eyeclosed Excuse me...."
msgstr "@niko_eyeclosed Perdona..."

msgid "@george1_hm Oh? What's this? \\>\\nYou are sleepy?"
msgstr "@george1_hm ¿Eh? ¿Qué sucede? \\>\\n¿Tienes sueño?"

msgid "@niko_eyeclosed A little...."
msgstr "@niko_eyeclosed Un poco..."

msgid "@george1_smile Fear not! \\>Because I have read a book on hospitality before!"
msgstr "@george1_smile ¡No temas! \\>¡He leído varios libros sobre la hospitalidad!"

msgid "@george1_smug ...and thus, have prepared for this exact situation!"
msgstr "@george1_smug Por tanto, estoy preparada para abordar esta situación."

msgid "@george1 ...Guest room's in the attic down the hall."
msgstr "@george1 La habitación de invitados se encuentra en el altillo que hay al fondo del pasillo."

msgid "@niko So...."
msgstr "@niko Entonces..."

msgid "@george1 If you have any questions regarding books, then fear not."
msgstr "@george1 Si tienes alguna pregunta sobre libros, no temas."

msgid "@george1_smug For I, George the head librarian, know a lot about \\c[3]books\\c[0]."
msgstr "@george1_smug Puesto que yo, George, directora de la Biblioteca, tengo un amplio conocimiento sobre \\c[3]libros\\c[0]."

