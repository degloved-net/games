msgid "@george2_grr ...oh.\\>\\n\\@george2_stress Of course... \\>\\@george2_NO OF COURSE!!!"
msgstr "@george2_grr ... Ah.\\>\\n\\@george2_stress Claro... \\>\\@george2_NO ¡¡POR SUPUESTO!!"

msgid "@niko Um..."
