msgid "@george4_golly Yeah... the rest of the pages were torn out..."
msgstr "@george4_golly Sí... Alguien ha arrancado el resto de páginas."

msgid "@george4 I... guess you don't know what happened to those?"
msgstr "@george4 Supongo que... no sabrás qué ocurrió con ellas."

msgid "@niko_eyeclosed Nope..."
msgstr "@niko_eyeclosed Pues no..."

msgid "@george4_oops Aww... I was wondering what \"window\" was supposed to mean.\\>\\n\\@george4_golly Ah well, I guess \\p will have to figure out that one."
msgstr "@george4_oops Vaya... Me preguntaba qué querrá decir \"ventana\".\\>\\n\\@george4_golly Bueno, supongo que \\p tendrá que averiguarlo por su cuenta."

msgid "@george4_omg Oh! Of course!"
msgstr "@george4_omg ¡Ah! ¡Claro!"

msgid "@george4_smile That just means you need things that contain yellow phosphor!\\>\\n\\@george4 They glow for a long time!"
msgstr "@george4_smile ¡Significa que necesitas cosas que contengan fósforo amarillo!\\>\\n\\@george4 ¡Su brillo dura muchísimo!"

msgid "@niko_speak Ooh!\\>\\n\\@niko I do have a piece of amber and a feather, they're both glowing yellow..."
msgstr "@niko_speak ¡Aaah!\\>\\n\\@niko Tengo un trozo de ámbar y una pluma, y las dos son de color amarillo brillante..."

