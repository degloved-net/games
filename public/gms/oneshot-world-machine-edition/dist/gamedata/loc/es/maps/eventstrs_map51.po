msgstr "@george3_sad Ah, bueno...\\>\\n\\@george3 Arriba tengo una habitación de invitados...\\>\\n\\@george3_sad Ah, pero está en el altillo..."

msgid "@george3_sigh Sorry if it's not very comfortable..."
msgstr "@george3_sigh Siento si no es la habitación más cómoda del mundo..."

msgid "@george3_sigh So... do you have any questions about \\c[3]books\\c[0]..."
msgstr "@george3_sigh ¿Tienes... alguna pregunta sobre... \\c[3]libros\\c[0]...?"

msgid "@george3_cry It's all I'm good forrrrrrr......."
msgstr "@george3_cry Los libros son lo único que se me da bien en la vida..."

msgid "@george4_golly Oh, do you need me to explain again?"
msgstr "@george4_golly Ah, ¿quieres que te lo explique de nuevo?"

msgid "@george4 Alright!"
msgstr "@george4 ¡De acuerdo!"

