msgstr "@george2_grr Ve a dormir un rato. \\>\\@george2_sigh Voy a tardar un rato en traducirlo."

msgid "@niko I have this book!\\>\\n\\@niko_speak I... think it's written in some sort of... words I don't recognize?"
msgstr "@niko ¡Tengo un libro!\\>\\n\\@niko_speak Creo que está escrito en... una especie de palabras que no reconozco."

msgid "@george2 Oh? \\>\\nLemme see..."
