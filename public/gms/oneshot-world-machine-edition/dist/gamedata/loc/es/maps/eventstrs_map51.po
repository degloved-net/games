msgid "@niko_what ..."
msgstr "@niko_what ..."

msgid "@niko I... think we'll be fine, miss!"
msgstr "@niko Eh... ¡Tranquila, eso no va a pasar!"

msgid "@george3_sad Are you sure?"
msgstr "@george3_sad ¿Seguro?"

msgid "@niko_speak Yeah!\\> Thank you for helping us, by the way!"
msgstr "@niko_speak ¡Sí!\\> ¡Muchas gracias por la ayuda, de verdad!"

msgid "@george3_sad Alright... \\>\\@george3_sigh see you around, I guess..."
msgstr "@george3_sad Vale... \\>\\@george3_sigh Ya nos veremos, supongo..."

msgid "@george3_cry I'm working as fast as I can...!!"
msgstr "@george3_cry ¡¡Trabajo tan rápido como puedo...!!"

msgid "@niko No worries!"
msgstr "@niko ¡No te preocupes!"

msgid "@niko_yawn *yawn*... \\>\\n\\@niko_eyeclosed Excuse me...\\. again."
msgstr "@niko_yawn *Uaaa*... \\>\\n\\@niko_eyeclosed Perdona...\\. otra vez."

msgid "@george3_sad You can go take a nap if you want..."
msgstr "@george3_sad Puedes ir a dormir un rato, si quieres..."

msgid "@george3_sad If you forgot, the guest room is down the hall and upstairs..."
msgstr "@george3_sad Recuerda que la habitación de invitados está subiendo las escaleras que hay al fondo del pasillo..."

