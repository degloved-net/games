msgstr "@george4 ¡Y no un libro cualquiera! \\>\\@george4_golly Madre mía... ¿De dónde lo has sacado?"

msgid "@niko I woke up with it."
msgstr "@niko Estaba ahí cuando me desperté."

msgid "@niko Somewhere in the barrens!\\>\\n\\@niko_speak Oh! We found it in a safe!\\> Right, \\p?"
msgstr "@niko ¡De Los Baldíos!\\>\\n\\@niko_speak ¡Ah, sí! Lo encontramos en una caja fuerte.\\> ¿Verdad, \\p?"

