msgid "@george3_sad Ah... I don't know what \"window\" is supposed to mean.\\>\\n\\@george3_worry Maybe \\p will know..."
msgstr "@george3_sad Ah... y no sé qué significa \"ventana\"...\\>\\n\\@george3_worry Puede que \\p lo sepa..."

msgid "@george3 Oh."
msgstr "@george3 Ah."

