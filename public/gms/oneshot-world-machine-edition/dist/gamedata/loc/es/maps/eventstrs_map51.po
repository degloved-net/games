msgid "@niko_eyeclosed Right."
msgstr "@niko_eyeclosed Es verdad."

msgid "@george3_worry Anyway... \\.he...\\. this person... wrote this journal for \\p... I think..."
msgstr "@george3_worry En fin... \\.Resulta que esta...\\. persona... escribió este diario para \\p... creo..."

