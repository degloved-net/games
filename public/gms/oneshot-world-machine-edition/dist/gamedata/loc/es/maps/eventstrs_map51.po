msgid "@niko It's a bookshelf."
msgstr "@niko Es una estantería."

msgid "@niko_speak The computer screen says something about \"updated databases\"."
msgstr "@niko_speak En la pantalla del ordenador pone no sé qué de \"bases de datos actualizadas\"."

msgid "@george1 So!\\>\\n\\@george1_smug Someone here to see the brilliant George, eh?"
msgstr "@george1 ¡Vaya!\\>\\n\\@george1_smug Así que ha venido alguien a ver en acción a George, la estrella, ¿no?"

msgid "@george1_smug Caught wind of my genius and couldn't help but come see for yourself, eh?"
msgstr "@george1_smug ¿Te han llegado noticias de mi genialidad y no has podido resistirte a verme en persona, ¿eh?"

msgid "@niko Um-"
msgstr "@niko Mmm..."

msgid "@george1 ...don't answer!\\>\\n\\@george1_smug Of course you are."
msgstr "@george1 ¡No respondas!\\>\\n\\@george1_smug Resulta evidente."

msgid "@george1_smile What else could you ~possibly~ want?"
msgstr "@george1_smile ¿Para qué iba a ser si no?"

msgid "@niko Actually... \\@niko_speak I need your help!\\>\\n\\@niko_speak Can you tell me what I need to do?"
msgstr "@niko Pues el caso es... \\@niko_speak ¡que necesito tu ayuda!\\>\\n\\@niko_speak ¿Me puedes decir qué tengo que hacer?"

msgid "@niko I think... I'm supposed to go in the Tower..."
