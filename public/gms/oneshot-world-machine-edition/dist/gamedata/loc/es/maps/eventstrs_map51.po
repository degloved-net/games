msgid "@george4_smile Like me, right?"
msgstr "@george4_smile A mí, ¿verdad?"

msgid "@niko_speak Mhm!"
msgstr "@niko_speak ¡Ajá!"

msgid "@george4_smile Now you have a little keepsake from the library!"
msgstr "@george4_smile ¡Ahora ya tienes un pequeño recuerdo de la biblioteca!"

msgid "@george4 No problem! Looks like you're all set!"
msgstr "@george4 ¡Muy bien! ¡Creo que ya estás listo!"

msgid "@george4_smile Good luck now!"
msgstr "@george4_smile ¡Buena suerte!"

msgid "@george4_oops Haha... it won't be done for a while, sorry!"
msgstr "@george4_oops Ja, ja... ¡Tardaré un tiempo, lo siento!"

msgid "@niko_eyeclosed Excuse me...\\.\\. again...."
msgstr "@niko_eyeclosed Perdóname...\\.\\. otra vez..."

msgid "@george4_golly Seriously, you should go take a nap before you overexert yourself!\\>\\n\\@george4 The guest room is in the attic down the hall, if you forgot!"
msgstr "@george4_golly En serio, deberías ir a echarte una siesta, ¡vas a desfallecer!\\>\\n\\@george4 Por si no te acuerdas, la habitación de invitados está en el altillo que hay al fondo del pasillo."

msgid "@niko_speak Oh! I do have this!\\>\\n\\@niko_speak I... think it's written in some sort of... words I don't recognize?"
msgstr "@niko_speak ¡Ah! ¡Tengo esto!\\>\\n\\@niko_speak Creo que está escrito con... una especie de palabras que no reconozco."

msgid "@george4_golly Oh my gosh!"
msgstr "@george4_golly ¡Ay, madre!"

msgid "@george4 It's.... \\.\\.\\@george4_omg A book!"
msgstr "@george4 Es... \\.\\.\\@george4_omg ¡un libro!"

