msgstr "@george6_shrug Estoy acostumbrada a que me envíe cosas nuevas todo el tiempo."

msgid "@george6 I mean, of course I can't keep up with the pace that he's writin', but he don't mind."
msgstr "@george6 A ver, claro que puedo seguir el ritmo al que escribe, pero a él no le importa."

msgid "@george6_fingerguns Guy's just tooootally passionate 'bout his job!"
msgstr "@george6_fingerguns ¡El tío está taaan flipado con su trabajo!"

msgid "@george6_smile Makes me wanna work hard too, so I do!"
msgstr "@george6_smile ¡Hace que se me contagien las ganas de afanarme en el trabajo a mí también!"

msgid "@george6 I've been playin catchup with the stuff I haven't gotten to finish yet."
msgstr "@george6 He estado procurando ponerme al día con las cosas que todavía me quedan por hacer."

msgid "@george6_point But you know what's weird?"
msgstr "@george6_point Pero ¿sabes qué pasa?"

msgid "@niko What?"
msgstr "@niko ¿Qué?"

msgid "@george6_shrug The stuff I'm supposed to finish don't get finished."
msgstr "@george6_shrug Que nada de lo que tengo que terminar se termina."

msgid "@george6 Like I've put out book after book but the work pile don't get any smaller."
