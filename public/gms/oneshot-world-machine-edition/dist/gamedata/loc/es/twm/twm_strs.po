msgid "tutorial_preamble=Hello there.\nThank you for installing this operating system.\nI know you were probably expecting a \"game\", but...\n...apologies, I'm still setting things up here.\nIn the meantime, why don't I show you how the system works?"
msgstr "Hola.\nGracias por instalar este sistema operativo.\nSe que estabas esperando un \"juego\", pero...\n...disculpas, todavía estoy configurando las cosas aquí.\nMientras tanto, ¿por qué no te enseño cómo funciona el sistema?"

msgid "tutorial_move_cursor=Use @MOVEMOUSE to move the cursor."
msgstr "En primer lugar, utilice @MOVEMOUSE para mover el cursor."

msgid "tutorial_drag_file=Press and hold @CLICK and drag with @MOVEMOUSE to move icons."
msgstr "Mantenga pulsado @CLICK y arrastre con @MOVEMOUSE para mover los iconos."

msgid "tutorial_launch_application=Click with @CLICK twice to launch an application."
msgstr "Pulse con @CLICK dos veces para abrir una aplicación."

msgid "tutorial_move_window=Press and hold the window bar with @CLICK and drag with @MOVEMOUSE to move windows."
msgstr "Mantenga pulsada la barra de ventana con @CLICK y arrastre con @MOVEMOUSE para mover las ventanas."

msgid "tutorial_minimize_window=Click the Hide Button to hide the window."
msgstr "Haga clic en el botón Ocultar para ocultar la ventana."

msgid "tutorial_unminimize_window=Click the window on the task bar to bring it back up again."
msgstr "Haga clic en la ventana de la barra de tareas para que vuelva a aparecer."

msgid "tutorial_close_window=Click the Close Button to close the window."
msgstr "Haga clic en el botón Cerrar para cerrar la ventana."

msgid "tutorial_wrap_up=Excellent work. Now you know how to navigate the interface.\nAh! And just in time, too!"
msgstr "Excelente trabajo. Ahora ya sabes cómo navegar por la interfaz.\n¡Ah! ¡Y justo a tiempo, también!"

msgid "tutorial_oneshot_appears=There we go. Everything should be ready for you.\nI'll leave you to it, then.\nGoodbye for now."
msgstr "Ya está. Todo debería estar listo para ti.\nTe dejo con ello, entonces.\nAdiós por ahora."

msgid "tutorial_redo_preamble=Hello again!\nLooks like you could use a refresher on how to navigate this system.\nVery well, let's go through what I showed you before."
msgstr "¡Hola de nuevo!\nParece que te vendría bien un repaso de cómo navegar por este sistema.\nMuy bien, vamos a repasar lo que te mostré antes."

msgid "tutorial_redo_wrap_up=And there you have it! Hope that helped."
msgstr "Y ahí lo tienes. Espero que te haya servido de ayuda."

msgid "tutorial_delete_click_file=Click this file to select it in the browser window."
msgstr "Haga clic en este archivo para seleccionarlo en la ventana del navegador."

msgid "tutorial_delete_click_delete_button=Click the delete button to delete file."
msgstr "Haga clic en el botón de borrar para eliminar el archivo."

msgid "tutorial_delete_confirm_delete=Confirm the deletion in the pop-up window."
msgstr "Confirme la eliminación en la ventana emergente."

msgid "tutorial_delete_congratulations=You did it!  That's how you delete a file."
msgstr "Y así es como se hace."

msgid "tutorial_movefile_drag_file=Click and hold this file and move the mouse cursor."
msgstr "Mantenga pulsado este archivo y mueva el cursor del ratón."

msgid "tutorial_movefile_drop_file=Now drag the file to the folder window on the right and drop it."
msgstr "Ahora arrastra el archivo a la ventana de la carpeta de la derecha y suéltalo."

msgid "tutorial_movefile_congratulations=And there you have it! You've moved the file from Folder 1 to Folder 2."
msgstr "¡Y ahí lo tienes! Has movido el archivo de la Carpeta 1 a la Carpeta 2."

