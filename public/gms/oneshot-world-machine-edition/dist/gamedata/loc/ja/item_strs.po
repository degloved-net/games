msgid "1:name=lightbulb"
msgstr "電球"

msgid "1:description=A large lightbulb. It's the sun."
msgstr "大きな電球。太陽だ。"

msgid "2:name=television remote"
msgstr "テレビのリモコン"

msgid "2:description=It's too hard to read in the dark light."
msgstr "暗い場所では文字が読めない。"

msgid "3:name=bottle of alcohol"
msgstr "アルコールのビン"

msgid "3:description=The smell of the liquid is repugnant."
msgstr "液体は不快な臭いがする。"

msgid "4:name=dry branch"
msgstr "乾いた枝"

msgid "4:description=A flaky, dry branch from the bathroom plant."
msgstr "浴室にある観葉植物の、パサパサに乾いた枝。"

msgid "5:name=wet branch"
msgstr "濡れた枝"

msgid "5:description=The tip of the branch is soaked with alcohol."
msgstr "枝の先はアルコールで濡れている。"

msgid "6:name=torch"
msgstr "たいまつ"

msgid "6:description=Doesn't give off much light."
msgstr "あまり明るくない。"

msgid "7:name=basement key"
msgstr "地下室の鍵"

msgid "7:description=This thing looks old."
msgstr "なんだか古めかしい。"

msgid "8:name=camera"
msgstr "カメラ"

msgid "8:description=A broken camera with a large screwed-in lens."
msgstr "大きなねじ込み式レンズがついた、壊れたカメラ。"

msgid "9:name=screwdriver"
msgstr "ドライバー"

msgid "9:description=Phillips-head."
msgstr "プラスのネジに対応。"

msgid "10:name=lens"
msgstr "レンズ"

msgid "10:description=A large glass lens."
msgstr "大きなガラスのレンズ。"

msgid "11:name=empty bottle"
msgstr "空ビン"

msgid "11:description=The smell of alcohol lingers."
msgstr "アルコールの臭いが残っている。"

msgid "12:name=broken battery"
msgstr "壊れたバッテリー"

msgid "12:description=Apparently a battery.  It has some broken glass in it."
msgstr "バッテリーのようだ。中に割れたガラスが入っている。"

msgid "13:name=empty battery"
msgstr "空のバッテリー"

msgid "13:description=An intact, rechargable battery. Currently empty."
msgstr "傷一つない充電式バッテリー。今は充電されてない。"

msgid "14:name=charged battery"
msgstr "充電済みバッテリー"

msgid "14:description=A working, rechargable battery. Maximum power."
msgstr "作動可能な充電式バッテリー。フルチャージ。"

msgid "15:name=bottle of smoke"
msgstr "煙入りビン"

msgid "15:description=It's full of noxious fumes."
msgstr "有毒ガスでいっぱいだ。"

msgid "16:name=bottle of acid"
msgstr "酸の入ったビン"

msgid "16:description=It's full of a thick liquid acid."
msgstr "粘っこい酸性の液体でいっぱいだ。"

msgid "17:name=wet sponge"
msgstr "濡れたスポンジ"

msgid "17:description=Sponge soaked with acidic cleaning solution."
msgstr "酸性の洗浄液が染み込んだスポンジ。"

msgid "18:name=crowbar"
msgstr "バールのようなもの"

msgid "18:description=Makeshift crowbar made from a pipe."
msgstr "パイプから作った、間に合わせのバールのようなもの。"

msgid "19:name=metal rod"
msgstr "鉄パイプ"

msgid "19:description=It weighs surprisingly little."
msgstr "驚くほど軽い。"

msgid "20:name=sponge"
msgstr "スポンジ"

msgid "20:description=A flat sponge with a rough surface."
msgstr "表面が粗い平らなスポンジ。"

msgid "21:name=empty syringe"
msgstr "空の注射器"

msgid "21:description=The needle is particularly long."
msgstr "針が非常に長い。"

msgid "22:name=filled syringe"
msgstr "中身が入っている注射器"

msgid "22:description=It's full of the strange liquid from the pond."
msgstr "池の奇妙な液体で満たされている。"

msgid "23:name=amber"
msgstr "琥珀"

msgid "23:description=A piece of glowing amber with a black clover inside."
msgstr "黒いクローバーが中に入った、輝く琥珀。"

msgid "24:name=strange journal"
msgstr "奇妙な日記"

msgid "24:description=Found in the Barrens. It's written in an unknown language."
msgstr "不毛の地で見つけた。謎の言語で書かれている。"

msgid "25:name=feather"
msgstr "羽根"

msgid "25:description=A long and slender feather with glowing edges."
msgstr "輪郭が輝く、長細い羽根。"

msgid "26:name=bottle of dye"
msgstr "染料のビン"

msgid "26:description=A small vial filled with dark blue liquid used for dying wool."
msgstr "紺色の液体で満たされた小さなビン。"

msgid "27:name=tube of water"
msgstr "水の管"

msgid "27:description=The label says \"water sample\"."
msgstr "ラベルには「水サンプル」と書かれている。"

msgid "28:name=seed"
msgstr "種"

msgid "28:description=It's a seed apparently left behind by Maize."
msgstr "メイズが残していった種のようだ。"

msgid "29:name=wool"
msgstr "羊毛"

msgid "29:description=It's... kind of useless."
msgstr "あまり…役に立たない。"

msgid "30:name=feather pen"
msgstr "羽根ペン"

