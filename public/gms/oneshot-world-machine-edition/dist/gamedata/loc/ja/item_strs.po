msgid "40:name=concave lens"
msgstr "凹レンズ"

msgid "40:description=A large lens, curved inward."
msgstr "大きなレンズ、内側に湾曲している。"

msgid "41:name=convex lens"
msgstr "凸レンズ"

msgid "41:description=A large lens, curved outward"
msgstr "大きなレンズ、外側に湾曲している。"

msgid "42:name=thin lens"
msgstr "薄いレンズ"

