msgstr "非常に薄いレンズ。"

msgid "43:name=thick lens"
msgstr "厚いレンズ"

msgid "43:description=A large, thick lens."
msgstr "大きく、分厚いレンズ。"

msgid "44:name=glitter glue"
msgstr "ラメ入りノリ"

msgid "44:description=A small tube of pink glitter glue."
msgstr "ピンクのラメが混ざったノリが入った、小さなチューブ。"

msgid "45:name=photo of Niko"
msgstr "ニコの写真"

msgid "45:description=Not a cat!"
msgstr "ネコじゃないよ！"

msgid "46:name=Kip's library card"
msgstr "キップの図書館カード"

