msgstr "目が光っているサイコロ。"

msgid "32:name=button (?)"
msgstr "ボタン（？）"

msgid "32:description=A simple button made from a coffee tin."
msgstr "コーヒー缶から作られたシンプルなボタン。"

msgid "33:name=magnetized (?) button"
msgstr "磁気を帯びた（？）ボタン"

msgid "33:description=A button with magnets loosely attached."
msgstr "磁石がゆるく付着したボタン。"

msgid "34:name=taped button"
msgstr "テープが貼られたボタン"

msgid "34:description=The magnets are secured with tape."
msgstr "磁石がテープで固定されている。"

msgid "35:name=you tried"
msgstr "よくやった"

msgid "35:description=It's the thought that counts."
msgstr "その意志が大事。"

msgid "36:name=magnets"
msgstr "磁石"

msgid "36:description=An assortment of colorful magnets."
msgstr "カラフルな磁石の詰め合わせ。"

msgid "37:name=metal can"
msgstr "金属缶"

msgid "37:description=Made of aluminum. Says \"COFFEE GROUNDS\"."
msgstr "アルミ製。「COFFEE GROUND」と書かれている。"

msgid "38:name=scissors"
msgstr "ハサミ"

