msgid "52:name=Library card (sticky)"
msgstr "図書館カード（ベタベタ）"

msgid "52:description=There's glitter glue all over her photo now..."
msgstr "彼女の写真がラメ入りノリでベタベタに…"

msgid "53:name=photo of Niko (sticky)"
msgstr "ニコの写真（ベタベタ）"

