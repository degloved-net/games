msgid "@niko_speak I'm....\\.\\. \\@niko_eyeclosed gonna assume that's not good."
msgstr "@niko_speak それって… \\.\\. \\@niko_eyeclosed たぶん、よくないことだよね。"

msgid "@rowbot [IT IS NOT GOOD AT ALL.]"
msgstr "@rowbot [まったく良くありませン。]"

