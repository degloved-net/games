msgid "@niko And then...\\>\\n\\@niko_speak ...I'll get to go home for real this time, too!"
msgstr "@niko あとね…\\>\\n\\@niko_speak …今度こそ家に帰れる！"

msgid "@niko I can't wait to see everyone again..."
msgstr "@niko 早くまたみんなに会いたいなあ…"

msgid "@niko_speak Are you okay, \\p?\\>\\n\\@niko You seem a little quiet..."
msgstr "@niko_speak \\p、 大丈夫？\\>\\n\\@niko あんまり喋らないね…"

msgid "[\"Niko.\", \"...\"]"
msgstr "[\"ニコ。\",\"…\"]"

