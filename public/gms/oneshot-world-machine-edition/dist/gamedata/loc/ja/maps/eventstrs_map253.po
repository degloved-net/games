msgid "[\"Yes\", \"No\"]"
msgstr "[\"はい\",\"いいえ\"]"

msgid "@niko_eyeclosed Ah, well... \\>\\n\\@niko I suppose there's more work to do."
msgstr "@niko_eyeclosed あ、そっか… \\>\\n\\@niko まだやることあるもんね。"

