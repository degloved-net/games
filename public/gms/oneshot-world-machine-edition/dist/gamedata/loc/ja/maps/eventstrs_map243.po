msgstr "@niko ううん！"

msgid "@niko_speak I'm Niko, by the way!"
msgstr "@niko_speak ミーはニコって言うんだ。"

msgid "@niko_83c It's... \\.\\.nice to meet you?"
msgstr "@niko_83c んー… \\.\\.初めまして、かな？"

