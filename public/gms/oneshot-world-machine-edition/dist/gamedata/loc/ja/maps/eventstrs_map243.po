msgid "@plight_2 Off you go, I guess...."
msgstr "@plight_2 さ、行きな…"

msgid "@plight_shock It's you!"
msgstr "@plight_shock 君か！"

msgid "@plight_sigh Glad to see you in one piece..."
msgstr "@plight_sigh 無事みたいで良かったよ…"

msgid "@niko_speak Glad to see you're ok, too!\\>\\n\\@niko5 After the whole elevator thing."
msgstr "@niko_speak お兄さんも元気みたいで良かった！！\\>\\n\\@niko5 エレベーター事件の時は、大変だったね。"

msgid "@plight_worry That was uh...\\>\\nThat was the most awkward elevator ride I've been through."
msgstr ""
"@plight_worry あれは、ああ…\\>\\nあんなに居心地の悪いエレベーターは\n"
"初めてだったよ。"

msgid "@plight_why ...and by \"awkward\" I mean terrible bad awful the absolute worst."
msgstr ""
"@plight_why …「居心地が悪い」ってのは、サイアクで、\n"
"さいあくで、最悪って意味な。"

msgid "@plight_worry The squares like, started leaking into the room, right?"
msgstr "@plight_worry 四角形が、文字通りなだれ込んできたんだ。"

msgid "@plight_worry2 And I was trapped like a rat."
msgstr ""
"@plight_worry2 それで、おれはネズミみたいに\n"
"逃げ場がなくなっちまって。"

msgid "@plight_worry And they just kept filling in the room faster, right..."
msgstr "@plight_worry やつらは、どんどん部屋の空間を埋め続けた…"

msgid "@plight_worry ..."
msgstr "@plight_worry …"

msgid "@plight_wtf ...AM I DEAD!?"
msgstr "@plight_wtf …まさか、おれは死んでるのか！？"

msgid "@plight_sigh Oh thank goodness gracious."
msgstr "@plight_sigh ああ、それは神様に感謝だ。"

msgid "@plight_worry I can't work when I'm dead!"
msgstr "@plight_worry 死んじまったら、仕事ができないからな！"

msgid "@niko6 (...\\p, IS he?)"
msgstr "@niko6 (…\\p, 彼は？)"

msgid "[\"He's fine, Niko\"]"
msgstr "[\"彼は元気だよ、ニコ。\"]"

msgid "[\"Everyone here is fine.\"]"
msgstr "[\"ここは、全員元気だよ。\"]"

