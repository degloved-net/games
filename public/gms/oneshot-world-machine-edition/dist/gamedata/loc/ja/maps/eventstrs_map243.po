msgid "@cedric_talk \\p.... Niko...."
msgstr "@cedric_talk \\p…、 ニコ…"

msgid "@cedric_smile We are forever in your debt."
msgstr "@cedric_smile この恩は、一生忘れません。"

msgid "@niko_speak I'm glad we could help!"
msgstr "@niko_speak 役に立てて良かった！"

msgid "@cedric_smile Looks like you managed to do it!"
msgstr "@cedric_smile どうにか成し遂げたみたいですね！"

msgid "@rue_smile You managed to tame the World Machine, Niko!"
msgstr ""
"@rue_smile あなたはワールドマシンを\n"
"制御化したのよ、ニコ！"

msgid "@niko2 I... feel like the World Machine has been tamed this whole time."
msgstr ""
"@niko2 たぶん…ワールドマシンは、ずっと\n"
"制御化されてたんだよ。"

msgid "@niko6 ...Just by \\p and I being here."
msgstr ""
"@niko6 …ミーと \\pが\n"
"この世界に来たときから、ずっと。"

msgid "@niko_eyeclosed We... did spend a lot of time here, after all."
msgstr "@niko_eyeclosed ずっと…長い間この世界にいたから。"

msgid "@niko2 Both of us...\\.\\. never really stopped believing in this world."
msgstr "@niko2 ずっと…\\.\\. ミーたちは、この世界を信じてたから。"

msgid "@niko_eyeclosed The World Machine just needed to realize that, I guess..."
msgstr ""
"@niko_eyeclosed ワールドマシンは、きっとそれに\n"
"気づいてないだけだったんだ…"

msgid "@rue That... \\>\\@rue_talk Sounds like a possibility..."
msgstr "@rue そう… \\>\\@rue_talk 確かに、その可能性もあるわね…"

msgid "@proto2b [...or not.]"
msgstr "@proto2b […そうではない可能性もね。]"

msgid "@niko_eyeclosed Well, just throwing that idea out there!"
msgstr "@niko_eyeclosed 言ってみただけ！"

