msgid "@silver2 ...Messiah?"
msgstr "@silver2 …救世主？"

msgid "@niko_surprised ROBOT LADY!!!!"
msgstr "@niko_surprised ロボットのお姉さん！！！"

msgid "@niko_pancakes You're.... okay?"
msgstr "@niko_pancakes 大丈夫…なの？"

msgid "@silver2 [I... think so.]"
msgstr "@silver2 [ええ…多分。]"

msgid "@silver_eyeclosed [The last thing I remember was the squares closing in on me...]"
msgstr ""
"@silver_eyeclosed [最後に覚えているのは、四角形が\n"
"接近してきたことぐらいね…]"

msgid "@silver2 [But then, I....\\.\\. ended up here unscathed.]"
msgstr ""
"@silver2 [でもその後…\\.\\.気づいたら、ここにいたの。\n"
"かすり傷一つなく。]"

msgid "@niko3 Is that so..."
msgstr "@niko3 そうだったんだ…"

msgid "@silver_lookup [...This is such a strange room.]"
msgstr "@silver_lookup […ここ、変な部屋ね。]"

msgid "@silver2 [We can't be...\\.\\. in the Tower, can we?]"
msgstr "@silver2 [まさか…\\.\\. 塔の中ではないわよね？]"

msgid "@niko6 I'm actually not sure myself..."
msgstr "@niko6 実は、ミーもよく分からないんだ…"

msgid "@silver2 [...where did YOU come from, anyway?]"
msgstr "@silver2 […ところで、あなたはどこから来たの？]"

msgid "@niko2 The room where the World Machine was..."
msgstr "@niko2 ワールドマシンがあった部屋…"

msgid "@silver2 [...pardon?]"
msgstr "@silver2 […え？]"

msgid "@niko5 I... think the World Machine is trying to remember, now..."
msgstr ""
"@niko5 きっと…ワールドマシンは今、\n"
"思い出そうとしてるんだ…"

msgid "@niko4 The code that went bad...\\.\\.\\>\\n\\@niko2 I think it's restoring it all."
msgstr "@niko4 おかしくなっちゃったコードを…\\.\\.\\>\\n\\@niko2 全部、復元しようとしてるんだよ。"

msgid "@niko6 That must've been why the squares were going away, \\p..."
msgstr ""
"@niko6 四角形が消えたのって、きっとそういうこと\n"
"だったんだよ、 \\p…"

msgid "@niko2 And... it's why you're here, miss!"
msgstr "@niko2 だから…お姉さんがここにいるんだね！"

msgid "@niko_speak I think the World Machine was able to recover your code, too...!"
msgstr ""
"@niko_speak たぶんワールドマシンは、お姉さんの\n"
"コードも復元できたんだよ…！"

msgid "@silver2 [World... Machine, huh...]"
msgstr "@silver2 [ワールド…マシン、そう…]"

msgid "@niko2 Oh... I'm not sure if I should tell you this, but..."
msgstr ""
"@niko2 あっ…このこと話していいのか\n"
"分からないけど、あのね…"

msgid "@silver2 [...What's that in the distance?]"
msgstr "@silver2 […遠くに見えるあれは何かしら？]"

msgid "@silver [It... looks like a few more people are showing up.]"
msgstr "@silver [まだ…何人かやってくるみたいね。]"

msgid "@niko_pancakes Oh!!!"
msgstr "@niko_pancakes あっ！！"

msgid "@silver2 [Are they... people you know?]"
msgstr "@silver2 [あの人たち…知っているの？]"

msgid "@niko It's... \\.\\.a bit too far to tell."
msgstr "@niko うーん…\\.\\.すごく遠くて、まだ分かんないや。"

msgid "@niko_speak Come on, \\p, let's go take a closer look!"
msgstr ""
"@niko_speak ねえ、 \\p、\n"
"近くに行ってみようよ！"

msgid "@rowbot [THE HEAD ENGINEER CAN HELP ME DO NOT WORRY.]"
msgstr ""
"@rowbot [主任技術者ガ助けてくれるので、\n"
"心配ありませン。]"

msgid "@niko Alright..."
msgstr "@niko 分かった…"

msgid "@rowbot [HELLO.]"
msgstr "@rowbot [どうモ。]"

msgid "@niko Hi!"
msgstr "@niko こんばんは！"

msgid "@rowbot [I...\\.\\. CANNOT MOVE.]"
msgstr "@rowbot [動くことガ…\\.\\. できませン。]"

msgid "@niko2 Oh, yeah..."
msgstr "@niko2 あっ、そっか…"

msgid "@niko_eyeclosed I guess there's no water here..."
msgstr "@niko_eyeclosed ここには水がないから…"

msgid "@rowbot [IT'S FINE.]"
msgstr "@rowbot [大丈夫でス。]"

msgid "@rowbot [THE HEAD ENGINEER CAN HELP ME LATER.]"
msgstr "@rowbot [主任技術者ガ、後で何とかしてくれまス。]"

msgid "@green_gatekeeper [Off you go, messiah...]"
msgstr "@green_gatekeeper [サア行ケ。救世主…]"

msgid "@red_gatekeeper [Off you go, messiah...]"
msgstr "@red_gatekeeper [サア行ケ。救世主…]"

msgid "@alula_pout I guess... you're leaving us now?"
msgstr "@alula_pout もう…行っちゃうんだよね？"

msgid "@calamus_smile We're glad we met you, Niko!"
msgstr "@calamus_smile ニコに会えて良かったよ！"

msgid "@niko_speak Same!"
msgstr "@niko_speak ミーも！"

msgid "@alula_gasp Niko!!"
msgstr "@alula_gasp ニコー！！"

msgid "@alula_gasp You're okay too!"
msgstr "@alula_gasp 無事だったのね！"

msgid "@niko2 Did you guys just get here?"
msgstr "@niko2 2人とも、今来たの？"

msgid "@calamus I... think so?"
msgstr "@calamus んー…たぶん？"

msgid "@calamus_sad The squares started multiplying around the island after you guys left..."
msgstr ""
"@calamus_sad ニコたちが出発した後に、\n"
"島の周辺で四角形が増殖しだしてな…"

msgid "@alula_oh It was so freaky!"
msgstr "@alula_oh とっても怖かったー！"

msgid "@alula_oh I fell right into a bunch of em!"
msgstr "@alula_oh あたし、四角形に囲まれちゃったの！"

msgid "@alula_oh Calamus tried to save me, and then..."
msgstr "@alula_oh カラムスが助けようとして、それで…"

msgid "@calamus We... both ended up in this room."
msgstr "@calamus 気づいたら…この部屋にいたんだ。"

msgid "@calamus_heh Biggest scare of my life, for sure..."
msgstr "@calamus_heh いやほんと、人生で一番ビビったよ…"

msgid "@niko2 Ooh..."
msgstr "@niko2 へええ…"

msgid "@calamus Say, what is this place?"
msgstr "@calamus それで、ここはどこなんだ？"

msgid "@alula_gasp Are we in limboooooo?"
msgstr "@alula_gasp あっ！もしかして地獄ーーー？"

msgid "@calamus_heh Alula! \\>We're not dead!"
msgstr "@calamus_heh アルーラ！ \\>オレたち死んでないから！"

msgid "@calamus_shame ...wait, \\.\\.are we?"
msgstr "@calamus_shame …あれ、\\.\\. もしかして死んでる？"

msgid "@niko_speak No no, you're fine!"
msgstr "@niko_speak ううん、大丈夫だよ！"

msgid "@niko Everyone in this room is fine!"
msgstr "@niko この部屋にいる人は、みんな元気！"

msgid "@niko_speak You'll be able to go back home soon..."
msgstr "@niko_speak もうすぐ家に帰れるよ…"

msgid "@alula_gasp That's even better than limbo!"
msgstr "@alula_gasp 地獄よりずっとマシね！"

msgid "@niko_what Good...\\.\\. \\>\\@niko_what2 question."
msgstr "@niko_what それは…\\.\\. \\>\\@niko_what2 いい質問だね。"

msgid "@niko6 (hey \\p are they gonna be okay?)"
msgstr ""
"@niko6 (ねえ、 \\p…\n"
"この2人、大丈夫なのかな？)"

msgid "[\"They're fine, Niko.\"]"
msgstr "[\"平気だ、ニコ。\"]"

msgid "[\"Everyone is fine.\"]"
msgstr "[\"みんな無事だ。\"]"

msgid "[\"The World Machine...\"]"
msgstr "[\"ワールドマシンが…\"]"

msgid "[\"...will send them home soon.\"]"
msgstr "[\"…きっと、2人をもうすぐ家に送ってくれる。\"]"

msgid "@niko_speak Oh!"
msgstr "@niko_speak あっ！"

msgid "@niko_speak Well, \\p says you're not dead!"
msgstr "@niko_speak \\pは、 死んでないってさ！"

msgid "@calamus_sad Phew."
msgstr "@calamus_sad ふぅ。"

msgid "@niko They also said you'll be able to go back to your home very soon!"
msgstr "@niko もうすぐ家に帰れるって言ってたよ！"

