msgid "@niko It's the lightbulb.\\>\\n\\@niko_eyeclosed2 Thank goodness it's safe..."
msgstr "@niko 전구다.\\>\\n\\@niko_eyeclosed2 멀쩡해서 천만다행이야..."

msgid "@niko_distressed2 ...\\>\\n\\@niko_sad ..."
msgstr "@niko_distressed2 ...\\>\\n\\@niko_sad ..."

msgid "@niko_distressed2 ...I guess \\p isn't coming back..."
msgstr "@niko_distressed2 ...\\p 님은 돌아오지 않을 건가 봐..."

msgid "[\"Niko, I'm here.\"]"
msgstr "[\"니코, 난 여기 있어.\"]"

msgid "@niko_pancakes ...\\p?"
msgstr "@niko_pancakes ...\\p 님?"

msgid "[\"Yes?\"]"
msgstr "[\"응.\"]"

msgid "@niko_pancakes Is that... really you?"
msgstr "@niko_pancakes 정말로... 당신인가요?"

msgid "@niko_distressed2 I thought... you were gone..."
msgstr "@niko_distressed2 전... 아주 가 버리신 줄 알았어요..."

msgid "[\"I never left you.\", \"I'm back now.\"]"
msgstr "[\"난 널 두고 간 적이 없어.\",\"이제 돌아왔어.\"]"

msgid "@niko_speak Oh! \\@niko_eyeclosed I was... feeling a bit scared back there..."
msgstr "@niko_speak 앗! \\@niko_eyeclosed 방금까지... 좀 무서웠거든요..."

msgid "@niko_speak I thought I was completely alone!"
msgstr "@niko_speak 완전히 혼자가 된 줄 알았어요!"

msgid "@niko_eyeclosed But that was silly of me to assume, wasn't it?"
msgstr "@niko_eyeclosed 혼자만의 착각이었네요, 그렇죠?"

msgid "@niko_speak Where did you go?"
msgstr "@niko_speak 어디 갔었던 거예요?"

msgid "@niko_eyeclosed I was so scared all by myself..."
msgstr "@niko_eyeclosed 혼자서 얼마나 무서웠다고요..."

msgid "@niko_speak ...but I guess... it's okay now."
msgstr "@niko_speak ...하지만... 지금은 괜찮아진 것 같아요."

msgid "@niko Ah, guess we need to figure out where to go now, and-"
msgstr "@niko 아, 이제 어디로 갈지 찾아봐야겠네요, 그리고..."

msgid "@niko The sun!\\>\\n\\@niko_speak It lit up on its own!"
msgstr "@niko 태양이에요!\\>\\n\\@niko_speak 스스로 빛나기 시작했어요!"

msgid "@niko Guess I should pick it up, right \\p?"
msgstr "@niko 역시 제가 들고 가야겠죠? 그렇죠, \\p 님?"

