msgstr "@niko 아..."

msgid "@niko_speak What else did you... uh, foresee?"
msgstr "@niko_speak 당신은 그 외에 또 무엇을... 그러니까, 예견했나요?"

msgid "@prophet [What Do You Mean?]"
msgstr "@prophet [무슨 말씀이신지요?]"

msgid "@niko_speak What else did you see in the prophecy?"
msgstr "@niko_speak 그 예언에서 또 무엇을 보았나요?"

msgid "@prophet [???]"
msgstr "@prophet [???]"

msgid "@niko_speak Wait...\\.\\. You ARE the prophet, right?"
msgstr "@niko_speak 잠깐...\\.\\. 당신이 예언자 아닌가요?"

msgid "@prophet [Good Heavens, No!]"
msgstr "@prophet [오, 세상에. 당연히 아니지요!]"

msgid "@niko_speak But you called it \"my prophecy\" earlier..."
msgstr "@niko_speak 하지만, 아까까지만 해도 \"제 예언\"이라고..."

msgid "@prophet [That Just Means It Is Built Into My Programming.]"
msgstr "@prophet [그건 예언이 제 프로그램에 입력되어 있다는 뜻일 뿐입니다.]"

msgid "@niko ...Your... \\.\\.\\@niko_speak what?"
msgstr "@niko ...당신의... \\.\\.\\@niko_speak 뭐요?"

msgid "@prophet [Ah. My Programming Is What Guides Me.]"
msgstr "@prophet [아, 전 제 프로그램에 따라 움직일 뿐입니다.]"

msgid "@prophet_hmm [I Am A Robot, After All.]"
msgstr "@prophet_hmm [전 로봇이니까요.]"

msgid "@niko_speak How tall is the Tower?"
msgstr "@niko_speak 저 탑은 얼마나 높죠?"

msgid "@niko I can't seem to even see the top..."
msgstr "@niko 꼭대기가 보이지도 않네요..."

msgid "@prophet [I Am Not Allowed To Answer.]"
msgstr "@prophet [그 질문에는 답해드릴 수 없습니다.]"

msgid "@niko But... how do I get up there?"
msgstr "@niko 그렇지만... 저길 어떻게 올라가죠?"

msgid "@prophet [In Time, \\p Will Know What To Do.]"
msgstr "@prophet [때가 되면 \\p 님께서 어떻게 할지 알려주실 겁니다.]"

msgid "@niko_eyeclosed I... see."
msgstr "@niko_eyeclosed 알... 았어요."

msgid "@niko It's alright, thank you."
msgstr "@niko 괜찮아요. 고마워요."

msgid "@prophet [In That Case, I Wish You Safe Travels.]"
msgstr "@prophet [그렇다면 당신의 여행이 안전하기를 기원합니다.]"

msgid "@ed [What's left of a robot.]"
msgstr "@ed [로봇의 잔해다.]"

msgid "@niko A robot."
msgstr "@niko 로봇이에요."

msgid "@niko_eyeclosed It's beyond repair."
msgstr "@niko_eyeclosed 수리하긴 힘들겠어요."

