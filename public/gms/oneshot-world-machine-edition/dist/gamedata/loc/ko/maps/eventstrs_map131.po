msgstr "@en2 [거기가 네가 떠날 수 있는 곳이거든.]"

msgid "@niko3 ...and why is it that you can't do it now?"
msgstr "@niko3 ...그런데 왜 지금은 그렇게 할 수 없는 거죠?"

msgid "@en_upset2 [Niko....]"
msgstr "@en_upset2 [니코....]"

msgid "@en_upset_meow [The code's gone, remember?]"
msgstr "@en_upset_meow [코드가 사라졌잖아. 기억나?]"

