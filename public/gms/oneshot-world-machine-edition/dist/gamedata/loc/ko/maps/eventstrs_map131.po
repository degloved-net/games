msgstr "@en_distressed [원래 코드를 설명할 만큼 자세히 기억이 나지도 않아!]"

msgid "@en_distressed2 [But at the same time, it...]"
msgstr "@en_distressed2 [하지만 한편으로는...]"

msgid "@en_less_sad [Oh...\\.\\. I don't know...]"
