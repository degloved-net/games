msgstr "@niko_eyeclosed2 \"생명체에게 해를 끼치지 않는다.\""

msgid "@en3 [...You knew.]"
msgstr "@en3 [...알고 있구나.]"

msgid "@en_distressed_talk [My very existence conflicts with that law...]"
msgstr "@en_distressed_talk [내 존재 자체가 그 규칙과 충돌하고 있어...]"

msgid "@en_distressed2 [...I\\.\\. ...thought...]"
msgstr "@en_distressed2 [...난\\.\\....생각했지...]"

msgid "@en3 [The life of a living being like you is so unique.]\\>\\n[So precious.]"
msgstr "@en3 [너 같은 생명체의 목숨은 아주 특별하다고.]\\>\\n[아주 소중하다고.]"

