msgid "[\"Yes\", \"No\"]"
msgstr "[\"응\",\"아니\"]"

msgid "@niko_eyeclosed Ah, well... \\>\\n\\@niko I suppose there's more work to do."
msgstr "@niko_eyeclosed 아, 알겠어요... \\>\\n\\@niko 해야 할 일이 더 있는 모양이네요."

msgid "@niko It's a stack of blank papers."
msgstr "@niko 그냥 하얀 종이 뭉치예요."

msgid "@niko Boxes full of manuscripts."
msgstr "@niko 원고가 가득 든 상자네요."

msgid "@niko A book on the ground."
msgstr "@niko 책이 떨어져 있어요."

