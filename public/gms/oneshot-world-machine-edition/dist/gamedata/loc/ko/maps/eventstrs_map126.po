msgid "@niko The pathway is blocked...."
msgstr "@niko 통로가 막혔어요..."

msgid "@niko_speak ...by blocks!"
msgstr "@niko_speak ...사각형으로요!"

msgid "@alula_speak Haha!"
msgstr "@alula_speak 하하!"

msgid "@niko Oh, shoot!"
msgstr "@niko 아, 이런!"

msgid "@niko_eyeclosed Looks like we can't get past that block..."
msgstr "@niko_eyeclosed 아무래도 이 곳은 지나갈 수 없겠네..."

msgid "@alula_pout ..."
msgstr "@alula_pout ..."

