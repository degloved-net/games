msgstr "@calamus_smile 자, 집까지 이제 얼마 안 남았어."

msgid "@calamus Oh, Niko, did you come by for a visit?\\>\\n\\@calamus_smile Our house is up here, please follow me."
msgstr "@calamus 오, 니코, 우릴 찾아온 거야?\\>\\n\\@calamus_smile 우리 집은 이 근처야. 따라 와."

